<mah:MetroWindow x:Class="LlrpReaderPlatform.App.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
        xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp"
        xmlns:vm="clr-namespace:LlrpReaderPlatform.App.Wpf.ViewModels"
        xmlns:views="clr-namespace:LlrpReaderPlatform.App.Wpf.Views"
        Title="LLRP Reader Studio"
        Height="780" Width="1240" MinHeight="650" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        GlowBrush="{DynamicResource MahApps.Brushes.Accent}">

    <mah:MetroWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style x:Key="FlatCircleButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.Accent}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Accent}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource MahApps.Brushes.Accent}" />
                                <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.IdealForeground}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FlatMiniButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.Accent}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Accent}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="13">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource MahApps.Brushes.Accent}" />
                                <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.IdealForeground}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavigationButtonStyle" TargetType="Button"
               BasedOn="{StaticResource FlatActionButtonStyle}">
            <Setter Property="Margin" Value="12,2" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <DataTemplate DataType="{x:Type vm:InventoryViewModel}">
            <views:InventoryView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TagMemoryViewModel}">
            <views:TagMemoryView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TagListsViewModel}">
            <views:TagListsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:InventoryRunsViewModel}">
            <views:InventoryRunsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ReaderSettingsViewModel}">
            <views:ReaderSettingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AddDataSourceViewModel}">
            <views:AddDataSourceView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AppSettingsViewModel}">
            <views:AppSettingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AboutViewModel}">
            <views:AboutView />
        </DataTemplate>
    </mah:MetroWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="30" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0" Grid.Column="0"
                BorderBrush="{DynamicResource MahApps.Brushes.Accent}"
                BorderThickness="0,0,1,0">
            <Grid>
                <DockPanel Margin="0,16,0,12">
                <StackPanel DockPanel.Dock="Bottom" Margin="16,8,16,4">
                    <TextBlock Text="{Binding Status}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6" />
                    <Button Command="{Binding NavigateCommand}" CommandParameter="AppSettings"
                            Style="{StaticResource NavigationButtonStyle}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <fa:IconBlock Icon="Gear" IconFont="Solid" Width="20" FontSize="16"
                                          Foreground="{DynamicResource MahApps.Brushes.Accent}"
                                          Margin="0,0,10,0" VerticalAlignment="Center" />
                            <TextBlock Text="Software Settings" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding NavigateCommand}" CommandParameter="About"
                            Style="{StaticResource NavigationButtonStyle}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <fa:IconBlock Icon="InfoCircle" IconFont="Solid" Width="20" FontSize="16"
                                          Foreground="{DynamicResource MahApps.Brushes.Accent}"
                                          Margin="0,0,10,0" VerticalAlignment="Center" />
                            <TextBlock Text="About Studio" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel>
                    <Border Padding="16,14" Margin="12,0,12,20"
                            BorderBrush="{DynamicResource MahApps.Brushes.Accent}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="LLRP" FontSize="24" FontWeight="Bold"
                                       Foreground="{DynamicResource MahApps.Brushes.Accent}" />
                            <TextBlock Text="READER STUDIO" FontSize="11" FontWeight="Bold" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="SHOWCASES" FontSize="11" FontWeight="Bold" Margin="16,0,0,8" />
                    <Button Command="{Binding NavigateCommand}" CommandParameter="Inventory"
                            Style="{StaticResource NavigationButtonStyle}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <fa:IconBlock Icon="SatelliteDish" IconFont="Solid" Width="20" FontSize="16"
                                          Foreground="{DynamicResource MahApps.Brushes.Accent}"
                                          Margin="0,0,10,0" VerticalAlignment="Center" />
                            <TextBlock Text="寻卡 / Inventory" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding NavigateCommand}" CommandParameter="TagMemory"
                            Style="{StaticResource NavigationButtonStyle}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <fa:IconBlock Icon="Microchip" IconFont="Solid" Width="20" FontSize="16"
                                          Foreground="{DynamicResource MahApps.Brushes.Accent}"
                                          Margin="0,0,10,0" VerticalAlignment="Center" />
                            <TextBlock Text="Tag Memory" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding NavigateCommand}" CommandParameter="TagLists"
                            Style="{StaticResource NavigationButtonStyle}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <fa:IconBlock Icon="Tags" IconFont="Solid" Width="20" FontSize="16"
                                          Foreground="{DynamicResource MahApps.Brushes.Accent}"
                                          Margin="0,0,10,0" VerticalAlignment="Center" />
                            <TextBlock Text="Tag Lists" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding NavigateCommand}" CommandParameter="InventoryRuns"
                            Style="{StaticResource NavigationButtonStyle}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <fa:IconBlock Icon="History" IconFont="Solid" Width="20" FontSize="16"
                                          Foreground="{DynamicResource MahApps.Brushes.Accent}"
                                          Margin="0,0,10,0" VerticalAlignment="Center" />
                            <TextBlock Text="Inventory Runs" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <DockPanel Margin="16,24,16,8">
                        <Button Command="{Binding NavigateCommand}" CommandParameter="AddDataSource"
                                DockPanel.Dock="Right" FontWeight="Bold" ToolTip="Add Data Source"
                                Style="{StaticResource FlatCircleButtonStyle}">
                            <TextBlock Text="+" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />
                        </Button>
                        <TextBlock Text="DATA SOURCES" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
                    </DockPanel>

                    <Grid Margin="12,0">
                        <ListBox ItemsSource="{Binding Readers}" SelectedItem="{Binding SelectedReader}"
                                 BorderThickness="0" MaxHeight="220"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="ItemBorder" Background="Transparent"
                                                        BorderBrush="Transparent" BorderThickness="1"
                                                        CornerRadius="2" Margin="0,1">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ItemBorder" Property="BorderBrush"
                                                                Value="{DynamicResource MahApps.Brushes.Accent}" />
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="ItemBorder" Property="BorderBrush"
                                                                Value="{DynamicResource MahApps.Brushes.Accent}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ReaderItemViewModel}">
                                    <Border Padding="4,3" MinHeight="38">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="58" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                            <mah:ToggleSwitch Grid.Column="0" IsOn="{Binding IsEnabled, Mode=TwoWay}"
                                                              OnContent="" OffContent=""
                                                              ToolTip="Enable/Disable reader"
                                                              VerticalAlignment="Center" HorizontalAlignment="Left"
                                                              Margin="0,0,8,0" />
                                            <Button Grid.Column="1"
                                                    Command="{Binding DataContext.OpenReaderSettingsCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                    CommandParameter="{Binding}" Background="Transparent"
                                                    BorderThickness="0" HorizontalContentAlignment="Stretch"
                                                    Padding="0" Margin="0,0,6,0" MinHeight="28">
                                                <Grid VerticalAlignment="Center">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <TextBlock Grid.Row="0" Text="{Binding Name}" FontSize="12"
                                                               FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Row="1" Text="{Binding Endpoint}" FontSize="10"
                                                               Opacity="0.72" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Row="2" Text="{Binding StatusText}" FontSize="10"
                                                               Foreground="{DynamicResource MahApps.Brushes.Accent}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Row="3" Text="{Binding Details}" FontSize="9"
                                                               Opacity="0.62" TextTrimming="CharacterEllipsis" />
                                                </Grid>
                                            </Button>
                                            <Button Grid.Column="2"
                                                    Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                    CommandParameter="{Binding ReaderId}" ToolTip="Remove data source"
                                                    VerticalAlignment="Center" Style="{StaticResource FlatMiniButtonStyle}">
                                                <TextBlock Text="×" FontSize="14" FontWeight="Bold"
                                                           VerticalAlignment="Center" HorizontalAlignment="Center" />
                                            </Button>
                                            <Button Grid.Column="3"
                                                    Command="{Binding DataContext.ActivateCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                    CommandParameter="{Binding}" ToolTip="Reconnect and refresh capabilities"
                                                    VerticalAlignment="Center" Style="{StaticResource FlatMiniButtonStyle}"
                                                    Margin="2,0,0,0">
                                                <TextBlock Text="↻" FontSize="14" FontWeight="Bold"
                                                           VerticalAlignment="Center" HorizontalAlignment="Center" />
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </StackPanel>
                </DockPanel>

                <Grid Visibility="{Binding IsSidebarBusy, Converter={StaticResource BooleanToVisibilityConverter}}"
                      Panel.ZIndex="10">
                    <Border Background="{DynamicResource MahApps.Brushes.ThemeBackground}" Opacity="0.92" />
                    <StackPanel Width="210" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <mah:ProgressRing Width="52" Height="52" IsLarge="True" IsActive="True"
                                          Foreground="{DynamicResource MahApps.Brushes.Accent}"
                                          HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding BusyMessage}" FontSize="13" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" TextAlignment="Center"
                                   TextWrapping="Wrap" Margin="0,14,0,0" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="0" Grid.Column="1">
            <ContentControl Content="{Binding CurrentPage}" />

            <Grid Visibility="{Binding IsContentBusy, Converter={StaticResource BooleanToVisibilityConverter}}"
                  Panel.ZIndex="10">
                <Border Background="{DynamicResource MahApps.Brushes.ThemeBackground}" Opacity="0.92" />
                <StackPanel Width="280" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <mah:ProgressRing Width="56" Height="56" IsLarge="True" IsActive="True"
                                      Foreground="{DynamicResource MahApps.Brushes.Accent}"
                                      HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding ContentBusyMessage}" FontSize="15" FontWeight="SemiBold"
                               HorizontalAlignment="Center" TextAlignment="Center"
                               TextWrapping="Wrap" Margin="0,14,0,0" />
                </StackPanel>
            </Grid>
        </Grid>

        <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                BorderBrush="{DynamicResource MahApps.Brushes.Accent}" BorderThickness="0,1,0,0"
                Padding="20,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Inventory.DurationModeText}"
                               FontSize="12" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Inventory.Status}"
                               FontSize="12"
                               Foreground="{DynamicResource MahApps.Brushes.Gray3}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"
                               Margin="18,0,12,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Unique Tags: " FontSize="12" />
                    <TextBlock Text="{Binding Inventory.UniqueTagCount}" FontSize="12" FontWeight="Bold" />
                    <TextBlock Text="  |  Read Rate: " FontSize="12" Margin="16,0,0,0" />
                    <TextBlock Text="{Binding Inventory.TagRate}" FontSize="12" FontWeight="Bold" />
                    <TextBlock Text="  |  Dropped: " FontSize="12" Margin="16,0,0,0" />
                    <TextBlock Text="{Binding Inventory.DroppedTagReportCount}" FontSize="12" FontWeight="Bold" />
                    <TextBlock Text="  |  Selected: " FontSize="12" Margin="16,0,0,0" />
                    <TextBlock Text="{Binding SelectedReader.Name}" FontSize="12" FontWeight="Bold" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</mah:MetroWindow>
