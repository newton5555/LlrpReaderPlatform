<mah:MetroWindow
    x:Class="LlrpReaderPlatform.App.Wpf.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp"
    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
    xmlns:views="clr-namespace:LlrpReaderPlatform.App.Wpf.Views"
    xmlns:vm="clr-namespace:LlrpReaderPlatform.App.Wpf.ViewModels"
    Title="LLRP Reader Studio"
    Icon="Assets/LlrpReader_Pro_Icon_Light.png"
    Width="1240"
    Height="780"
    MinWidth="1000"
    MinHeight="650"
    GlowBrush="{DynamicResource MahApps.Brushes.Accent}"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <mah:MetroWindow.IconTemplate>
        <DataTemplate>
            <Image
                RenderOptions.BitmapScalingMode="HighQuality"
                Width="20"
                Height="20"
                Stretch="Uniform"
                Source="Assets/LlrpReader_Pro_Icon_Light.png" />
        </DataTemplate>
    </mah:MetroWindow.IconTemplate>

    <mah:MetroWindow.Resources>
        <Style
            x:Key="NavigationButtonStyle"
            BasedOn="{StaticResource FlatActionButtonStyle}"
            TargetType="Button">
            <Setter Property="Margin" Value="12,2" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <DataTemplate DataType="{x:Type vm:InventoryViewModel}">
            <views:InventoryView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TagMemoryViewModel}">
            <views:TagMemoryView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TagListsViewModel}">
            <views:TagListsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:InventoryRunsViewModel}">
            <views:InventoryRunsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ReaderSettingsViewModel}">
            <views:ReaderSettingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AddDataSourceViewModel}">
            <views:AddDataSourceView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AppSettingsViewModel}">
            <views:AppSettingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AboutViewModel}">
            <views:AboutView />
        </DataTemplate>
    </mah:MetroWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="30" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border
            Grid.Row="0"
            Grid.Column="0"
            BorderBrush="{DynamicResource MahApps.Brushes.Accent}"
            BorderThickness="0,0,1,0">
            <Grid>
                <DockPanel Margin="0,16,0,12">
                    <StackPanel Margin="16,8,16,4" DockPanel.Dock="Bottom">
                        <TextBlock
                            Margin="0,0,0,6"
                            FontSize="11"
                            Text="{Binding Status}"
                            TextWrapping="Wrap" />
                        <Button
                            Command="{Binding NavigateCommand}"
                            CommandParameter="AppSettings"
                            Style="{StaticResource NavigationButtonStyle}">
                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                <fa:IconBlock
                                    Width="20"
                                    Margin="0,0,10,0"
                                    VerticalAlignment="Center"
                                    FontSize="16"
                                    Foreground="{DynamicResource MahApps.Brushes.Accent}"
                                    Icon="Gear"
                                    IconFont="Solid" />
                                <TextBlock VerticalAlignment="Center" Text="Software Settings" />
                            </StackPanel>
                        </Button>
                        <Button
                            Command="{Binding NavigateCommand}"
                            CommandParameter="About"
                            Style="{StaticResource NavigationButtonStyle}">
                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                <fa:IconBlock
                                    Width="20"
                                    Margin="0,0,10,0"
                                    VerticalAlignment="Center"
                                    FontSize="16"
                                    Foreground="{DynamicResource MahApps.Brushes.Accent}"
                                    Icon="InfoCircle"
                                    IconFont="Solid" />
                                <TextBlock VerticalAlignment="Center" Text="About Studio" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <StackPanel>
                        <Border
                            Margin="12,0,12,20"
                            Padding="16,14"
                            BorderBrush="{DynamicResource MahApps.Brushes.Accent}"
                            BorderThickness="4,0,0,0">
                            <StackPanel>
                                <TextBlock
                                    FontSize="24"
                                    FontWeight="Bold"
                                    Foreground="{DynamicResource MahApps.Brushes.Accent}"
                                    Text="LLRP" />
                                <TextBlock
                                    Margin="0,2,0,0"
                                    FontSize="11"
                                    FontWeight="Bold"
                                    Text="READER STUDIO" />
                            </StackPanel>
                        </Border>

                        <TextBlock
                            Margin="16,0,0,8"
                            FontSize="11"
                            FontWeight="Bold"
                            Text="SHOWCASES" />
                        <Button
                            Command="{Binding NavigateCommand}"
                            CommandParameter="Inventory"
                            Style="{StaticResource NavigationButtonStyle}">
                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                <fa:IconBlock
                                    Width="20"
                                    Margin="0,0,10,0"
                                    VerticalAlignment="Center"
                                    FontSize="16"
                                    Foreground="{DynamicResource MahApps.Brushes.Accent}"
                                    Icon="SatelliteDish"
                                    IconFont="Solid" />
                                <TextBlock VerticalAlignment="Center" Text="寻卡 / Inventory" />
                            </StackPanel>
                        </Button>
                        <Button
                            Command="{Binding NavigateCommand}"
                            CommandParameter="TagMemory"
                            Style="{StaticResource NavigationButtonStyle}">
                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                <fa:IconBlock
                                    Width="20"
                                    Margin="0,0,10,0"
                                    VerticalAlignment="Center"
                                    FontSize="16"
                                    Foreground="{DynamicResource MahApps.Brushes.Accent}"
                                    Icon="Microchip"
                                    IconFont="Solid" />
                                <TextBlock VerticalAlignment="Center" Text="Tag Memory" />
                            </StackPanel>
                        </Button>
                        <Button
                            Command="{Binding NavigateCommand}"
                            CommandParameter="TagLists"
                            Style="{StaticResource NavigationButtonStyle}">
                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                <fa:IconBlock
                                    Width="20"
                                    Margin="0,0,10,0"
                                    VerticalAlignment="Center"
                                    FontSize="16"
                                    Foreground="{DynamicResource MahApps.Brushes.Accent}"
                                    Icon="Tags"
                                    IconFont="Solid" />
                                <TextBlock VerticalAlignment="Center" Text="TOI" />
                            </StackPanel>
                        </Button>
                        <Button
                            Command="{Binding NavigateCommand}"
                            CommandParameter="InventoryRuns"
                            Style="{StaticResource NavigationButtonStyle}">
                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                <fa:IconBlock
                                    Width="20"
                                    Margin="0,0,10,0"
                                    VerticalAlignment="Center"
                                    FontSize="16"
                                    Foreground="{DynamicResource MahApps.Brushes.Accent}"
                                    Icon="History"
                                    IconFont="Solid" />
                                <TextBlock VerticalAlignment="Center" Text="Inventory Runs" />
                            </StackPanel>
                        </Button>

                        <DockPanel Margin="16,24,16,8">
                            <Button
                                Command="{Binding NavigateCommand}"
                                CommandParameter="AddDataSource"
                                DockPanel.Dock="Right"
                                FontWeight="Bold"
                                Style="{StaticResource FlatCircleButtonStyle}"
                                ToolTip="Add Data Source">
                                <fa:IconBlock Icon="Plus" IconFont="Solid" FontSize="14" />
                            </Button>
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="11"
                                FontWeight="Bold"
                                Text="DATA SOURCES" />
                        </DockPanel>

                        <Grid Margin="12,0">
                            <ListBox
                                MaxHeight="220"
                                BorderThickness="0"
                                ItemsSource="{Binding Readers}"
                                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                SelectedItem="{Binding SelectedReader}">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border
                                                        x:Name="ItemBorder"
                                                        Margin="0,3"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        CornerRadius="4">
                                                        <ContentPresenter />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource MahApps.Brushes.Gray8}" />
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource MahApps.Brushes.Gray7}" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:ReaderItemViewModel}">
                                        <Border MinHeight="38"
                                                Padding="4,3,4,6"
                                                BorderBrush="{DynamicResource MahApps.Brushes.Gray8}"
                                                BorderThickness="0,0,0,1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="58" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <mah:ToggleSwitch
                                                    Grid.Column="0"
                                                    Margin="0,0,8,0"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center"
                                                    IsOn="{Binding IsEnabled, Mode=TwoWay}"
                                                    OffContent=""
                                                    OnContent=""
                                                    ToolTip="Enable/Disable reader" />
                                                <Button
                                                    Grid.Column="1"
                                                    MinHeight="28"
                                                    Margin="0,0,6,0"
                                                    Padding="0"
                                                    HorizontalContentAlignment="Stretch"
                                                    Background="Transparent"
                                                    BorderBrush="Transparent"
                                                    BorderThickness="0"
                                                    FocusVisualStyle="{x:Null}"
                                                    Command="{Binding DataContext.OpenReaderSettingsCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                    CommandParameter="{Binding}">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <ContentPresenter
                                                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                                Content="{TemplateBinding Content}"
                                                                ContentTemplate="{TemplateBinding ContentTemplate}" />
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                    <Grid VerticalAlignment="Center">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>
                                                        <TextBlock
                                                            Grid.Row="0"
                                                            FontSize="12"
                                                            FontWeight="SemiBold"
                                                            Text="{Binding Name}"
                                                            TextTrimming="CharacterEllipsis" />
                                                        <TextBlock
                                                            Grid.Row="1"
                                                            FontSize="10"
                                                            Opacity="0.72"
                                                            Text="{Binding Endpoint}"
                                                            TextTrimming="CharacterEllipsis" />
                                                        <TextBlock
                                                            Grid.Row="2"
                                                            FontSize="10"
                                                            Foreground="{DynamicResource MahApps.Brushes.Accent}"
                                                            Text="{Binding StatusText}"
                                                            TextTrimming="CharacterEllipsis" />
                                                        <TextBlock
                                                            Grid.Row="3"
                                                            FontSize="9"
                                                            Opacity="0.62"
                                                            Text="{Binding Details}"
                                                            TextTrimming="CharacterEllipsis" />
                                                    </Grid>
                                                </Button>
                                                <Button
                                                    Grid.Column="2"
                                                    VerticalAlignment="Center"
                                                    Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                    CommandParameter="{Binding ReaderId}"
                                                    Style="{StaticResource DangerCircleButtonStyle}"
                                                    ToolTip="Remove data source">
                                                    <fa:IconBlock Icon="Trash" IconFont="Solid" FontSize="13" />
                                                </Button>
                                                <Button
                                                    Grid.Column="3"
                                                    Margin="2,0,0,0"
                                                    VerticalAlignment="Center"
                                                    Command="{Binding DataContext.ActivateCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource FlatCircleButtonStyle}"
                                                    ToolTip="Reconnect and refresh capabilities">
                                                    <fa:IconBlock Icon="ArrowsRotate" IconFont="Solid" FontSize="13" />
                                                </Button>

                                                <Border
                                                    Grid.ColumnSpan="4"
                                                    Panel.ZIndex="5"
                                                    Background="{DynamicResource MahApps.Brushes.ThemeBackground}"
                                                    CornerRadius="2"
                                                    Opacity="0.94"
                                                    Visibility="{Binding IsOperationBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <StackPanel
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Orientation="Horizontal">
                                                        <mah:ProgressRing
                                                            Width="22"
                                                            Height="22"
                                                            Foreground="{DynamicResource MahApps.Brushes.Accent}"
                                                            IsActive="True" />
                                                        <TextBlock
                                                            Margin="8,0,0,0"
                                                            VerticalAlignment="Center"
                                                            FontSize="11"
                                                            FontWeight="SemiBold"
                                                            Text="{Binding OperationStatus}" />
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!-- 空状态提示 -->
                            <Border IsHitTestVisible="False"
                                    Visibility="{Binding HasNoReaders, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    Padding="12,28" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="暂无读写器，点击右上角 + 添加" FontSize="11"
                                           Foreground="{DynamicResource MahApps.Brushes.Gray3}"
                                           TextWrapping="Wrap" TextAlignment="Center" />
                            </Border>
                        </Grid>
                    </StackPanel>
                </DockPanel>

                <Grid
                    Panel.ZIndex="10"
                    d:Visibility="Collapsed"
                    Visibility="{Binding IsSidebarBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Border Background="{DynamicResource MahApps.Brushes.ThemeBackground}" Opacity="0.92" />
                    <StackPanel
                        Width="210"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                        <mah:ProgressRing
                            Width="52"
                            Height="52"
                            HorizontalAlignment="Center"
                            Foreground="{DynamicResource MahApps.Brushes.Accent}"
                            IsActive="True"
                            IsLarge="True" />
                        <TextBlock
                            Margin="0,14,0,0"
                            HorizontalAlignment="Center"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Text="{Binding BusyMessage}"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="0" Grid.Column="1">
            <ContentControl Content="{Binding CurrentPage}" />

            <Grid Panel.ZIndex="10" Visibility="{Binding IsContentBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Border Background="{DynamicResource MahApps.Brushes.ThemeBackground}" Opacity="0.92" />
                <StackPanel
                    Width="280"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                    <mah:ProgressRing
                        Width="56"
                        Height="56"
                        HorizontalAlignment="Center"
                        Foreground="{DynamicResource MahApps.Brushes.Accent}"
                        IsActive="True"
                        IsLarge="True" />
                    <TextBlock
                        Margin="0,14,0,0"
                        HorizontalAlignment="Center"
                        FontSize="15"
                        FontWeight="SemiBold"
                        Text="{Binding ContentBusyMessage}"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Grid>

        <Border
            Grid.Row="1"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Padding="20,0"
            BorderBrush="{DynamicResource MahApps.Brushes.Accent}"
            BorderThickness="0,1,0,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="12"
                        Text="{Binding Inventory.DurationModeText}" />
                    <TextBlock
                        Margin="18,0,12,0"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{DynamicResource MahApps.Brushes.Gray3}"
                        Text="{Binding Inventory.Status}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <TextBlock FontSize="12" Opacity="0.6" Text="Unique Tags: " />
                    <TextBlock
                        FontSize="12"
                        FontWeight="Bold"
                        Foreground="{DynamicResource MahApps.Brushes.Accent}"
                        Text="{Binding Inventory.UniqueTagCount}" />
                    <TextBlock
                        Margin="16,0,0,0"
                        FontSize="12"
                        Opacity="0.6"
                        Text="  |  Read Rate: " />
                    <TextBlock
                        FontSize="12"
                        FontWeight="Bold"
                        Foreground="{DynamicResource MahApps.Brushes.Accent}"
                        Text="{Binding Inventory.TagRate}" />
                    <TextBlock
                        Margin="16,0,0,0"
                        FontSize="12"
                        Opacity="0.6"
                        Text="  |  Dropped: " />
                    <TextBlock
                        FontSize="12"
                        FontWeight="Bold"
                        Foreground="{DynamicResource MahApps.Brushes.Accent}"
                        Text="{Binding Inventory.DroppedTagReportCount}" />
                    <TextBlock
                        Margin="16,0,0,0"
                        FontSize="12"
                        Opacity="0.6"
                        Text="  |  Selected: " />
                    <TextBlock
                        FontSize="12"
                        FontWeight="Bold"
                        Foreground="{DynamicResource MahApps.Brushes.Accent}"
                        Text="{Binding SelectedReader.Name}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</mah:MetroWindow>
