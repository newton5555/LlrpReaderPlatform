<UserControl x:Class="LlrpReaderPlatform.App.Wpf.Views.InventoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:local="clr-namespace:LlrpReaderPlatform.App.Wpf.Views">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <local:BindingProxy x:Key="InventoryVmProxy" Data="{Binding}" />
        <Style x:Key="InventoryLifecycleButtonStyle" TargetType="Button">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                    <Setter Property="IsEnabled" Value="False" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="68" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderThickness="0,0,0,1" Padding="20,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Command="{Binding ToggleAllCommand}"
                        Width="96" Height="36" ToolTip="Start / Stop LLRP Reader Inventory">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource InventoryLifecycleButtonStyle}">
                            <Setter Property="Content" Value="Start" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsInventoryRunning}" Value="True">
                                    <Setter Property="Content" Value="Stop" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <TextBlock Text="UNIQUE TAGS: " FontSize="12" FontWeight="Bold"
                               VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding UniqueTagCount}" FontSize="30"
                               FontFamily="Consolas, Courier New" FontWeight="Bold"
                               VerticalAlignment="Center" />
                    <TextBlock Text="  |  " FontSize="16" VerticalAlignment="Center" Margin="12,0,0,0" />
                    <TextBlock Text="{Binding Elapsed}" FontSize="15" VerticalAlignment="Center" />
                    <TextBlock Text="  |  " FontSize="16" VerticalAlignment="Center" Margin="12,0,0,0" />
                    <TextBlock Text="{Binding TagRate}" FontSize="15" VerticalAlignment="Center" />
                    <TextBlock Text="  |  DROPPED: " FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0" />
                    <TextBlock Text="{Binding DroppedTagReportCount}" FontSize="15" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="REFRESH" Command="{Binding RefreshCommand}" Padding="12,6" />
                    <Button Content="CLEAR" Command="{Binding ClearCommand}" Padding="12,6" Margin="8,0,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <WrapPanel Grid.Row="0" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,4">
            <CheckBox Content="#" IsChecked="{Binding ShowIndexColumn}" Margin="8,0" />
            <CheckBox Content="Count" IsChecked="{Binding ShowCountColumn}" Margin="8,0" />
            <CheckBox Content="Reader" IsChecked="{Binding ShowReaderColumn}" Margin="8,0" />
            <CheckBox Content="TID" IsChecked="{Binding ShowTidColumn}" Margin="8,0" />
            <CheckBox Content="First" IsChecked="{Binding ShowFirstSeenColumn}" Margin="8,0" />
            <CheckBox Content="Last" IsChecked="{Binding ShowLastSeenColumn}" Margin="8,0" />
            <CheckBox Content="Antenna" IsChecked="{Binding ShowAntennaColumn}" Margin="8,0" />
            <CheckBox Content="RSSI" IsChecked="{Binding ShowRssiColumn}" Margin="8,0" />
            <CheckBox Content="Channel" IsChecked="{Binding ShowChannelColumn}" Margin="8,0" />
            <CheckBox Content="PC" IsChecked="{Binding ShowPcBitsColumn}" Margin="8,0" />
        </WrapPanel>

                <ProgressBar Grid.Row="0" VerticalAlignment="Bottom" Height="3"
                     IsIndeterminate="{Binding IsBusy}" />

        <DataGrid Grid.Row="1" ItemsSource="{Binding Tags}" AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" GridLinesVisibility="Horizontal" RowHeight="32"
                  FontSize="12" Margin="16" BorderThickness="1">
            <DataGrid.Resources>
                <Style x:Key="CenteredCellTextStyle" TargetType="TextBlock">
                    <Setter Property="VerticalAlignment" Value="Center" />
                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                </Style>
                <Style x:Key="CenteredMonoCellTextStyle" TargetType="TextBlock"
                       BasedOn="{StaticResource CenteredCellTextStyle}">
                    <Setter Property="FontFamily" Value="Consolas, Courier New" />
                </Style>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="FontWeight" Value="Bold" />
                    <Setter Property="Padding" Value="10,8" />
                    <Setter Property="BorderThickness" Value="0,0,1,1" />
                </Style>
                <Style TargetType="DataGridCell">
                    <Setter Property="Padding" Value="8,4" />
                    <Setter Property="VerticalContentAlignment" Value="Center" />
                </Style>
            </DataGrid.Resources>
            <DataGrid.Columns>
                <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="50"
                                    Visibility="{Binding Data.ShowIndexColumn, Source={StaticResource InventoryVmProxy}, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    ElementStyle="{StaticResource CenteredCellTextStyle}" />
                <DataGridTextColumn Header="EPC" Binding="{Binding Epc}" Width="2.2*"
                                    ElementStyle="{StaticResource CenteredMonoCellTextStyle}" />
                <DataGridTextColumn Header="Tag List" Binding="{Binding TagListName}" Width="1.4*"
                                    ElementStyle="{StaticResource CenteredCellTextStyle}" />
                <DataGridTextColumn Header="Reader" Binding="{Binding ReaderName}" Width="1.3*"
                                    Visibility="{Binding Data.ShowReaderColumn, Source={StaticResource InventoryVmProxy}, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    ElementStyle="{StaticResource CenteredCellTextStyle}" />
                <DataGridTextColumn Header="TID" Binding="{Binding Tid}" Width="1.8*"
                                    Visibility="{Binding Data.ShowTidColumn, Source={StaticResource InventoryVmProxy}, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    ElementStyle="{StaticResource CenteredMonoCellTextStyle}" />
                <DataGridTextColumn Header="Count" Binding="{Binding ReadCount}" Width="80"
                                    Visibility="{Binding Data.ShowCountColumn, Source={StaticResource InventoryVmProxy}, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    ElementStyle="{StaticResource CenteredCellTextStyle}" />
                <DataGridTextColumn Header="First Seen" Binding="{Binding FirstSeen}" Width="110"
                                    Visibility="{Binding Data.ShowFirstSeenColumn, Source={StaticResource InventoryVmProxy}, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    ElementStyle="{StaticResource CenteredCellTextStyle}" />
                <DataGridTextColumn Header="Last Seen" Binding="{Binding LastSeen}" Width="110"
                                    Visibility="{Binding Data.ShowLastSeenColumn, Source={StaticResource InventoryVmProxy}, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    ElementStyle="{StaticResource CenteredCellTextStyle}" />
                <DataGridTextColumn Header="Antenna" Binding="{Binding LastAntenna}" Width="80"
                                    Visibility="{Binding Data.ShowAntennaColumn, Source={StaticResource InventoryVmProxy}, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    ElementStyle="{StaticResource CenteredCellTextStyle}" />
                <DataGridTextColumn Header="RSSI" Binding="{Binding LastRssi}" Width="80"
                                    Visibility="{Binding Data.ShowRssiColumn, Source={StaticResource InventoryVmProxy}, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    ElementStyle="{StaticResource CenteredCellTextStyle}" />
                <DataGridTextColumn Header="Channel" Binding="{Binding LastChannelIndex}" Width="80"
                                    Visibility="{Binding Data.ShowChannelColumn, Source={StaticResource InventoryVmProxy}, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    ElementStyle="{StaticResource CenteredCellTextStyle}" />
                <DataGridTextColumn Header="PC Bits" Binding="{Binding PcBitsHex}" Width="90"
                                    Visibility="{Binding Data.ShowPcBitsColumn, Source={StaticResource InventoryVmProxy}, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    ElementStyle="{StaticResource CenteredMonoCellTextStyle}" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
