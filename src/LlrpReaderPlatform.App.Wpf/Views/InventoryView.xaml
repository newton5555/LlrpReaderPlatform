<UserControl x:Class="LlrpReaderPlatform.App.Wpf.Views.InventoryView"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
              xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp"
              xmlns:local="clr-namespace:LlrpReaderPlatform.App.Wpf.Views">
    <UserControl.Resources>
        <local:BindingProxy x:Key="InventoryVmProxy" Data="{Binding}" />
        <Style x:Key="InventoryLifecycleButtonStyle" TargetType="Button"
               BasedOn="{StaticResource PrimaryActionButtonStyle}">
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="mah:ControlsHelper.CornerRadius" Value="4" />
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="68" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderThickness="0,0,0,1" Padding="20,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Command="{Binding ToggleAllCommand}"
                        Width="96" Height="36" ToolTip="Start / Stop LLRP Reader Inventory">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource InventoryLifecycleButtonStyle}">
                            <Setter Property="Content" Value="Start" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsInventoryStarting}" Value="True">
                                    <Setter Property="Content" Value="Cancel" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsInventoryRunning}" Value="True">
                                    <Setter Property="Content" Value="Stop" />
                                    <Setter Property="Background" Value="#DC2626" />
                                    <Setter Property="BorderBrush" Value="#DC2626" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <TextBlock Text="ELAPSED TIME: " FontSize="12" FontWeight="Bold"
                               VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding Elapsed}" FontSize="36"
                               FontFamily="Consolas, Courier New" FontWeight="Bold"
                               VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Duration(s)" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <TextBox Text="{Binding DurationSecondsText, UpdateSourceTrigger=PropertyChanged}"
                             Width="64" Padding="4,2" VerticalContentAlignment="Center"
                             ToolTip="0 = continuous inventory" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <DataGrid ItemsSource="{Binding Tags}" AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserAddRows="False" GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="{DynamicResource MahApps.Brushes.Gray8}"
                      RowHeight="38"
                      FontSize="12" Margin="16" BorderThickness="1"
                      EnableRowVirtualization="True" EnableColumnVirtualization="True"
                      ScrollViewer.CanContentScroll="True"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling">
            <DataGrid.Resources>
                <ContextMenu x:Key="TagRowContextMenu"
                             x:Shared="False"
                             DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                    <MenuItem Header="复制 EPC"
                              CommandParameter="{Binding}"
                              Click="CopyEpcMenuItem_Click">
                        <MenuItem.Icon>
                            <fa:IconBlock Icon="Copy" IconFont="Solid" FontSize="13"
                                          Foreground="{DynamicResource MahApps.Brushes.Accent}" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="复制 TID"
                              CommandParameter="{Binding}"
                              Visibility="{Binding HasTid, Converter={StaticResource BooleanToVisibilityConverter}}"
                              Click="CopyTidMenuItem_Click">
                        <MenuItem.Icon>
                            <fa:IconBlock Icon="Clone" IconFont="Solid" FontSize="13"
                                          Foreground="{DynamicResource MahApps.Brushes.Accent}" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="复制整行数据 (TSV)"
                              CommandParameter="{Binding}"
                              Click="CopyRowDetailsMenuItem_Click">
                        <MenuItem.Icon>
                            <fa:IconBlock Icon="TableList" IconFont="Solid" FontSize="13"
                                          Foreground="{DynamicResource MahApps.Brushes.Accent}" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <Separator />
                    <MenuItem Header="在 Tag Memory 中操作"
                              CommandParameter="{Binding}"
                              Click="OpenInTagMemoryMenuItem_Click">
                        <MenuItem.Icon>
                            <fa:IconBlock Icon="Microchip" IconFont="Solid" FontSize="13"
                                          Foreground="{DynamicResource MahApps.Brushes.Accent}" />
                        </MenuItem.Icon>
                    </MenuItem>
                </ContextMenu>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="FontWeight" Value="Bold" />
                    <Setter Property="Padding" Value="10,8" />
                    <Setter Property="BorderThickness" Value="0,0,1,1" />
                    <Setter Property="ContextMenu">
                        <Setter.Value>
                            <ContextMenu>
                                <MenuItem Header="序号 (#)" IsCheckable="True"
                                          IsChecked="{Binding Data.ShowIndexColumn, Source={StaticResource InventoryVmProxy}, Mode=TwoWay}" />
                                <MenuItem Header="EPC" IsCheckable="True"
                                          IsChecked="{Binding Data.ShowEpcColumn, Source={StaticResource InventoryVmProxy}, Mode=TwoWay}" />
                                <MenuItem Header="TID" IsCheckable="True"
                                          IsChecked="{Binding Data.ShowTidColumn, Source={StaticResource InventoryVmProxy}, Mode=TwoWay}" />
                                <MenuItem Header="Count (读卡数)" IsCheckable="True"
                                          IsChecked="{Binding Data.ShowCountColumn, Source={StaticResource InventoryVmProxy}, Mode=TwoWay}" />
                                <MenuItem Header="First Seen (首次发现)" IsCheckable="True"
                                          IsChecked="{Binding Data.ShowFirstSeenColumn, Source={StaticResource InventoryVmProxy}, Mode=TwoWay}" />
                                <MenuItem Header="Last Seen (末次发现)" IsCheckable="True"
                                          IsChecked="{Binding Data.ShowLastSeenColumn, Source={StaticResource InventoryVmProxy}, Mode=TwoWay}" />
                                <Separator />
                                <MenuItem Header="Reader (读写器)" IsCheckable="True"
                                          IsChecked="{Binding Data.ShowReaderColumn, Source={StaticResource InventoryVmProxy}, Mode=TwoWay}" />
                                <MenuItem Header="Antenna (天线)" IsCheckable="True"
                                          IsChecked="{Binding Data.ShowAntennaColumn, Source={StaticResource InventoryVmProxy}, Mode=TwoWay}" />
                                <MenuItem Header="Peak RSSI (峰值信号)" IsCheckable="True"
                                          IsChecked="{Binding Data.ShowRssiColumn, Source={StaticResource InventoryVmProxy}, Mode=TwoWay}" />
                                <MenuItem Header="Channel (信道)" IsCheckable="True"
                                          IsChecked="{Binding Data.ShowChannelColumn, Source={StaticResource InventoryVmProxy}, Mode=TwoWay}" />
                                <Separator />
                                <MenuItem Header="PC Bits" IsCheckable="True"
                                          IsChecked="{Binding Data.ShowPcBitsColumn, Source={StaticResource InventoryVmProxy}, Mode=TwoWay}" />
                                <MenuItem Header="Phase (相位)" IsCheckable="True"
                                          IsChecked="{Binding Data.ShowPhaseColumn, Source={StaticResource InventoryVmProxy}, Mode=TwoWay}" />
                                <MenuItem Header="GPS (位置)" IsCheckable="True"
                                          IsChecked="{Binding Data.ShowGpsColumn, Source={StaticResource InventoryVmProxy}, Mode=TwoWay}" />
                                <MenuItem Header="XPC" IsCheckable="True"
                                          IsChecked="{Binding Data.ShowXpcColumn, Source={StaticResource InventoryVmProxy}, Mode=TwoWay}" />
                            </ContextMenu>
                        </Setter.Value>
                    </Setter>
                </Style>
                <Style TargetType="DataGridCell">
                    <Setter Property="Padding" Value="8,4" />
                    <Setter Property="VerticalContentAlignment" Value="Center" />
                </Style>
            </DataGrid.Resources>
            <DataGrid.RowStyle>
                <Style TargetType="{x:Type DataGridRow}" BasedOn="{StaticResource MahApps.Styles.DataGridRow}">
                    <!-- MahApps' base row style inherits this value through a FindAncestor
                         binding. Override it on the recyclable row container so a detached row
                         does not emit a transient missing-DataGrid binding warning. -->
                    <Setter Property="mah:DataGridHelper.CellPadding" Value="8,4" />
                    <Setter Property="ContextMenu" Value="{StaticResource TagRowContextMenu}" />
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="#" Binding="{Binding Index, Mode=OneWay}" Width="50"
                                    Visibility="{Binding Data.ShowIndexColumn, Source={StaticResource InventoryVmProxy}, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    ElementStyle="{StaticResource CenteredCellTextStyle}" />
                <DataGridTextColumn Header="EPC" Binding="{Binding Epc, Mode=OneWay}" Width="2.2*"
                                    Visibility="{Binding Data.ShowEpcColumn, Source={StaticResource InventoryVmProxy}, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    ElementStyle="{StaticResource LeftMonoCellTextStyle}" />
                <DataGridTextColumn Header="TID" Binding="{Binding Tid, Mode=OneWay}" Width="1.8*"
                                    Visibility="{Binding Data.ShowTidColumn, Source={StaticResource InventoryVmProxy}, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    ElementStyle="{StaticResource LeftMonoCellTextStyle}" />
                <DataGridTextColumn Header="Count" Binding="{Binding ReadCount, Mode=OneWay}" Width="80"
                                    Visibility="{Binding Data.ShowCountColumn, Source={StaticResource InventoryVmProxy}, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    ElementStyle="{StaticResource CenteredCellTextStyle}" />
                <DataGridTextColumn Header="First Seen" Binding="{Binding FirstSeen, Mode=OneWay}" Width="110"
                                    Visibility="{Binding Data.ShowFirstSeenColumn, Source={StaticResource InventoryVmProxy}, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    ElementStyle="{StaticResource CenteredCellTextStyle}" />
                <DataGridTextColumn Header="Last Seen" Binding="{Binding LastSeen, Mode=OneWay}" Width="110"
                                    Visibility="{Binding Data.ShowLastSeenColumn, Source={StaticResource InventoryVmProxy}, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    ElementStyle="{StaticResource CenteredCellTextStyle}" />
                <DataGridTextColumn Header="Reader" Binding="{Binding ReaderName, Mode=OneWay}" Width="1.3*"
                                    Visibility="{Binding Data.ShowReaderColumn, Source={StaticResource InventoryVmProxy}, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    ElementStyle="{StaticResource CenteredCellTextStyle}" />
                <DataGridTextColumn Header="Antenna" Binding="{Binding LastAntenna, Mode=OneWay}" Width="80"
                                    Visibility="{Binding Data.ShowAntennaColumn, Source={StaticResource InventoryVmProxy}, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    ElementStyle="{StaticResource CenteredCellTextStyle}" />
                <DataGridTextColumn Header="Peak RSSI" Binding="{Binding PeakRssi, Mode=OneWay}" Width="90"
                                    Visibility="{Binding Data.ShowRssiColumn, Source={StaticResource InventoryVmProxy}, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    ElementStyle="{StaticResource CenteredCellTextStyle}" />
                <DataGridTextColumn Header="Channel" Binding="{Binding LastChannelIndex, Mode=OneWay}" Width="80"
                                    Visibility="{Binding Data.ShowChannelColumn, Source={StaticResource InventoryVmProxy}, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    ElementStyle="{StaticResource CenteredCellTextStyle}" />
                <DataGridTextColumn Header="PC Bits" Binding="{Binding PcBitsHex, Mode=OneWay}" Width="90"
                                    Visibility="{Binding Data.ShowPcBitsColumn, Source={StaticResource InventoryVmProxy}, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    ElementStyle="{StaticResource LeftMonoCellTextStyle}" />
                <DataGridTextColumn Header="Phase" Binding="{Binding Phase, Mode=OneWay}" Width="90"
                                    Visibility="{Binding Data.ShowPhaseColumn, Source={StaticResource InventoryVmProxy}, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    ElementStyle="{StaticResource CenteredMonoCellTextStyle}" />
                <DataGridTextColumn Header="GPS" Binding="{Binding Gps, Mode=OneWay}" Width="150"
                                    Visibility="{Binding Data.ShowGpsColumn, Source={StaticResource InventoryVmProxy}, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    ElementStyle="{StaticResource CenteredMonoCellTextStyle}" />
                <DataGridTextColumn Header="XPC" Binding="{Binding Xpc, Mode=OneWay}" Width="120"
                                    Visibility="{Binding Data.ShowXpcColumn, Source={StaticResource InventoryVmProxy}, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    ElementStyle="{StaticResource LeftMonoCellTextStyle}" />
                <DataGridTemplateColumn Header="TOI" Width="1.4*" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="14" Height="14" CornerRadius="3" BorderThickness="1"
                                        BorderBrush="{DynamicResource MahApps.Brushes.Gray7}"
                                        Background="{Binding TagColorHex, Mode=OneWay, Converter={StaticResource HexColorToBrushConverter}}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding TagListName}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                                <TextBlock Text="{Binding TagListName, Mode=OneWay}" Margin="7,0,0,0"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
            </DataGrid>

            <!-- 空状态占位提示 -->
            <Border IsHitTestVisible="False"
                    Visibility="{Binding IsEmptyStateVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="未开始盘存" FontSize="14" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Foreground="{DynamicResource MahApps.Brushes.Gray3}" />
                    <TextBlock Text="点击左上方 Start 开始寻卡" FontSize="12"
                               HorizontalAlignment="Center" Foreground="{DynamicResource MahApps.Brushes.Gray4}" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

        </Grid>

        <Grid Grid.RowSpan="2" Panel.ZIndex="20"
              Visibility="{Binding IsInventoryStopping, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Background="{DynamicResource MahApps.Brushes.ThemeBackground}" Opacity="0.86" />
            <StackPanel Width="320" HorizontalAlignment="Center" VerticalAlignment="Center">
                <mah:ProgressRing Width="48" Height="48" HorizontalAlignment="Center"
                                  Foreground="{DynamicResource MahApps.Brushes.Accent}"
                                  IsActive="True" IsLarge="True" />
                <TextBlock Margin="0,14,0,0" HorizontalAlignment="Center"
                           FontSize="14" FontWeight="SemiBold"
                           Text="{Binding Status}" TextAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
