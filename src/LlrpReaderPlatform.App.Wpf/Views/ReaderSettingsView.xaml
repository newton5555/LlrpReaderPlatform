                                            <TextBlock
                                                Grid.Column="1"
                                                FontSize="11"
                                                FontWeight="Bold"
                                                Foreground="{DynamicResource MahApps.Brushes.Gray3}"
                                                Text="CONFIGURED" />
                                            <TextBlock
                                                Grid.Column="2"
                                                FontSize="11"
                                                FontWeight="Bold"
                                                Foreground="{DynamicResource MahApps.Brushes.Gray3}"
                                                Text="STATE" />
                                        </Grid>
                                        <ItemsControl Grid.Row="1" ItemsSource="{Binding Diagnostics.Gpis}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border
                                                        Padding="0,6"
                                                        BorderBrush="{DynamicResource MahApps.Brushes.Gray8}"
                                                        BorderThickness="0,0,0,1">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="80" />
                                                                <ColumnDefinition Width="130" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock
                                                                Grid.Column="0"
                                                                VerticalAlignment="Center"
                                                                FontWeight="SemiBold"
                                                                Text="{Binding PortNumber, StringFormat='GPI {0}'}" />
                                                            <StackPanel
                                                                Grid.Column="1"
                                                                VerticalAlignment="Center"
                                                                Orientation="Horizontal">
                                                                <Border
                                                                    Width="7"
                                                                    Height="7"
                                                                    Margin="0,0,6,0"
                                                                    VerticalAlignment="Center"
                                                                    CornerRadius="3.5">
                                                                    <Border.Style>
                                                                        <Style TargetType="Border">
                                                                            <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.Gray7}" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding Configured}" Value="True">
                                                                                    <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.Accent}" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Border.Style>
                                                                </Border>
                                                                <TextBlock VerticalAlignment="Center" FontSize="12">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Text" Value="Disabled" />
                                                                            <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Gray3}" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding Configured}" Value="True">
                                                                                    <Setter Property="Text" Value="Configured" />
                                                                                    <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Text}" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </StackPanel>
                                                            <StackPanel
                                                                Grid.Column="2"
                                                                VerticalAlignment="Center"
                                                                Orientation="Horizontal">
                                                                <Border
                                                                    Width="7"
                                                                    Height="7"
                                                                    Margin="0,0,6,0"
                                                                    VerticalAlignment="Center"
                                                                    CornerRadius="3.5">
                                                                    <Border.Style>
                                                                        <Style TargetType="Border">
                                                                            <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.Gray7}" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding State}" Value="True">
                                                                                    <Setter Property="Background" Value="#16A34A" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Border.Style>
                                                                </Border>
                                                                <TextBlock VerticalAlignment="Center" FontSize="12">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Text" Value="Low (0)" />
                                                                            <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Gray3}" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding State}" Value="True">
                                                                                    <Setter Property="Text" Value="High (1)" />
                                                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                                                    <Setter Property="Foreground" Value="#16A34A" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <StackPanel
                                            Grid.Row="2"
                                            Margin="0,12,0,0"
                                            HorizontalAlignment="Right"
                                            Orientation="Horizontal">
                                            <Button
                                                Height="30"
                                                Padding="12,0"
                                                Command="{Binding Diagnostics.RefreshGpioCommand}"
                                                CommandParameter="{Binding DataContext.ReaderId, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                Style="{StaticResource FlatActionButtonStyle}"
                                                ToolTip="读取或刷新当前 Reader 的 GPI 状态">
                                                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                                    <fa:IconBlock
                                                        Margin="0,0,6,0"
                                                        VerticalAlignment="Center"
                                                        FontSize="12"
                                                        Icon="ArrowsRotate"
                                                        IconFont="Solid" />
                                                    <TextBlock VerticalAlignment="Center" Text="GET GPI STATUS" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </DockPanel>
                            </Border>

                            <!--  GPIO 操作与状态日志 (无框，右下角对齐)  -->
                            <TextBlock
                                Margin="0,10,4,16"
                                HorizontalAlignment="Right"
                                FontSize="12"
                                Foreground="{DynamicResource MahApps.Brushes.Gray2}"
                                Text="{Binding Diagnostics.Status}"
                                TextAlignment="Right"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>

            <Border
                Margin="0,18,0,0"
                Padding="24"
                Background="{DynamicResource MahApps.Brushes.ThemeBackground}"
                BorderBrush="{DynamicResource MahApps.Brushes.Accent}"
                BorderThickness="1"
                CornerRadius="4">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSettingsLayoutAvailable}" Value="False">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock
                        FontSize="18"
                        FontWeight="SemiBold"
                        Text="Reader settings are not ready" />
                    <TextBlock
                        Margin="0,8,0,0"
                        Text="Connect and refresh the Reader to obtain its capabilities before editing Tab1 or Tab2 settings."
                        TextWrapping="Wrap" />
                    <TextBlock
                        Margin="0,10,0,0"
                        Foreground="{DynamicResource MahApps.Brushes.Gray3}"
                        Text="{Binding Status}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>

    </DockPanel>
</UserControl>
