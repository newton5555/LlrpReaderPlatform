<UserControl
    x:Class="LlrpReaderPlatform.App.Wpf.Views.ReaderSettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp"
    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
    xmlns:vm="clr-namespace:LlrpReaderPlatform.App.Wpf.ViewModels">
    <UserControl.Resources>
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Opacity" Value="0.75" />
            <Setter Property="Margin" Value="0,0,8,6" />
        </Style>
        <Style x:Key="FieldControlStyle" TargetType="Control">
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="MinHeight" Value="24" />
        </Style>
        <Style x:Key="SectionBorderStyle" TargetType="Border">
            <Setter Property="Margin" Value="0,0,10,10" />
            <Setter Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.Accent}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.ThemeBackground}" />
        </Style>
        <Style x:Key="SectionHeaderStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.Accent}" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="CornerRadius" Value="3,3,0,0" />
        </Style>
        <Style x:Key="SectionHeaderTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.IdealForeground}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style
            x:Key="DiagnosticsRefreshStyle"
            BasedOn="{StaticResource FlatActionButtonStyle}"
            TargetType="Button">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Diagnostics.IsBusy}" Value="True">
                    <Setter Property="IsEnabled" Value="False" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style
            x:Key="SettingsActionStyle"
            BasedOn="{StaticResource FlatActionButtonStyle}"
            TargetType="Button">
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="mah:ControlsHelper.CornerRadius" Value="4" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                    <Setter Property="IsEnabled" Value="False" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style
            x:Key="SettingsPrimaryActionStyle"
            BasedOn="{StaticResource PrimaryActionButtonStyle}"
            TargetType="Button">
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="mah:ControlsHelper.CornerRadius" Value="4" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                    <Setter Property="IsEnabled" Value="False" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SettingsTabItemStyle" TargetType="TabItem">
            <Setter Property="Padding" Value="18,8" />
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="HeaderTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock
                            FontSize="16"
                            FontWeight="SemiBold"
                            Text="{Binding}" />
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SettingsTabControlStyle" TargetType="TabControl">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                    <Setter Property="IsEnabled" Value="False" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsReaderAvailable}" Value="False">
                    <Setter Property="IsEnabled" Value="False" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSettingsLayoutAvailable}" Value="False">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!--  仅渲染值编辑器（不带动画左侧标签），供 OTHER SETTINGS 的 ListView 值列使用  -->
        <DataTemplate x:Key="SettingsValueEditorTemplate">
            <Grid>
                <ComboBox
                    VerticalAlignment="Center"
                    ItemsSource="{Binding ChoiceDisplays}"
                    SelectedIndex="{Binding SelectedChoiceIndex, Mode=TwoWay}">
                    <ComboBox.Style>
                        <Style TargetType="ComboBox">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsChoice}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsReadOnly}" Value="True">
                                    <Setter Property="IsEnabled" Value="False" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ComboBox.Style>
                </ComboBox>

                <CheckBox
                    VerticalAlignment="Center"
                    Content="Enabled"
                    IsChecked="{Binding BooleanValue, Mode=TwoWay}">
                    <CheckBox.Style>
                        <Style TargetType="CheckBox">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBoolean}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsReadOnly}" Value="True">
                                    <Setter Property="IsEnabled" Value="False" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </CheckBox.Style>
                </CheckBox>

                <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto">
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCollection}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsReadOnly}" Value="True">
                                    <Setter Property="IsEnabled" Value="False" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>
                    <ItemsControl ItemsSource="{Binding CollectionItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox
                                    Margin="0,2"
                                    Content="{Binding Display}"
                                    IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <TextBox VerticalAlignment="Center" Text="{Binding ValueText, UpdateSourceTrigger=PropertyChanged}">
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsText}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsReadOnly}" Value="True">
                                    <Setter Property="IsEnabled" Value="False" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>

                <TextBlock
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource MahApps.Brushes.Gray3}"
                    Text="{Binding ReadOnlyReason}"
                    TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsReadOnly}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel Margin="12">
        <Grid Margin="0,0,0,10" DockPanel.Dock="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <WrapPanel Margin="0,0,0,8">
                    <TextBlock
                        Margin="0,0,6,0"
                        FontWeight="SemiBold"
                        Opacity="0.75"
                        Text="Hostname:" />
                    <TextBlock Margin="0,0,24,0" Text="{Binding ReaderHost}" />
                    <TextBlock
                        Margin="0,0,6,0"
                        FontWeight="SemiBold"
                        Opacity="0.75"
                        Text="Interface:" />
                    <TextBlock Margin="0,0,24,0" Text="LLRP" />
                    <TextBlock
                        Margin="0,0,6,0"
                        FontWeight="SemiBold"
                        Opacity="0.75"
                        Text="Model:" />
                    <TextBlock Margin="0,0,24,0" Text="{Binding ReaderModel}" />
                    <TextBlock
                        Margin="0,0,6,0"
                        FontWeight="SemiBold"
                        Opacity="0.75"
                        Text="LLRP:" />
                    <TextBlock Margin="0,0,24,0" Text="{Binding ReaderProtocol}" />
                    <TextBlock
                        Margin="0,0,6,0"
                        FontWeight="SemiBold"
                        Opacity="0.75"
                        Text="Policy:" />
                    <TextBlock Margin="0,0,24,0" Text="{Binding ReaderProtocolPolicy}" />
                    <TextBlock
                        Margin="0,0,6,0"
                        FontWeight="SemiBold"
                        Opacity="0.75"
                        Text="Session:" />
                    <TextBlock Margin="0,0,24,0" Text="{Binding ReaderConnection}" />
                    <TextBlock
                        Margin="0,0,6,0"
                        FontWeight="SemiBold"
                        Opacity="0.75"
                        Text="Extension:" />
                    <TextBlock Margin="0,0,24,0" Text="{Binding ReaderExtensions}" />
                    <TextBlock
                        Margin="0,0,6,0"
                        FontWeight="SemiBold"
                        Opacity="0.75"
                        Text="Region:" />
                    <TextBlock Text="{Binding ReaderRegion}" />
                </WrapPanel>
            </StackPanel>
            <WrapPanel
                Grid.Column="1"
                HorizontalAlignment="Right"
                VerticalAlignment="Top">
                <Button
                    Margin="4,0,0,0"
                    Command="{Binding LoadCommand}"
                    CommandParameter="{Binding ReaderId}"
                    Style="{StaticResource FlatCircleButtonStyle}"
                    ToolTip="REFRESH SETTINGS">
                    <fa:IconBlock
                        FontSize="13"
                        Icon="ArrowsRotate"
                        IconFont="Solid" />
                </Button>
                <Button
                    Margin="4,0,0,0"
                    Command="{Binding LoadDefaultsCommand}"
                    Style="{StaticResource FlatCircleButtonStyle}"
                    ToolTip="LOAD DEFAULTS">
                    <fa:IconBlock
                        FontSize="13"
                        Icon="Download"
                        IconFont="Solid" />
                </Button>
            </WrapPanel>
        </Grid>

        <ProgressBar
            Height="4"
            Margin="0,0,0,6"
            DockPanel.Dock="Top"
            IsIndeterminate="True"
            Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />

        <Grid>
            <TabControl Style="{StaticResource SettingsTabControlStyle}">
                <TabItem Header="Inventory" Style="{StaticResource SettingsTabItemStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ScrollViewer
                            Grid.Row="0"
                            Padding="0,0,0,12"
                            VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <WrapPanel Margin="0,0,0,8">
                                    <TextBlock
                                        Margin="0,0,8,0"
                                        VerticalAlignment="Center"
                                        Text="Preset:" />
                                    <ComboBox
                                        Width="260"
                                        Margin="0,0,16,0"
                                        IsEditable="True"
                                        Text="{Binding Preset}">
                                        <ComboBoxItem Content="Default" />
                                    </ComboBox>
                                    <TextBlock VerticalAlignment="Center" Text="{Binding SettingsOrigin}" />
                                </WrapPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                        <Border Style="{StaticResource SectionBorderStyle}" Visibility="{Binding IsManualSettingsVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <DockPanel>
                                                <Border DockPanel.Dock="Top" Style="{StaticResource SectionHeaderStyle}">
                                                    <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="MANUAL SETTINGS" />
                                                </Border>
                                                <Grid Margin="12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="160" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>

                                                    <TextBlock
                                                        Grid.Row="0"
                                                        Style="{StaticResource FieldLabelStyle}"
                                                        Text="Antennas:" />
                                                    <DockPanel
                                                        Grid.Row="0"
                                                        Grid.Column="1"
                                                        Margin="0,0,0,6">
                                                        <StackPanel
                                                            Margin="0,6,0,0"
                                                            DockPanel.Dock="Bottom"
                                                            Orientation="Horizontal">
                                                            <Button
                                                                Width="60"
                                                                Height="28"
                                                                Margin="0,0,6,0"
                                                                Command="{Binding FillAllAntennasCommand}"
                                                                Content="ALL"
                                                                FontSize="{DynamicResource MahApps.Font.Size.Button}"
                                                                Style="{StaticResource FlatActionButtonStyle}" />
                                                            <Button
                                                                Width="60"
                                                                Height="28"
                                                                Command="{Binding ClearAntennasCommand}"
                                                                Content="CLEAR"
                                                                FontSize="{DynamicResource MahApps.Font.Size.Button}"
                                                                Style="{StaticResource FlatActionButtonStyle}" />
                                                        </StackPanel>
                                                        <TextBox IsReadOnly="{Binding AntennasRow.IsReadOnly}" Text="{Binding AntennasRow.ValueText, UpdateSourceTrigger=PropertyChanged}" />
                                                    </DockPanel>

                                                    <TextBlock
                                                        Grid.Row="1"
                                                        Style="{StaticResource FieldLabelStyle}"
                                                        Text="RF Mode:" />
                                                    <ComboBox
                                                        Grid.Row="1"
                                                        Grid.Column="1"
                                                        Margin="0,0,0,6"
                                                        IsEditable="True"
                                                        IsEnabled="{Binding IsRfModeEditable}"
                                                        ItemsSource="{Binding RfModeRow.ChoiceDisplays}"
                                                        SelectedIndex="{Binding RfModeRow.SelectedChoiceIndex, Mode=TwoWay}"
                                                        Text="{Binding RfModeRow.ValueText, UpdateSourceTrigger=PropertyChanged}" />

                                                    <TextBlock
                                                        Grid.Row="2"
                                                        Style="{StaticResource FieldLabelStyle}"
                                                        Text="Search Mode:"
                                                        Visibility="{Binding IsSearchModeVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                    <ComboBox
                                                        Grid.Row="2"
                                                        Grid.Column="1"
                                                        Margin="0,0,0,6"
                                                        IsEnabled="{Binding IsSearchModeEditable}"
                                                        ItemsSource="{Binding SearchModeRow.ChoiceDisplays}"
                                                        SelectedIndex="{Binding SearchModeRow.SelectedChoiceIndex, Mode=TwoWay}"
                                                        Visibility="{Binding IsSearchModeVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />

                                                    <TextBlock
                                                        Grid.Row="3"
                                                        Style="{StaticResource FieldLabelStyle}"
                                                        Text="Enable Fast ID:"
                                                        Visibility="{Binding IsFastIdVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                    <CheckBox
                                                        Grid.Row="3"
                                                        Grid.Column="1"
                                                        Margin="0,0,0,6"
                                                        IsChecked="{Binding FastIdRow.BooleanValue, Mode=TwoWay}"
                                                        IsEnabled="{Binding IsFastIdEditable}"
                                                        Visibility="{Binding IsFastIdVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />

                                                    <TextBlock
                                                        Grid.Row="4"
                                                        Style="{StaticResource FieldLabelStyle}"
                                                        Text="Estimated Tag Population:" />
                                                    <TextBox
                                                        Grid.Row="4"
                                                        Grid.Column="1"
                                                        Margin="0,0,0,6"
                                                        IsEnabled="{Binding IsPopulationEditable}"
                                                        Text="{Binding PopulationRow.ValueText, UpdateSourceTrigger=PropertyChanged}" />

                                                    <TextBlock
                                                        Grid.Row="5"
                                                        Style="{StaticResource FieldLabelStyle}"
                                                        Text="Session:" />
                                                    <ComboBox
                                                        Grid.Row="5"
                                                        Grid.Column="1"
                                                        Margin="0,0,0,6"
                                                        IsEnabled="{Binding IsSessionEditable}"
                                                        ItemsSource="{Binding SessionRow.ChoiceDisplays}"
                                                        SelectedIndex="{Binding SessionRow.SelectedChoiceIndex, Mode=TwoWay}" />

                                                    <TextBlock
                                                        Grid.Row="6"
                                                        Style="{StaticResource FieldLabelStyle}"
                                                        Text="Tari:"
                                                        Visibility="{Binding IsTariVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                    <ComboBox
                                                        Grid.Row="6"
                                                        Grid.Column="1"
                                                        Margin="0,0,0,6"
                                                        IsEditable="True"
                                                        IsEnabled="{Binding IsTariEditable}"
                                                        ItemsSource="{Binding TariRow.ChoiceDisplays}"
                                                        SelectedIndex="{Binding TariRow.SelectedChoiceIndex, Mode=TwoWay}"
                                                        Text="{Binding TariRow.ValueText, UpdateSourceTrigger=PropertyChanged}"
                                                        Visibility="{Binding IsTariVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />

                                                    <TextBlock
                                                        Grid.Row="7"
                                                        Style="{StaticResource FieldLabelStyle}"
                                                        Text="Report Phase Angle:"
                                                        Visibility="{Binding IsPhaseAngleVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                    <CheckBox
                                                        Grid.Row="7"
                                                        Grid.Column="1"
                                                        Margin="0,0,0,6"
                                                        IsChecked="{Binding PhaseAngleRow.BooleanValue, Mode=TwoWay}"
                                                        IsEnabled="{Binding IsPhaseAngleEditable}"
                                                        Visibility="{Binding IsPhaseAngleVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />

                                                    <TextBlock
                                                        Grid.Row="8"
                                                        Style="{StaticResource FieldLabelStyle}"
                                                        Text="Report Doppler Frequency:"
                                                        Visibility="{Binding IsDopplerVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                    <CheckBox
                                                        Grid.Row="8"
                                                        Grid.Column="1"
                                                        IsChecked="{Binding DopplerRow.BooleanValue, Mode=TwoWay}"
                                                        IsEnabled="{Binding IsDopplerEditable}"
                                                        Visibility="{Binding IsDopplerVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                </Grid>
                                            </DockPanel>
                                        </Border>

                                        <Border Style="{StaticResource SectionBorderStyle}" Visibility="{Binding IsPowerSettingsVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <DockPanel>
                                                <Border DockPanel.Dock="Top" Style="{StaticResource SectionHeaderStyle}">
                                                    <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="POWER AND SENSITIVITY SETTINGS" />
                                                </Border>
                                                <Grid Margin="8" DockPanel.Dock="Top">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="160" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <TextBlock
                                                        Grid.Column="0"
                                                        Style="{StaticResource FieldLabelStyle}"
                                                        Text="Tx Power:" />
                                                    <ComboBox
                                                        Grid.Column="1"
                                                        IsEnabled="{Binding IsTxPowerEditable}"
                                                        ItemsSource="{Binding TxPowerRow.ChoiceDisplays}"
                                                        SelectedIndex="{Binding TxPowerRow.SelectedChoiceIndex, Mode=TwoWay}"
                                                        Style="{StaticResource FieldControlStyle}" />
                                                    <TextBlock
                                                        Grid.Row="1"
                                                        Grid.Column="0"
                                                        Style="{StaticResource FieldLabelStyle}"
                                                        Text="Rx Sensitivity:" />
                                                    <ComboBox
                                                        Grid.Row="1"
                                                        Grid.Column="1"
                                                        IsEnabled="{Binding IsRxSensitivityEditable}"
                                                        ItemsSource="{Binding RxSensitivityRow.ChoiceDisplays}"
                                                        SelectedIndex="{Binding RxSensitivityRow.SelectedChoiceIndex, Mode=TwoWay}"
                                                        Style="{StaticResource FieldControlStyle}" />
                                                </Grid>
                                                <Expander
                                                    Margin="8,0,8,8"
                                                    DockPanel.Dock="Top"
                                                    IsExpanded="{Binding IsIndividualAntennaSettingsExpanded, Mode=TwoWay}">
                                                    <Expander.Header>
                                                        <Border MinWidth="280" Style="{StaticResource SectionHeaderStyle}">
                                                            <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="INDIVIDUAL ANTENNAS" />
                                                        </Border>
                                                    </Expander.Header>
                                                    <Border BorderBrush="{DynamicResource MahApps.Brushes.Accent}" BorderThickness="1">
                                                        <ItemsControl Margin="8" ItemsSource="{Binding AntennaSettings}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Grid Margin="0,4">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="140" />
                                                                            <ColumnDefinition Width="110" />
                                                                            <ColumnDefinition Width="*" />
                                                                            <ColumnDefinition Width="120" />
                                                                            <ColumnDefinition Width="*" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock
                                                                            Grid.Column="0"
                                                                            VerticalAlignment="Center"
                                                                            FontWeight="SemiBold"
                                                                            Text="{Binding Name}" />
                                                                        <TextBlock
                                                                            Grid.Column="1"
                                                                            VerticalAlignment="Center"
                                                                            Text="Tx Power:" />
                                                                        <ComboBox
                                                                            Grid.Column="2"
                                                                            Margin="0,0,12,0"
                                                                            ItemsSource="{Binding TxPower.ChoiceDisplays}"
                                                                            SelectedIndex="{Binding TxPower.SelectedChoiceIndex, Mode=TwoWay}">
                                                                            <ComboBox.Style>
                                                                                <Style TargetType="ComboBox">
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding TxPower.IsReadOnly}" Value="True">
                                                                                            <Setter Property="IsEnabled" Value="False" />
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </ComboBox.Style>
                                                                        </ComboBox>
                                                                        <TextBlock
                                                                            Grid.Column="3"
                                                                            VerticalAlignment="Center"
                                                                            Text="Rx Sensitivity:" />
                                                                        <ComboBox
                                                                            Grid.Column="4"
                                                                            ItemsSource="{Binding RxSensitivity.ChoiceDisplays}"
                                                                            SelectedIndex="{Binding RxSensitivity.SelectedChoiceIndex, Mode=TwoWay}">
                                                                            <ComboBox.Style>
                                                                                <Style TargetType="ComboBox">
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding RxSensitivity.IsReadOnly}" Value="True">
                                                                                            <Setter Property="IsEnabled" Value="False" />
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </ComboBox.Style>
                                                                        </ComboBox>
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </Border>
                                                </Expander>
                                            </DockPanel>
                                        </Border>

                                        <Border Style="{StaticResource SectionBorderStyle}" Visibility="{Binding IsGpiSettingsVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <DockPanel>
                                                <Border DockPanel.Dock="Top" Style="{StaticResource SectionHeaderStyle}">
                                                    <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="GPI CONFIGURATION" />
                                                </Border>
                                                <DataGrid
                                                    Height="185"
                                                    Margin="8"
                                                    AlternatingRowBackground="{DynamicResource MahApps.Brushes.Gray10}"
                                                    AutoGenerateColumns="False"
                                                    BorderBrush="{DynamicResource MahApps.Brushes.Gray7}"
                                                    BorderThickness="1"
                                                    CanUserAddRows="False"
                                                    GridLinesVisibility="Horizontal"
                                                    HeadersVisibility="Column"
                                                    HorizontalGridLinesBrush="{DynamicResource MahApps.Brushes.Gray8}"
                                                    IsReadOnly="False"
                                                    ItemsSource="{Binding GpiSettings}"
                                                    RowHeight="36"
                                                    ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn
                                                            Width="55"
                                                            Binding="{Binding Port}"
                                                            Header="PORT"
                                                            IsReadOnly="True">
                                                            <DataGridTextColumn.ElementStyle>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="TextAlignment" Value="Center" />
                                                                    <Setter Property="VerticalAlignment" Value="Center" />
                                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                                </Style>
                                                            </DataGridTextColumn.ElementStyle>
                                                        </DataGridTextColumn>
                                                        <DataGridCheckBoxColumn
                                                            Width="65"
                                                            Binding="{Binding StartEnabled, Mode=TwoWay}"
                                                            Header="START">
                                                            <DataGridCheckBoxColumn.ElementStyle>
                                                                <Style BasedOn="{StaticResource MahApps.Styles.CheckBox.DataGrid}" TargetType="CheckBox">
                                                                    <Setter Property="HorizontalAlignment" Value="Center" />
                                                                    <Setter Property="VerticalAlignment" Value="Center" />
                                                                </Style>
                                                            </DataGridCheckBoxColumn.ElementStyle>
                                                            <DataGridCheckBoxColumn.CellStyle>
                                                                <Style TargetType="DataGridCell">
                                                                    <Setter Property="IsEnabled" Value="False" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsStartEditable}" Value="True">
                                                                            <Setter Property="IsEnabled" Value="True" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
