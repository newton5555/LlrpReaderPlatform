<UserControl x:Class="LlrpReaderPlatform.App.Wpf.Views.ReaderSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,8,6" />
        </Style>
        <Style x:Key="FieldControlStyle" TargetType="Control">
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="MinHeight" Value="24" />
        </Style>
        <Style x:Key="SectionBorderStyle" TargetType="Border">
            <Setter Property="Margin" Value="0,0,10,10" />
            <Setter Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.Accent}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style x:Key="SectionHeaderStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.Accent}" />
            <Setter Property="Padding" Value="6,3" />
        </Style>
        <Style x:Key="SectionHeaderTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.IdealForeground}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="DiagnosticsRefreshStyle" TargetType="Control">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Diagnostics.IsBusy}" Value="True">
                    <Setter Property="IsEnabled" Value="False" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SettingsActionStyle" TargetType="Button">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                    <Setter Property="IsEnabled" Value="False" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SettingsTabControlStyle" TargetType="TabControl">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                    <Setter Property="IsEnabled" Value="False" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsReaderAvailable}" Value="False">
                    <Setter Property="IsEnabled" Value="False" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSettingsLayoutAvailable}" Value="False">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="SettingsRowTemplate">
            <Grid Margin="0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="145" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding Title}" Style="{StaticResource FieldLabelStyle}" />

                <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding ChoiceDisplays}"
                          SelectedIndex="{Binding SelectedChoiceIndex, Mode=TwoWay}">
                    <ComboBox.Style>
                        <Style TargetType="ComboBox">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsChoice}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsReadOnly}" Value="True">
                                    <Setter Property="IsEnabled" Value="False" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ComboBox.Style>
                </ComboBox>

                <CheckBox Grid.Row="0" Grid.Column="1" IsChecked="{Binding BooleanValue, Mode=TwoWay}"
                          Content="Enabled" VerticalAlignment="Center">
                    <CheckBox.Style>
                        <Style TargetType="CheckBox">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBoolean}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsReadOnly}" Value="True">
                                    <Setter Property="IsEnabled" Value="False" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </CheckBox.Style>
                </CheckBox>

                <ScrollViewer Grid.Row="0" Grid.Column="1" MaxHeight="150"
                              VerticalScrollBarVisibility="Auto">
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCollection}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsReadOnly}" Value="True">
                                    <Setter Property="IsEnabled" Value="False" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>
                    <ItemsControl ItemsSource="{Binding CollectionItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding Display}" IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="0,2" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding ValueText, UpdateSourceTrigger=PropertyChanged}"
                         VerticalAlignment="Center">
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsText}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsReadOnly}" Value="True">
                                    <Setter Property="IsEnabled" Value="False" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>

                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ReadOnlyReason}"
                           Foreground="{DynamicResource MahApps.Brushes.Gray3}"
                           VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,1,0,3" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel Margin="12">
        <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <WrapPanel Margin="0,0,0,8">
                    <TextBlock Text="Hostname:" FontWeight="SemiBold" Margin="0,0,6,0" />
                    <TextBlock Text="{Binding ReaderHost}"
                               Margin="0,0,18,0" />
                    <TextBlock Text="Interface:" FontWeight="SemiBold" Margin="0,0,6,0" />
                    <TextBlock Text="LLRP" Margin="0,0,18,0" />
                    <TextBlock Text="Model:" FontWeight="SemiBold" Margin="0,0,6,0" />
                    <TextBlock Text="{Binding ReaderModel}"
                               Margin="0,0,18,0" />
                    <TextBlock Text="LLRP:" FontWeight="SemiBold" Margin="0,0,6,0" />
                    <TextBlock Text="{Binding ReaderProtocol}"
                               Margin="0,0,18,0" />
                    <TextBlock Text="Policy:" FontWeight="SemiBold" Margin="0,0,6,0" />
                    <TextBlock Text="{Binding ReaderProtocolPolicy}"
                               Margin="0,0,18,0" />
                    <TextBlock Text="Session:" FontWeight="SemiBold" Margin="0,0,6,0" />
                    <TextBlock Text="{Binding ReaderConnection}"
                               Margin="0,0,18,0" />
                    <TextBlock Text="Extension:" FontWeight="SemiBold" Margin="0,0,6,0" />
                    <TextBlock Text="{Binding ReaderExtensions}"
                               Margin="0,0,18,0" />
                    <TextBlock Text="Region:" FontWeight="SemiBold" Margin="0,0,6,0" />
                    <TextBlock Text="{Binding ReaderRegion}" />
                </WrapPanel>
            </StackPanel>
            <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Button Content="REFRESH SETTINGS" Command="{Binding LoadCommand}"
                        CommandParameter="{Binding ReaderId}"
                        Style="{StaticResource SettingsActionStyle}"
                        Margin="4,0,0,0" />
                <Button Content="LOAD DEFAULTS" Command="{Binding LoadDefaultsCommand}"
                        Style="{StaticResource SettingsActionStyle}"
                        Margin="4,0,0,0" />
            </WrapPanel>
        </Grid>

        <ProgressBar DockPanel.Dock="Top" Height="4" Margin="0,0,0,6"
                     IsIndeterminate="True"
                     Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />

        <Grid DockPanel.Dock="Bottom" Margin="0,8,0,0" MinHeight="38">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="SAVE" Command="{Binding SaveCommand}"
                    IsEnabled="{Binding CanSave}"
                    Style="{StaticResource SettingsActionStyle}"
                    Width="180" Margin="0,0,8,0" />
            <Button Grid.Column="1" Content="CANCEL" Command="{Binding CancelCommand}"
                    Style="{StaticResource SettingsActionStyle}"
                    Width="180" Margin="0,0,12,0" />
            <TextBox Grid.Column="2" Text="{Binding Status}" VerticalAlignment="Center" TextWrapping="Wrap"
                     IsReadOnly="True" BorderThickness="0" Background="Transparent" Margin="5,0,0,0" />
        </Grid>

        <Grid>
        <TabControl Style="{StaticResource SettingsTabControlStyle}">
                <TabItem Header="Inventory">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,0,12">
                        <StackPanel>
                            <WrapPanel Margin="0,0,0,8">
                                <TextBlock Text="Preset:" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <ComboBox Text="{Binding Preset}" IsEditable="True" Width="260" Margin="0,0,16,0">
                                    <ComboBoxItem Content="Default" />
                                </ComboBox>
                                <TextBlock Text="{Binding SettingsOrigin}" VerticalAlignment="Center" />
                            </WrapPanel>
                            <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                <Border Style="{StaticResource SectionBorderStyle}"
                                        Visibility="{Binding IsManualSettingsVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <DockPanel>
                                        <Border DockPanel.Dock="Top" Style="{StaticResource SectionHeaderStyle}">
                                            <TextBlock Text="MANUAL SETTINGS" Style="{StaticResource SectionHeaderTextStyle}" />
                                        </Border>
                                        <Grid Margin="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="160" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <TextBlock Grid.Row="0" Text="Antennas:" Style="{StaticResource FieldLabelStyle}" />
                                            <DockPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,6">
                                                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                                                    <Button Content="ALL" Width="60" Margin="0,0,6,0" Command="{Binding FillAllAntennasCommand}" />
                                                    <Button Content="CLEAR" Width="70" Command="{Binding ClearAntennasCommand}" />
                                                </StackPanel>
                                                <TextBox Text="{Binding AntennasRow.ValueText, UpdateSourceTrigger=PropertyChanged}"
                                                         IsReadOnly="{Binding AntennasRow.IsReadOnly}" />
                                            </DockPanel>

                                            <TextBlock Grid.Row="1" Text="RF Mode:" Style="{StaticResource FieldLabelStyle}" />
                                            <ComboBox Grid.Row="1" Grid.Column="1"
                                                      ItemsSource="{Binding RfModeRow.ChoiceDisplays}"
                                                      SelectedIndex="{Binding RfModeRow.SelectedChoiceIndex, Mode=TwoWay}"
                                                      Text="{Binding RfModeRow.ValueText, UpdateSourceTrigger=PropertyChanged}"
                                                      IsEditable="True"
                                                      IsEnabled="{Binding IsRfModeEditable}"
                                                      Margin="0,0,0,6" />

                                            <TextBlock Grid.Row="2" Text="Search Mode:" Style="{StaticResource FieldLabelStyle}"
                                                       Visibility="{Binding IsSearchModeVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            <ComboBox Grid.Row="2" Grid.Column="1"
                                                      ItemsSource="{Binding SearchModeRow.ChoiceDisplays}"
                                                      SelectedIndex="{Binding SearchModeRow.SelectedChoiceIndex, Mode=TwoWay}"
                                                      IsEnabled="{Binding IsSearchModeEditable}"
                                                      Margin="0,0,0,6"
                                                      Visibility="{Binding IsSearchModeVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />

                                            <TextBlock Grid.Row="3" Text="Enable Fast ID:" Style="{StaticResource FieldLabelStyle}"
                                                       Visibility="{Binding IsFastIdVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            <CheckBox Grid.Row="3" Grid.Column="1" IsChecked="{Binding FastIdRow.BooleanValue, Mode=TwoWay}"
                                                      IsEnabled="{Binding IsFastIdEditable}" Margin="0,0,0,6"
                                                      Visibility="{Binding IsFastIdVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />

                                            <TextBlock Grid.Row="4" Text="Estimated Tag Population:" Style="{StaticResource FieldLabelStyle}" />
                                            <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding PopulationRow.ValueText, UpdateSourceTrigger=PropertyChanged}"
                                                     IsEnabled="{Binding IsPopulationEditable}" Margin="0,0,0,6" />

                                            <TextBlock Grid.Row="5" Text="Report Every N Tags:" Style="{StaticResource FieldLabelStyle}" />
                                            <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding ReportEveryRow.ValueText, UpdateSourceTrigger=PropertyChanged}"
                                                     IsEnabled="{Binding IsReportEveryEditable}" Margin="0,0,0,6" />

                                            <TextBlock Grid.Row="6" Text="Session:" Style="{StaticResource FieldLabelStyle}" />
                                            <ComboBox Grid.Row="6" Grid.Column="1"
                                                      ItemsSource="{Binding SessionRow.ChoiceDisplays}"
                                                      SelectedIndex="{Binding SessionRow.SelectedChoiceIndex, Mode=TwoWay}"
                                                      IsEnabled="{Binding IsSessionEditable}"
                                                      Margin="0,0,0,6" />

                                            <TextBlock Grid.Row="7" Text="Tari:" Style="{StaticResource FieldLabelStyle}" />
                                            <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding TariRow.ValueText, UpdateSourceTrigger=PropertyChanged}"
                                                     IsEnabled="{Binding IsTariEditable}" Margin="0,0,0,6" />

                                            <TextBlock Grid.Row="8" Text="Report Phase Angle:" Style="{StaticResource FieldLabelStyle}"
                                                       Visibility="{Binding IsPhaseAngleVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            <CheckBox Grid.Row="8" Grid.Column="1" IsChecked="{Binding PhaseAngleRow.BooleanValue, Mode=TwoWay}"
                                                      IsEnabled="{Binding IsPhaseAngleEditable}" Margin="0,0,0,6"
                                                      Visibility="{Binding IsPhaseAngleVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />

                                            <TextBlock Grid.Row="9" Text="Report Doppler Frequency:" Style="{StaticResource FieldLabelStyle}"
                                                       Visibility="{Binding IsDopplerVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            <CheckBox Grid.Row="9" Grid.Column="1" IsChecked="{Binding DopplerRow.BooleanValue, Mode=TwoWay}"
                                                      IsEnabled="{Binding IsDopplerEditable}"
                                                      Visibility="{Binding IsDopplerVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        </Grid>
                                    </DockPanel>
                                </Border>

                                <Border Style="{StaticResource SectionBorderStyle}"
                                        Visibility="{Binding IsPowerSettingsVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <DockPanel>
                                        <Border DockPanel.Dock="Top" Style="{StaticResource SectionHeaderStyle}">
                                            <TextBlock Text="POWER AND SENSITIVITY SETTINGS" Style="{StaticResource SectionHeaderTextStyle}" />
                                        </Border>
                                        <Grid DockPanel.Dock="Top" Margin="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="160" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Column="0" Text="Tx Power Index:" Style="{StaticResource FieldLabelStyle}" />
                                            <ComboBox Grid.Column="1" ItemsSource="{Binding TxPowerRow.ChoiceDisplays}"
                                                      SelectedIndex="{Binding TxPowerRow.SelectedChoiceIndex, Mode=TwoWay}"
                                                      Text="{Binding TxPowerRow.ValueText, UpdateSourceTrigger=PropertyChanged}"
                                                      IsEditable="True" IsEnabled="{Binding IsTxPowerEditable}"
                                                      Style="{StaticResource FieldControlStyle}" />
                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Rx Sensitivity Index:" Style="{StaticResource FieldLabelStyle}" />
                                            <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding RxSensitivityRow.ChoiceDisplays}"
                                                      SelectedIndex="{Binding RxSensitivityRow.SelectedChoiceIndex, Mode=TwoWay}"
                                                      Text="{Binding RxSensitivityRow.ValueText, UpdateSourceTrigger=PropertyChanged}"
                                                      IsEditable="True" IsEnabled="{Binding IsRxSensitivityEditable}"
                                                      Style="{StaticResource FieldControlStyle}" />
                                        </Grid>
                                        <Expander DockPanel.Dock="Top"
                                                  IsExpanded="{Binding IsIndividualAntennaSettingsExpanded, Mode=TwoWay}"
                                                  Margin="8,0,8,8">
                                            <Expander.Header>
                                                <Border Style="{StaticResource SectionHeaderStyle}" MinWidth="280">
                                                    <TextBlock Text="INDIVIDUAL ANTENNAS" Style="{StaticResource SectionHeaderTextStyle}" />
                                                </Border>
                                            </Expander.Header>
                                            <Border BorderBrush="{DynamicResource MahApps.Brushes.Accent}" BorderThickness="1">
                                                <ItemsControl ItemsSource="{Binding AntennaSettings}" Margin="8">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,4">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="140" />
                                                                    <ColumnDefinition Width="110" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="120" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                                <TextBlock Grid.Column="1" Text="Tx Power Index:" VerticalAlignment="Center" />
                                                                <ComboBox Grid.Column="2" ItemsSource="{Binding TxPower.ChoiceDisplays}"
                                                                          SelectedIndex="{Binding TxPower.SelectedChoiceIndex, Mode=TwoWay}"
                                                                          Text="{Binding TxPower.ValueText, UpdateSourceTrigger=PropertyChanged}"
                                                                          IsEditable="True" Margin="0,0,12,0">
                                                                    <ComboBox.Style>
                                                                        <Style TargetType="ComboBox">
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding TxPower.IsReadOnly}" Value="True">
                                                                                    <Setter Property="IsEnabled" Value="False" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </ComboBox.Style>
                                                                </ComboBox>
                                                                <TextBlock Grid.Column="3" Text="Rx Sensitivity Index:" VerticalAlignment="Center" />
                                                                <ComboBox Grid.Column="4" ItemsSource="{Binding RxSensitivity.ChoiceDisplays}"
                                                                          SelectedIndex="{Binding RxSensitivity.SelectedChoiceIndex, Mode=TwoWay}"
                                                                          Text="{Binding RxSensitivity.ValueText, UpdateSourceTrigger=PropertyChanged}"
                                                                          IsEditable="True">
                                                                    <ComboBox.Style>
                                                                        <Style TargetType="ComboBox">
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding RxSensitivity.IsReadOnly}" Value="True">
                                                                                    <Setter Property="IsEnabled" Value="False" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </ComboBox.Style>
                                                                </ComboBox>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Border>
                                        </Expander>
                                    </DockPanel>
                                </Border>

                                <Border Style="{StaticResource SectionBorderStyle}"
                                        Visibility="{Binding IsGpiSettingsVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <DockPanel>
                                        <Border DockPanel.Dock="Top" Style="{StaticResource SectionHeaderStyle}">
                                            <TextBlock Text="GPI CONFIGURATION" Style="{StaticResource SectionHeaderTextStyle}" />
                                        </Border>
                                         <DataGrid ItemsSource="{Binding GpiSettings}"
                                                   AutoGenerateColumns="False"
                                                   CanUserAddRows="False"
                                                   HeadersVisibility="Column"
                                                   Margin="8"
                                                   Height="160"
                                                   BorderBrush="{DynamicResource MahApps.Brushes.Gray7}"
                                                   RowHeight="32"
                                                   GridLinesVisibility="Horizontal"
                                                   HorizontalGridLinesBrush="{DynamicResource MahApps.Brushes.Gray8}"
                                                   AlternatingRowBackground="{DynamicResource MahApps.Brushes.Gray10}"
                                                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                   BorderThickness="1"
                                                   IsReadOnly="False">
                                             <DataGrid.Columns>
                                                 <DataGridTextColumn Header="PORT" Binding="{Binding Port}" IsReadOnly="True" Width="60">
                                                     <DataGridTextColumn.ElementStyle>
                                                         <Style TargetType="TextBlock">
                                                             <Setter Property="TextAlignment" Value="Center" />
                                                             <Setter Property="VerticalAlignment" Value="Center" />
                                                             <Setter Property="FontWeight" Value="SemiBold" />
                                                         </Style>
                                                     </DataGridTextColumn.ElementStyle>
                                                 </DataGridTextColumn>
                                                 <DataGridCheckBoxColumn Header="START" Binding="{Binding StartEnabled, Mode=TwoWay}" Width="65">
                                                     <DataGridCheckBoxColumn.ElementStyle>
                                                         <Style TargetType="CheckBox" BasedOn="{StaticResource MahApps.Styles.CheckBox.DataGrid}">
                                                             <Setter Property="HorizontalAlignment" Value="Center" />
                                                             <Setter Property="VerticalAlignment" Value="Center" />
                                                         </Style>
                                                     </DataGridCheckBoxColumn.ElementStyle>
                                                     <DataGridCheckBoxColumn.CellStyle>
                                                         <Style TargetType="DataGridCell">
                                                            <Setter Property="IsEnabled" Value="False" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsStartEditable}" Value="True">
                                                                    <Setter Property="IsEnabled" Value="True" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </DataGridCheckBoxColumn.CellStyle>
                                                 </DataGridCheckBoxColumn>
                                                 <DataGridTextColumn Header="LEVEL" Binding="{Binding StartLevel, Mode=TwoWay}" Width="65">
                                                     <DataGridTextColumn.ElementStyle>
                                                         <Style TargetType="TextBlock">
                                                             <Setter Property="TextAlignment" Value="Center" />
                                                             <Setter Property="VerticalAlignment" Value="Center" />
                                                         </Style>
                                                     </DataGridTextColumn.ElementStyle>
                                                     <DataGridTextColumn.CellStyle>
                                                        <Style TargetType="DataGridCell">
                                                            <Setter Property="IsEnabled" Value="False" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsStartLevelEditable}" Value="True">
                                                                    <Setter Property="IsEnabled" Value="True" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </DataGridTextColumn.CellStyle>
                                                 </DataGridTextColumn>
                                                 <DataGridCheckBoxColumn Header="STOP" Binding="{Binding StopEnabled, Mode=TwoWay}" Width="65">
                                                     <DataGridCheckBoxColumn.ElementStyle>
                                                         <Style TargetType="CheckBox" BasedOn="{StaticResource MahApps.Styles.CheckBox.DataGrid}">
                                                             <Setter Property="HorizontalAlignment" Value="Center" />
                                                             <Setter Property="VerticalAlignment" Value="Center" />
                                                         </Style>
                                                     </DataGridCheckBoxColumn.ElementStyle>
                                                     <DataGridCheckBoxColumn.CellStyle>
                                                        <Style TargetType="DataGridCell">
                                                            <Setter Property="IsEnabled" Value="False" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsStopEditable}" Value="True">
                                                                    <Setter Property="IsEnabled" Value="True" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </DataGridCheckBoxColumn.CellStyle>
                                                 </DataGridCheckBoxColumn>
                                                 <DataGridTextColumn Header="LEVEL" Binding="{Binding StopLevel, Mode=TwoWay}" Width="65">
                                                     <DataGridTextColumn.ElementStyle>
                                                         <Style TargetType="TextBlock">
                                                             <Setter Property="TextAlignment" Value="Center" />
                                                             <Setter Property="VerticalAlignment" Value="Center" />
                                                         </Style>
                                                     </DataGridTextColumn.ElementStyle>
                                                     <DataGridTextColumn.CellStyle>
                                                        <Style TargetType="DataGridCell">
                                                            <Setter Property="IsEnabled" Value="False" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsStopLevelEditable}" Value="True">
                                                                    <Setter Property="IsEnabled" Value="True" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </DataGridTextColumn.CellStyle>
                                                </DataGridTextColumn>
                                                <DataGridTemplateColumn Header="DEBOUNCE (ms)" Width="*">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                         <DataTemplate>
                                                             <TextBox Text="{Binding DebounceMs, UpdateSourceTrigger=PropertyChanged}"
                                                                      IsEnabled="{Binding IsDebounceEnabled}"
                                                                      VerticalAlignment="Center"
                                                                      Margin="2"
                                                                      HorizontalContentAlignment="Center" />
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                        <Grid Margin="12,0,12,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="145" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Stop timeout (ms):" Style="{StaticResource FieldLabelStyle}" />
                                            <TextBox Grid.Column="1" Text="{Binding StopTimeoutRow.ValueText, UpdateSourceTrigger=PropertyChanged}">
                                                <TextBox.Style>
                                                    <Style TargetType="TextBox">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding StopTimeoutRow.IsReadOnly}" Value="True">
                                                                <Setter Property="IsEnabled" Value="False" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBox.Style>
                                            </TextBox>
                                        </Grid>
                                    </DockPanel>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                <Border Style="{StaticResource SectionBorderStyle}"
                                        Visibility="{Binding IsFilterSettingsVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <DockPanel>
                                        <Border DockPanel.Dock="Top" Style="{StaticResource SectionHeaderStyle}">
                                            <TextBlock Text="GEN 2 FILTERING" Style="{StaticResource SectionHeaderTextStyle}" />
                                        </Border>
                                        <Grid Margin="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <CheckBox Grid.Row="0" Grid.Column="1" IsChecked="{Binding Filter1.Enabled.BooleanValue, Mode=TwoWay}"
                                                      IsEnabled="{Binding Filter1.Enabled.IsEditable}"
                                                      Content="Filter 1" HorizontalAlignment="Center" Margin="0,0,0,6" />
                                            <CheckBox Grid.Row="0" Grid.Column="2" IsChecked="{Binding Filter2.Enabled.BooleanValue, Mode=TwoWay}"
                                                      IsEnabled="{Binding Filter2.Enabled.IsEditable}"
                                                      Content="Filter 2" HorizontalAlignment="Center" Margin="0,0,0,6" />

                                            <TextBlock Grid.Row="1" Text="Filter:" Style="{StaticResource FieldLabelStyle}" />
                                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Filter1.Mask.ValueText, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Filter1.Mask.IsEditable}" Margin="0,0,6,6" />
                                            <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding Filter2.Mask.ValueText, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Filter2.Mask.IsEditable}" Margin="6,0,0,6" />

                                            <TextBlock Grid.Row="2" Text="Bit Length:" Style="{StaticResource FieldLabelStyle}" />
                                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Filter1.BitLength.ValueText, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Filter1.BitLength.IsEditable}" Margin="0,0,6,6" />
                                            <TextBox Grid.Row="2" Grid.Column="2" Text="{Binding Filter2.BitLength.ValueText, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Filter2.BitLength.IsEditable}" Margin="6,0,0,6" />

                                            <TextBlock Grid.Row="3" Text="Offset:" Style="{StaticResource FieldLabelStyle}" />
                                            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Filter1.Offset.ValueText, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Filter1.Offset.IsEditable}" Margin="0,0,6,6" />
                                            <TextBox Grid.Row="3" Grid.Column="2" Text="{Binding Filter2.Offset.ValueText, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Filter2.Offset.IsEditable}" Margin="6,0,0,6" />

                                            <TextBlock Grid.Row="4" Text="Memory Bank:" Style="{StaticResource FieldLabelStyle}" />
                                            <ComboBox Grid.Row="4" Grid.Column="1" ItemsSource="{Binding Filter1.MemoryBank.ChoiceDisplays}"
                                                      SelectedIndex="{Binding Filter1.MemoryBank.SelectedChoiceIndex, Mode=TwoWay}"
                                                      IsEnabled="{Binding Filter1.MemoryBank.IsEditable}" Margin="0,0,6,6" />
                                            <ComboBox Grid.Row="4" Grid.Column="2" ItemsSource="{Binding Filter2.MemoryBank.ChoiceDisplays}"
                                                      SelectedIndex="{Binding Filter2.MemoryBank.SelectedChoiceIndex, Mode=TwoWay}"
                                                      IsEnabled="{Binding Filter2.MemoryBank.IsEditable}" Margin="6,0,0,6" />

                                            <TextBlock Grid.Row="5" Text="State-Aware:" Visibility="{Binding IsStateAwareFiltersSupported, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                       Style="{StaticResource FieldLabelStyle}" />
                                            <CheckBox Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" IsChecked="{Binding StateAwareFiltersRow.BooleanValue, Mode=TwoWay}"
                                                      IsEnabled="{Binding IsStateAwareFiltersSupported}" VerticalAlignment="Center"
                                                      Visibility="{Binding IsStateAwareFiltersSupported, Converter={StaticResource BooleanToVisibilityConverter}}" />

                                            <TextBlock Grid.Row="6" Text="Target:" Style="{StaticResource FieldLabelStyle}"
                                                       Visibility="{Binding ShowStateAwareFilterOptions, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            <ComboBox Grid.Row="6" Grid.Column="1" ItemsSource="{Binding Filter1.StateTarget.ChoiceDisplays}"
                                                      SelectedIndex="{Binding Filter1.StateTarget.SelectedChoiceIndex, Mode=TwoWay}" Margin="0,0,6,6"
                                                      IsEnabled="{Binding Filter1.StateTarget.IsEditable}"
                                                      Visibility="{Binding ShowStateAwareFilterOptions, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            <ComboBox Grid.Row="6" Grid.Column="2" ItemsSource="{Binding Filter2.StateTarget.ChoiceDisplays}"
                                                      SelectedIndex="{Binding Filter2.StateTarget.SelectedChoiceIndex, Mode=TwoWay}" Margin="6,0,0,6"
                                                      IsEnabled="{Binding Filter2.StateTarget.IsEditable}"
                                                      Visibility="{Binding ShowStateAwareFilterOptions, Converter={StaticResource BooleanToVisibilityConverter}}" />

                                            <TextBlock Grid.Row="7" Text="Action:" Style="{StaticResource FieldLabelStyle}"
                                                       Visibility="{Binding ShowStateAwareFilterOptions, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            <ComboBox Grid.Row="7" Grid.Column="1" ItemsSource="{Binding Filter1.StateAction.ChoiceDisplays}"
                                                      SelectedIndex="{Binding Filter1.StateAction.SelectedChoiceIndex, Mode=TwoWay}" Margin="0,0,6,6"
                                                      IsEnabled="{Binding Filter1.StateAction.IsEditable}"
                                                      Visibility="{Binding ShowStateAwareFilterOptions, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            <ComboBox Grid.Row="7" Grid.Column="2" ItemsSource="{Binding Filter2.StateAction.ChoiceDisplays}"
                                                      SelectedIndex="{Binding Filter2.StateAction.SelectedChoiceIndex, Mode=TwoWay}" Margin="6,0,0,6"
                                                      IsEnabled="{Binding Filter2.StateAction.IsEditable}"
                                                      Visibility="{Binding ShowStateAwareFilterOptions, Converter={StaticResource BooleanToVisibilityConverter}}" />

                                            <TextBlock Grid.Row="8" Text="Match Action:" Style="{StaticResource FieldLabelStyle}"
                                                       Visibility="{Binding ShowNonStateAwareFilterOptions, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            <ComboBox Grid.Row="8" Grid.Column="1" ItemsSource="{Binding Filter1.MatchAction.ChoiceDisplays}"
                                                      SelectedIndex="{Binding Filter1.MatchAction.SelectedChoiceIndex, Mode=TwoWay}" Margin="0,0,6,6"
                                                      IsEnabled="{Binding Filter1.MatchAction.IsEditable}"
                                                      Visibility="{Binding ShowNonStateAwareFilterOptions, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            <ComboBox Grid.Row="8" Grid.Column="2" ItemsSource="{Binding Filter2.MatchAction.ChoiceDisplays}"
                                                      SelectedIndex="{Binding Filter2.MatchAction.SelectedChoiceIndex, Mode=TwoWay}" Margin="6,0,0,6"
                                                      IsEnabled="{Binding Filter2.MatchAction.IsEditable}"
                                                      Visibility="{Binding ShowNonStateAwareFilterOptions, Converter={StaticResource BooleanToVisibilityConverter}}" />

                                            <TextBlock Grid.Row="9" Text="Non-Match Action:" Style="{StaticResource FieldLabelStyle}"
                                                       Visibility="{Binding ShowNonStateAwareFilterOptions, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            <ComboBox Grid.Row="9" Grid.Column="1" ItemsSource="{Binding Filter1.NonMatchAction.ChoiceDisplays}"
                                                      SelectedIndex="{Binding Filter1.NonMatchAction.SelectedChoiceIndex, Mode=TwoWay}" Margin="0,0,6,6"
                                                      IsEnabled="{Binding Filter1.NonMatchAction.IsEditable}"
                                                      Visibility="{Binding ShowNonStateAwareFilterOptions, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            <ComboBox Grid.Row="9" Grid.Column="2" ItemsSource="{Binding Filter2.NonMatchAction.ChoiceDisplays}"
                                                      SelectedIndex="{Binding Filter2.NonMatchAction.SelectedChoiceIndex, Mode=TwoWay}" Margin="6,0,0,6"
                                                      IsEnabled="{Binding Filter2.NonMatchAction.IsEditable}"
                                                      Visibility="{Binding ShowNonStateAwareFilterOptions, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        </Grid>
                                    </DockPanel>
                                </Border>

                                <Border Style="{StaticResource SectionBorderStyle}"
                                        Visibility="{Binding IsStateAwareSettingsVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <DockPanel>
                                        <Border DockPanel.Dock="Top" Style="{StaticResource SectionHeaderStyle}">
                                            <TextBlock Text="STATE-AWARE SINGULATION" Style="{StaticResource SectionHeaderTextStyle}" />
                                        </Border>
                                        <ItemsControl ItemsSource="{Binding StateAwareRows}" ItemTemplate="{StaticResource SettingsRowTemplate}" Margin="12" />
                                    </DockPanel>
                                </Border>

                                <Border Style="{StaticResource SectionBorderStyle}"
                                        Visibility="{Binding IsFrequencySettingsVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <DockPanel>
                                        <Border DockPanel.Dock="Top" Style="{StaticResource SectionHeaderStyle}">
                                            <TextBlock Text="FREQUENCY SETTINGS" Style="{StaticResource SectionHeaderTextStyle}" />
                                        </Border>
                                        <Grid Margin="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="180" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Column="0" Text="Use Specified Frequencies:" Style="{StaticResource FieldLabelStyle}" />
                                            <ComboBox Grid.Column="1" ItemsSource="{Binding FrequencyModeRow.ChoiceDisplays}"
                                                      SelectedIndex="{Binding FrequencyModeRow.SelectedChoiceIndex, Mode=TwoWay}"
                                                      IsEnabled="{Binding IsFrequencyModeEditable}" Margin="0,0,0,6" />
                                            <TextBlock Grid.Row="1" Text="Channels:" Style="{StaticResource FieldLabelStyle}"
                                                       Visibility="{Binding IsFrequencyChannelsVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            <ScrollViewer Grid.Row="1" Grid.Column="1" MaxHeight="150"
                                                          VerticalScrollBarVisibility="Auto"
                                                          HorizontalScrollBarVisibility="Disabled"
                                                          IsEnabled="{Binding IsFrequencyChannelsEditable}"
                                                          Visibility="{Binding IsFrequencyChannelsVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <ItemsControl ItemsSource="{Binding FrequencyChannelsRow.CollectionItems}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Content="{Binding Display}" Margin="0,2" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </Grid>
                                    </DockPanel>
                                </Border>

                                <Border Style="{StaticResource SectionBorderStyle}"
                                        Visibility="{Binding IsLowDutySettingsVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <DockPanel>
                                        <Border DockPanel.Dock="Top" Style="{StaticResource SectionHeaderStyle}">
                                            <TextBlock Text="LOW DUTY CYCLE" Style="{StaticResource SectionHeaderTextStyle}" />
                                        </Border>
                                        <Grid Margin="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="180" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <CheckBox Grid.Row="0" Grid.ColumnSpan="2" Content="Enable"
                                                      IsChecked="{Binding LowDutyEnabledRow.BooleanValue, Mode=TwoWay}"
                                                      IsEnabled="{Binding IsLowDutyEditable}" Margin="0,0,0,8" />
                                            <TextBlock Grid.Row="1" Text="Empty Field Timeout (ms):" Style="{StaticResource FieldLabelStyle}" />
                                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding EmptyFieldTimeoutRow.ValueText, UpdateSourceTrigger=PropertyChanged}"
                                                     IsEnabled="{Binding IsEmptyFieldTimeoutEditable}" Margin="0,0,0,6" />
                                            <TextBlock Grid.Row="2" Text="Field Ping Interval (ms):" Style="{StaticResource FieldLabelStyle}" />
                                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding FieldPingIntervalRow.ValueText, UpdateSourceTrigger=PropertyChanged}"
                                                     IsEnabled="{Binding IsFieldPingIntervalEditable}" />
                                        </Grid>
                                    </DockPanel>
                                </Border>

                                <Border Style="{StaticResource SectionBorderStyle}"
                                        Visibility="{Binding IsReportSettingsVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <DockPanel>
                                        <Border DockPanel.Dock="Top" Style="{StaticResource SectionHeaderStyle}">
                                            <TextBlock Text="REPORT SETTINGS" Style="{StaticResource SectionHeaderTextStyle}" />
                                        </Border>
                                        <ItemsControl ItemsSource="{Binding ReportRows}" ItemTemplate="{StaticResource SettingsRowTemplate}" Margin="12" />
                                    </DockPanel>
                                </Border>

                                <Border Style="{StaticResource SectionBorderStyle}"
                                        Visibility="{Binding IsOtherSettingsVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <DockPanel>
                                        <Border DockPanel.Dock="Top" Style="{StaticResource SectionHeaderStyle}">
                                            <TextBlock Text="OTHER SETTINGS" Style="{StaticResource SectionHeaderTextStyle}" />
                                        </Border>
                                        <ItemsControl ItemsSource="{Binding OtherRows}" ItemTemplate="{StaticResource SettingsRowTemplate}" Margin="12" />
                                    </DockPanel>
                                </Border>
                            </StackPanel>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Diagnostics">
                    <Border Style="{StaticResource SectionBorderStyle}"
                            Margin="0,12,0,0"
                            Width="520"
                            MaxWidth="520"
                            Visibility="{Binding Diagnostics.IsGpioRefreshAvailable, Converter={StaticResource BooleanToVisibilityConverter}}"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Style="{StaticResource SectionHeaderStyle}">
                                <TextBlock Text="GPO CONTROL" Style="{StaticResource SectionHeaderTextStyle}" />
                            </Border>
                            <ProgressBar DockPanel.Dock="Top"
                                         Height="4"
                                         Margin="12,6,12,0"
                                         IsIndeterminate="True"
                                         Visibility="{Binding Diagnostics.IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <UniformGrid Columns="2" Rows="2" Margin="12,10,12,4"
                                         Visibility="{Binding Diagnostics.IsGpoControlVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel Orientation="Horizontal" Margin="4,0,20,10" VerticalAlignment="Center"
                                            Visibility="{Binding Diagnostics.IsGpo1Available, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <mah:ToggleSwitch IsOn="{Binding Diagnostics.Gpo1, Mode=TwoWay}"
                                                      IsEnabled="{Binding Diagnostics.IsGpo1Available}"
                                                      OnContent="" OffContent="" MinWidth="44" VerticalAlignment="Center" />
                                    <TextBlock Text="GPO 1" VerticalAlignment="Center" Margin="10,0,0,0" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="4,0,4,10" VerticalAlignment="Center"
                                            Visibility="{Binding Diagnostics.IsGpo2Available, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <mah:ToggleSwitch IsOn="{Binding Diagnostics.Gpo2, Mode=TwoWay}"
                                                      IsEnabled="{Binding Diagnostics.IsGpo2Available}"
                                                      OnContent="" OffContent="" MinWidth="44" VerticalAlignment="Center" />
                                    <TextBlock Text="GPO 2" VerticalAlignment="Center" Margin="10,0,0,0" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="4,0,20,10" VerticalAlignment="Center"
                                            Visibility="{Binding Diagnostics.IsGpo3Available, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <mah:ToggleSwitch IsOn="{Binding Diagnostics.Gpo3, Mode=TwoWay}"
                                                      IsEnabled="{Binding Diagnostics.IsGpo3Available}"
                                                      OnContent="" OffContent="" MinWidth="44" VerticalAlignment="Center" />
                                    <TextBlock Text="GPO 3" VerticalAlignment="Center" Margin="10,0,0,0" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="4,0,4,10" VerticalAlignment="Center"
                                            Visibility="{Binding Diagnostics.IsGpo4Available, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <mah:ToggleSwitch IsOn="{Binding Diagnostics.Gpo4, Mode=TwoWay}"
                                                      IsEnabled="{Binding Diagnostics.IsGpo4Available}"
                                                      OnContent="" OffContent="" MinWidth="44" VerticalAlignment="Center" />
                                    <TextBlock Text="GPO 4" VerticalAlignment="Center" Margin="10,0,0,0" />
                                </StackPanel>
                            </UniformGrid>
                            <Border Margin="12,4,12,12"
                                    Padding="8"
                                    BorderBrush="{DynamicResource MahApps.Brushes.Gray7}"
                                    BorderThickness="1"
                                    Visibility="{Binding Diagnostics.IsGpioRefreshAvailable, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Top"
                                                Orientation="Horizontal"
                                                Margin="0,0,0,6">
                                        <TextBlock Text="GPI STATUS"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   Visibility="{Binding Diagnostics.IsGpiStatusAvailable, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                         <Button Content="REFRESH GPI/GPO"
                                                 Command="{Binding Diagnostics.RefreshGpioCommand}"
                                                 CommandParameter="{Binding DataContext.ReaderId, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                 Style="{StaticResource DiagnosticsRefreshStyle}"
                                                 Visibility="{Binding Diagnostics.IsGpioRefreshAvailable, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                 Margin="12,0,0,0"
                                                 Padding="10,3" />
                                    </StackPanel>
                                    <Grid DockPanel.Dock="Top" Margin="0,0,0,2"
                                          Visibility="{Binding Diagnostics.IsGpiStatusAvailable, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="PORT" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="1" Text="CONFIGURED" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="2" Text="STATE" FontWeight="SemiBold" />
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding Diagnostics.Gpis}"
                                                  Visibility="{Binding Diagnostics.IsGpiStatusAvailable, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,3">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="70" />
                                                        <ColumnDefinition Width="110" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding PortNumber}"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding Configured}"
                                                               VerticalAlignment="Center" />
                                                    <CheckBox Grid.Column="2"
                                                              IsChecked="{Binding State}"
                                                              IsEnabled="False"
                                                              Content="High"
                                                              VerticalAlignment="Center" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </DockPanel>
                            </Border>
                            <TextBlock Text="{Binding Diagnostics.Status}" TextWrapping="Wrap"
                                       Foreground="{DynamicResource MahApps.Brushes.Gray3}"
                                       Margin="16,0,16,12" />
                        </DockPanel>
                    </Border>
                </TabItem>
            </TabControl>

            <Border BorderBrush="{DynamicResource MahApps.Brushes.Accent}"
                    BorderThickness="1"
                    Padding="24"
                    Margin="0,18,0,0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSettingsLayoutAvailable}" Value="False">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="Reader settings are not ready"
                               FontSize="18"
                               FontWeight="SemiBold" />
                    <TextBlock Text="Connect and refresh the Reader to obtain its capabilities before editing Tab1 or Tab2 settings."
                               TextWrapping="Wrap"
                               Margin="0,8,0,0" />
                    <TextBlock Text="{Binding Status}"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource MahApps.Brushes.Gray3}"
                               Margin="0,10,0,0" />
                </StackPanel>
            </Border>
        </Grid>

    </DockPanel>
</UserControl>
