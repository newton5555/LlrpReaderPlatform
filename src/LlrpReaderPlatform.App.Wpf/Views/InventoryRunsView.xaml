<UserControl x:Class="LlrpReaderPlatform.App.Wpf.Views.InventoryRunsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp">
    <UserControl.Resources>
        <Style x:Key="InventoryRunsActionStyle" TargetType="Button"
               BasedOn="{StaticResource FlatActionButtonStyle}">
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="mah:ControlsHelper.CornerRadius" Value="4" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                    <Setter Property="IsEnabled" Value="False" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Inventory Runs" FontSize="28" FontWeight="SemiBold"
                           Foreground="{DynamicResource MahApps.Brushes.Accent}" />
                <TextBlock Text="{Binding ReaderName, StringFormat='Historical inventory run logs for {0}'}"
                           FontSize="13" Foreground="{DynamicResource MahApps.Brushes.Gray3}" Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Command="{Binding LoadCommand}"
                        Style="{StaticResource InventoryRunsActionStyle}"
                        Height="32" Padding="14,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <fa:IconBlock Icon="ArrowsRotate" IconFont="Solid" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="REFRESH RUNS" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource SummaryCardStyle}" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="RUNS" FontSize="10" FontWeight="Bold"
                               Foreground="{DynamicResource MahApps.Brushes.Gray3}" />
                    <TextBlock Text="{Binding RunCount}" FontSize="24" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource SummaryCardStyle}" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="LATEST READS" FontSize="10" FontWeight="Bold"
                               Foreground="{DynamicResource MahApps.Brushes.Gray3}" />
                    <TextBlock Text="{Binding LatestReadCount}" FontSize="24" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource SummaryCardStyle}" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="LATEST UNIQUE" FontSize="10" FontWeight="Bold"
                               Foreground="{DynamicResource MahApps.Brushes.Gray3}" />
                    <TextBlock Text="{Binding LatestUniqueTagCount}" FontSize="24" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
            <Border Grid.Column="3" Style="{StaticResource SummaryCardStyle}" Margin="0">
                <StackPanel>
                    <TextBlock Text="LATEST RESULT" FontSize="10" FontWeight="Bold"
                               Foreground="{DynamicResource MahApps.Brushes.Gray3}" />
                    <TextBlock Text="{Binding LatestStopReason}" FontSize="17" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" BorderThickness="1"
                BorderBrush="{DynamicResource MahApps.Brushes.Gray7}" CornerRadius="4"
                Background="{DynamicResource MahApps.Brushes.ThemeBackground}">
            <DataGrid ItemsSource="{Binding Runs}" SelectedItem="{Binding SelectedRun}"
                      AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                      GridLinesVisibility="Horizontal" RowHeight="38" FontSize="12" Margin="8" BorderThickness="1"
                      HorizontalGridLinesBrush="{DynamicResource MahApps.Brushes.Gray8}"
                      EnableRowVirtualization="True" EnableColumnVirtualization="True"
                      ScrollViewer.CanContentScroll="True"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling">
                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="FontWeight" Value="Bold" />
                        <Setter Property="Padding" Value="10,8" />
                        <Setter Property="BorderThickness" Value="0,0,1,1" />
                    </Style>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Padding" Value="8,4" />
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                    </Style>
                </DataGrid.Resources>
                <DataGrid.RowStyle>
                    <Style TargetType="{x:Type DataGridRow}" BasedOn="{StaticResource MahApps.Styles.DataGridRow}">
                        <Setter Property="mah:DataGridHelper.CellPadding" Value="8,4" />
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Started (local)" Binding="{Binding StartedLocal, Mode=OneWay}" Width="1.35*"
                                        ElementStyle="{StaticResource CenteredCellTextStyle}" />
                    <DataGridTextColumn Header="Ended (local)" Binding="{Binding EndedLocal, Mode=OneWay}" Width="1.35*"
                                        ElementStyle="{StaticResource CenteredCellTextStyle}" />
                    <DataGridTextColumn Header="Duration" Binding="{Binding Duration, Mode=OneWay}" Width="100"
                                        ElementStyle="{StaticResource CenteredCellTextStyle}" />
                    <DataGridTextColumn Header="Result" Binding="{Binding StopReasonDisplay, Mode=OneWay}" Width="1.1*"
                                        ElementStyle="{StaticResource CenteredCellTextStyle}" />
                    <DataGridTextColumn Header="Reads" Binding="{Binding TotalReadCount, Mode=OneWay}" Width="90"
                                        ElementStyle="{StaticResource CenteredCellTextStyle}" />
                    <DataGridTextColumn Header="Unique" Binding="{Binding UniqueTagCount, Mode=OneWay}" Width="90"
                                        ElementStyle="{StaticResource CenteredCellTextStyle}" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="1.25*" />
                <ColumnDefinition Width="1.25*" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <ProgressBar Height="4" IsIndeterminate="True"
                             Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <TextBlock Text="{Binding Status}" Margin="0,7,12,0" TextWrapping="Wrap"
                           Foreground="{DynamicResource MahApps.Brushes.Gray3}" />
            </StackPanel>
            <Border Grid.Column="1" Padding="10,7" BorderThickness="1"
                    Margin="0,0,10,0" CornerRadius="4"
                    Background="{DynamicResource MahApps.Brushes.ThemeBackground}"
                    BorderBrush="{DynamicResource MahApps.Brushes.Gray7}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="SNAPSHOT" FontSize="10" FontWeight="Bold"
                               Foreground="{DynamicResource MahApps.Brushes.Gray3}"
                               VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock Grid.Column="1" Text="{Binding SelectedRun.SnapshotFilePath, TargetNullValue=No run selected}"
                               FontFamily="Consolas, Courier New" FontSize="11"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedRun.SnapshotFilePath}" />
                    <Button Grid.Column="2" Style="{StaticResource FlatMiniButtonStyle}"
                            Command="{Binding LocateFileCommand}"
                            CommandParameter="{Binding SelectedRun.SnapshotFilePath}"
                            IsEnabled="{Binding SelectedRun.HasSnapshot}"
                            Margin="6,0,0,0" ToolTip="在文件资源管理器中定位快照文件">
                        <fa:IconBlock Icon="FolderOpen" IconFont="Solid" FontSize="11" />
                    </Button>
                </Grid>
            </Border>
            <Border Grid.Column="2" Padding="10,7" BorderThickness="1"
                    CornerRadius="4"
                    Background="{DynamicResource MahApps.Brushes.ThemeBackground}"
                    BorderBrush="{DynamicResource MahApps.Brushes.Gray7}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="RAW TAG LOG" FontSize="10" FontWeight="Bold"
                               Foreground="{DynamicResource MahApps.Brushes.Gray3}"
                               VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock Grid.Column="1" Text="{Binding SelectedRun.LogFilePath, TargetNullValue=Disabled}"
                               FontFamily="Consolas, Courier New" FontSize="11"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedRun.LogFilePath}" />
                    <Button Grid.Column="2" Style="{StaticResource FlatMiniButtonStyle}"
                            Command="{Binding LocateFileCommand}"
                            CommandParameter="{Binding SelectedRun.LogFilePath}"
                            IsEnabled="{Binding SelectedRun.HasLog}"
                            Margin="6,0,0,0" ToolTip="在文件资源管理器中定位原始日志文件">
                        <fa:IconBlock Icon="FolderOpen" IconFont="Solid" FontSize="11" />
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
