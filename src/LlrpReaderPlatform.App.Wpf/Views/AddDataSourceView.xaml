<UserControl x:Class="LlrpReaderPlatform.App.Wpf.Views.AddDataSourceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="44" MaxWidth="800" HorizontalAlignment="Left">
            <TextBlock Text="Add Data Source" FontSize="28" FontWeight="Bold" />
            <TextBlock Text="A data source is a saved LLRP reader endpoint. Adding it registers the endpoint and verifies TCP connectivity on the LLRP port. Inventory starts from the Inventory page."
                       TextWrapping="Wrap" FontSize="14" LineHeight="22" Margin="0,12,0,24" />

            <Border BorderThickness="1" Padding="24" Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="Host Name / IP Address:" FontWeight="Bold" FontSize="14" Margin="0,0,0,8" />
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="14" Padding="10,8" BorderThickness="1" />
                        <Button Grid.Column="1" Content="Scan LLRP Readers"
                                Command="{Binding DiscoverCommand}" Margin="10,0,0,0" Padding="14,8" />
                    </Grid>

                    <Border Visibility="{Binding IsDiscoveryPanelOpen, Converter={StaticResource BooleanToVisibilityConverter}}"
                            BorderThickness="1" Padding="16" Margin="0,0,0,20">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,10">
                                <Button Content="Close" Command="{Binding CloseDiscoveryPanelCommand}"
                                        DockPanel.Dock="Right" FontWeight="Bold" />
                                <TextBlock Text="Discovered LLRP Readers (mDNS _llrp._tcp.local.):"
                                           FontWeight="Bold" FontSize="13" />
                            </DockPanel>

                            <!-- WPF built-in progress control; no custom progress drawing. -->
                            <ProgressBar IsIndeterminate="{Binding IsDiscovering}" Height="4" Margin="0,0,0,10"
                                         Visibility="{Binding IsDiscovering, Converter={StaticResource BooleanToVisibilityConverter}}" />

                            <ListBox ItemsSource="{Binding Discovered}" MaxHeight="220">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="10,8" Margin="0,2" BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" FontSize="13" />
                                                    <TextBlock Text="{Binding DisplayEndpoint, StringFormat='Endpoint / IP: {0}'}"
                                                               FontSize="11" />
                                                </StackPanel>
                                                <Button Grid.Column="1" Content="Select Reader"
                                                        Command="{Binding DataContext.UseDiscoveredCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                        CommandParameter="{Binding}" Padding="12,5" FontSize="11" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Enter a hostname or IP address for a reader that exposes the LLRP service. Default LLRP port is 5084."
                               FontSize="12" Margin="0,0,0,20" />
                    <TextBlock Text="Nickname: (optional)" FontWeight="Bold" FontSize="14" Margin="0,0,0,8" />
                    <TextBox Text="{Binding ReaderName, UpdateSourceTrigger=PropertyChanged}" FontSize="14"
                             Padding="10,8" BorderThickness="1" Margin="0,0,0,24" />

                    <Expander Header="LLRP PORT" FontWeight="Bold" FontSize="13" Margin="0,0,0,24">
                        <Border Padding="16" Margin="0,8,0,0" BorderThickness="1">
                            <StackPanel>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="LLRP Port:" VerticalAlignment="Center" FontWeight="Bold" />
                                    <TextBox Grid.Column="1" Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}"
                                             Padding="6" Width="100" HorizontalAlignment="Left" />
                                </Grid>
                                <Grid Margin="0,10,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="LLRP Version:" VerticalAlignment="Center" FontWeight="Bold" />
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding LlrpVersions}"
                                              SelectedItem="{Binding LlrpVersion}" Width="160"
                                              HorizontalAlignment="Left" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Expander>

                    <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,0,0,12" />
                    <Border BorderThickness="1" Padding="10" Margin="0,0,0,12"
                            Visibility="{Binding HasProbeResult, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="{Binding ProbeSummary}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding ExtensionSummary}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                    <ProgressBar IsIndeterminate="{Binding IsSubmitting}" Height="4" Margin="0,0,0,12"
                                 Visibility="{Binding IsSubmitting, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="ADD DATA SOURCE" Command="{Binding SubmitCommand}"
                                Padding="20,10" FontSize="13" Margin="0,0,12,0" />
                        <Button Content="CANCEL" Command="{Binding CancelCommand}" Padding="20,10" FontSize="13" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
