<UserControl x:Class="LlrpReaderPlatform.App.Wpf.Views.AppSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Style x:Key="ApplicationActionStyle" TargetType="Button"
               BasedOn="{StaticResource FlatActionButtonStyle}">
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="mah:ControlsHelper.CornerRadius" Value="4" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                    <Setter Property="IsEnabled" Value="False" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DiagnosticsActionStyle" TargetType="Button"
               BasedOn="{StaticResource FlatActionButtonStyle}">
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="mah:ControlsHelper.CornerRadius" Value="4" />
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,24" MaxWidth="850" HorizontalAlignment="Left">
            <TextBlock Text="Application Settings" FontSize="28" FontWeight="SemiBold"
                       Foreground="{DynamicResource MahApps.Brushes.Accent}" />
            <TextBlock Text="Software-level settings for LLRP Reader Studio. Reader-specific settings are opened by selecting a data source."
                       TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource MahApps.Brushes.Gray3}" Margin="0,5,0,20" />
            <ProgressBar Height="4" Margin="0,0,0,14"
                         IsIndeterminate="True"
                         Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />

            <Border BorderThickness="1" BorderBrush="{DynamicResource MahApps.Brushes.Gray7}" CornerRadius="4" Padding="16" Margin="0,0,0,16" Background="{DynamicResource MahApps.Brushes.ThemeBackground}">
                <StackPanel>
                    <TextBlock Text="INVENTORY DATA RECORDING" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource MahApps.Brushes.Accent}" Margin="0,0,0,12" />
                    <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Recording mode:" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1" ItemsSource="{Binding LoggingModes}"
                                  SelectedItem="{Binding LoggingMode}" />
                    </Grid>
                    <TextBlock Text="{Binding LoggingModeDescription}" TextWrapping="Wrap"
                               Margin="120,7,0,0" Opacity="0.75" />
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Raw log directory:" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" Text="{Binding LogDirectory, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                    <Button Content="SAVE APPLICATION SETTINGS" Command="{Binding SaveCommand}"
                            Style="{StaticResource ApplicationActionStyle}"
                            HorizontalAlignment="Left" Margin="0,16,0,0" />
                    <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,10,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border BorderThickness="1" BorderBrush="{DynamicResource MahApps.Brushes.Gray7}" CornerRadius="4" Padding="16" Margin="0,0,0,16" Background="{DynamicResource MahApps.Brushes.ThemeBackground}">
                <StackPanel>
                    <TextBlock Text="DIAGNOSTICS LOGS" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource MahApps.Brushes.Accent}" Margin="0,0,0,12" />
                    <StackPanel>
                    <TextBlock Text="View the WPF, platform, and SDK/LLRP diagnostic files saved on this computer."
                               TextWrapping="Wrap" Opacity="0.75" />
                    <Button Click="OpenLogFolder_Click" Style="{StaticResource DiagnosticsActionStyle}"
                            ToolTip="Open the local diagnostic log folder"
                            HorizontalAlignment="Left" Margin="0,12,0,0">
                        <StackPanel Orientation="Horizontal">
                            <fa:IconBlock Icon="FolderOpen" IconFont="Solid" FontSize="18"
                                          Width="24" Margin="0,0,10,0" VerticalAlignment="Center"
                                          Foreground="{DynamicResource MahApps.Brushes.Accent}" />
                            <StackPanel>
                                <TextBlock Text="OPEN LOG FOLDER" />
                                <TextBlock Text="Open local diagnostic files" FontSize="11"
                                           FontWeight="Normal" Opacity="0.72" Margin="0,2,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border BorderThickness="1" BorderBrush="{DynamicResource MahApps.Brushes.Gray7}" CornerRadius="4" Padding="16" Margin="0,0,0,16" Background="{DynamicResource MahApps.Brushes.ThemeBackground}">
                <StackPanel>
                    <TextBlock Text="APPLICATION" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource MahApps.Brushes.Accent}" Margin="0,0,0,12" />
                    <StackPanel>
                    <TextBlock Text="{Binding ApplicationStatus}" TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
