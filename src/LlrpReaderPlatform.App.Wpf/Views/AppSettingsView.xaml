<UserControl x:Class="LlrpReaderPlatform.App.Wpf.Views.AppSettingsView"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
              xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp">
    <UserControl.Resources>
        <Style x:Key="SettingsIconButtonStyle" TargetType="Button"
               BasedOn="{StaticResource IconActionButtonStyle}" />
        <Style x:Key="SettingsSaveButtonStyle" TargetType="Button"
               BasedOn="{StaticResource IconPrimaryButtonStyle}" />
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="28,24">
            <StackPanel HorizontalAlignment="Stretch">
                <TextBlock Text="Application Settings" FontSize="28" FontWeight="SemiBold"
                           Foreground="{DynamicResource MahApps.Brushes.Accent}" />
                <TextBlock Text="Software-level settings for LLRP Reader Studio. Reader-specific settings are opened by selecting a data source."
                           TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource MahApps.Brushes.Gray3}" Margin="0,4,0,20" />
                <ProgressBar Height="4" Margin="0,0,0,14"
                             IsIndeterminate="True"
                             Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />

                <Border Style="{StaticResource StandardCardStyle}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="INVENTORY DATA RECORDING" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource MahApps.Brushes.Accent}" Margin="0,0,0,14" />
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Recording mode:" VerticalAlignment="Center" FontWeight="SemiBold" Opacity="0.75" />
                            <ComboBox Grid.Column="1" ItemsSource="{Binding LoggingModes}"
                                      SelectedItem="{Binding LoggingMode}" />
                        </Grid>
                        <TextBlock Text="{Binding LoggingModeDescription}" TextWrapping="Wrap"
                                   Margin="140,0,0,12" Foreground="{DynamicResource MahApps.Brushes.Gray3}" FontSize="12" />
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Raw log directory:" VerticalAlignment="Center" FontWeight="SemiBold" Opacity="0.75" />
                            <TextBox Grid.Column="1" Text="{Binding LogDirectory, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>
                        <DockPanel Margin="0,4,0,0">
                            <Button Command="{Binding SaveCommand}"
                                    Style="{StaticResource SettingsSaveButtonStyle}"
                                    DockPanel.Dock="Left"
                                    ToolTip="Save application settings"
                                    AutomationProperties.Name="Save application settings">
                                <fa:IconBlock Icon="FloppyDisk" IconFont="Solid" FontSize="14" />
                            </Button>
                            <TextBlock Text="{Binding Status}" TextWrapping="Wrap"
                                       VerticalAlignment="Center" Margin="16,0,0,0"
                                       Foreground="{DynamicResource MahApps.Brushes.Gray3}" />
                        </DockPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource StandardCardStyle}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="DIAGNOSTICS LOGS" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource MahApps.Brushes.Accent}" Margin="0,0,0,12" />
                        <TextBlock Text="View the WPF, platform, and SDK/LLRP diagnostic files saved on this computer."
                                   TextWrapping="Wrap" Foreground="{DynamicResource MahApps.Brushes.Gray3}" FontSize="13" />
                        <Button Click="OpenLogFolder_Click" Style="{StaticResource SettingsIconButtonStyle}"
                                ToolTip="Open the local diagnostic log folder"
                                HorizontalAlignment="Left" Margin="0,14,0,0"
                                AutomationProperties.Name="Open log folder">
                            <fa:IconBlock Icon="FolderOpen" IconFont="Solid" FontSize="14" />
                        </Button>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource StandardCardStyle}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="APPLICATION" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource MahApps.Brushes.Accent}" Margin="0,0,0,12" />
                        <TextBlock Text="{Binding ApplicationStatus}" TextWrapping="Wrap" LineHeight="20" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
