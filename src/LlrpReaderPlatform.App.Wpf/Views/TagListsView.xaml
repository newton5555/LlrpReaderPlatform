<UserControl x:Class="LlrpReaderPlatform.App.Wpf.Views.TagListsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Style x:Key="ToiIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.Accent}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Accent}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="18">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource MahApps.Brushes.Accent}" />
                                <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.IdealForeground}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.78" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                    <Setter Property="IsEnabled" Value="False" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ToiAddIconButtonStyle" TargetType="Button"
               BasedOn="{StaticResource ToiIconButtonStyle}">
            <Setter Property="Foreground" Value="#16A34A" />
            <Setter Property="BorderBrush" Value="#16A34A" />
        </Style>
        <Style x:Key="ToiRemoveIconButtonStyle" TargetType="Button"
               BasedOn="{StaticResource ToiIconButtonStyle}">
            <Setter Property="Foreground" Value="#DC2626" />
            <Setter Property="BorderBrush" Value="#DC2626" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Tags of Interest (TOI)" FontSize="28" FontWeight="SemiBold"
                           Foreground="{DynamicResource MahApps.Brushes.Accent}" />
                <TextBlock Margin="0,5,0,0" FontSize="13"
                           Foreground="{DynamicResource MahApps.Brushes.Gray3}"
                           Text="Maintain the EPC, TOI name and display color used by Inventory." />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Command="{Binding LoadCommand}" Style="{StaticResource ToiIconButtonStyle}"
                        ToolTip="Refresh TOI">
                    <fa:IconBlock Icon="ArrowsRotate" IconFont="Solid" FontSize="15" />
                </Button>
                <Button Command="{Binding SaveCommand}" Style="{StaticResource ToiIconButtonStyle}"
                        Margin="8,0,0,0" ToolTip="Save TOI changes">
                    <fa:IconBlock Icon="FloppyDisk" IconFont="Solid" FontSize="15" />
                </Button>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Margin="0,16,0,14" Padding="16,14"
                BorderBrush="{DynamicResource MahApps.Brushes.Gray7}"
                BorderThickness="1" CornerRadius="4"
                Background="{DynamicResource MahApps.Brushes.ThemeBackground}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="1.2*" />
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="EPC" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <TextBox Text="{Binding EntryEpc, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Padding="8" FontFamily="Consolas, Courier New"
                             mah:TextBoxHelper.Watermark="EPC hexadecimal" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                    <TextBlock Text="TOI name" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <TextBox Text="{Binding EntryDisplayName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Padding="8" mah:TextBoxHelper.Watermark="e.g. Door 1" />
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="12,0,0,0">
                    <TextBlock Text="Color" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <mah:ColorPicker SelectedColor="{Binding EntryColor, Mode=TwoWay, Converter={StaticResource HexColorToColorConverter}}"
                                     Height="34" HorizontalAlignment="Stretch" />
                </StackPanel>
                <Button Grid.Column="3" Command="{Binding AddEntryCommand}"
                        Style="{StaticResource ToiAddIconButtonStyle}"
                        Margin="12,22,0,0" VerticalAlignment="Top"
                        ToolTip="Add TOI">
                    <fa:IconBlock Icon="Plus" IconFont="Solid" FontSize="15" />
                </Button>
            </Grid>
        </Border>

        <Border Grid.Row="2" BorderBrush="{DynamicResource MahApps.Brushes.Gray7}"
                BorderThickness="1" CornerRadius="4" Background="{DynamicResource MahApps.Brushes.ThemeBackground}">
            <DataGrid ItemsSource="{Binding Entries, Mode=OneWay}"
                      SelectedItem="{Binding SelectedEntry, Mode=TwoWay}"
                      AutoGenerateColumns="False" CanUserAddRows="False"
                      RowHeight="48" GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="{DynamicResource MahApps.Brushes.Gray8}"
                      EnableRowVirtualization="True" EnableColumnVirtualization="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="EPC" Width="2*"
                                        Binding="{Binding EpcHex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <DataGridTextColumn Header="TOI name" Width="1.2*"
                                        Binding="{Binding DisplayName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <DataGridTemplateColumn Header="Color" Width="220">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="18" Height="18" CornerRadius="3" BorderThickness="1"
                                            BorderBrush="{DynamicResource MahApps.Brushes.Gray7}"
                                            Background="{Binding ColorHex, Mode=OneWay, Converter={StaticResource HexColorToBrushConverter}}" />
                                    <TextBlock Text="{Binding ColorHex, Mode=OneWay}"
                                               Margin="8,0,0,0" FontFamily="Consolas, Courier New"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <mah:ColorPicker SelectedColor="{Binding ColorHex, Mode=TwoWay, Converter={StaticResource HexColorToColorConverter}}"
                                                 Height="32" HorizontalAlignment="Stretch" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="" Width="68" IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.RemoveEntryCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource ToiRemoveIconButtonStyle}"
                                        Width="38" Height="38"
                                        ToolTip="Remove TOI">
                                    <fa:IconBlock Icon="Trash" IconFont="Solid" FontSize="18" />
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Grid Grid.Row="3" Margin="0,12,0,0">
            <ProgressBar Height="4" IsIndeterminate="True" VerticalAlignment="Top"
                         Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <TextBlock Margin="0,9,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource MahApps.Brushes.Gray3}">
                <Run Text="{Binding EntryCount, Mode=OneWay}" />
                <Run Text=" TOIs · " />
                <Run Text="{Binding Status, Mode=OneWay}" />
            </TextBlock>
        </Grid>
    </Grid>
</UserControl>
