<UserControl x:Class="LlrpReaderPlatform.App.Wpf.Views.TagListsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp">
    <UserControl.Resources>
        <Style x:Key="ToiActionCircleButtonStyle" TargetType="Button"
               BasedOn="{StaticResource FlatCircleButtonStyle}">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                    <Setter Property="IsEnabled" Value="False" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ToiAddButtonStyle" TargetType="Button"
               BasedOn="{StaticResource SuccessCircleButtonStyle}">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                    <Setter Property="IsEnabled" Value="False" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Tags of Interest (TOI)" FontSize="28" FontWeight="SemiBold"
                           Foreground="{DynamicResource MahApps.Brushes.Accent}" />
                <TextBlock Margin="0,5,0,0" FontSize="13"
                           Foreground="{DynamicResource MahApps.Brushes.Gray3}"
                           Text="Maintain the EPC, TOI name and display color used by Inventory." />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Command="{Binding LoadCommand}" Style="{StaticResource ToiActionCircleButtonStyle}"
                        ToolTip="Refresh TOI">
                    <fa:IconBlock Icon="ArrowsRotate" IconFont="Solid" FontSize="14" />
                </Button>
                <Button Command="{Binding SaveCommand}" Style="{StaticResource ToiActionCircleButtonStyle}"
                        Margin="8,0,0,0" ToolTip="Save TOI changes">
                    <fa:IconBlock Icon="FloppyDisk" IconFont="Solid" FontSize="14" />
                </Button>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Margin="0,16,0,14" Padding="16,14"
                BorderBrush="{DynamicResource MahApps.Brushes.Gray7}"
                BorderThickness="1" CornerRadius="4"
                Background="{DynamicResource MahApps.Brushes.ThemeBackground}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="1.2*" />
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="EPC" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <TextBox Text="{Binding EntryEpc, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Padding="8" FontFamily="Consolas, Courier New"
                             mah:TextBoxHelper.Watermark="EPC hexadecimal" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                    <TextBlock Text="TOI name" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <TextBox Text="{Binding EntryDisplayName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Padding="8" mah:TextBoxHelper.Watermark="e.g. Door 1" />
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="12,0,0,0">
                    <TextBlock Text="Color" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <mah:ColorPicker SelectedColor="{Binding EntryColor, Mode=TwoWay, Converter={StaticResource HexColorToColorConverter}}"
                                     Height="34" HorizontalAlignment="Stretch" />
                </StackPanel>
                <Button Grid.Column="3" Command="{Binding AddEntryCommand}"
                        Style="{StaticResource ToiAddButtonStyle}"
                        Margin="12,22,0,0" VerticalAlignment="Top"
                        ToolTip="Add TOI">
                    <fa:IconBlock Icon="Plus" IconFont="Solid" FontSize="14" />
                </Button>
            </Grid>
        </Border>

        <Border Grid.Row="2" BorderBrush="{DynamicResource MahApps.Brushes.Gray7}"
                BorderThickness="1" CornerRadius="4" Background="{DynamicResource MahApps.Brushes.ThemeBackground}">
            <DataGrid ItemsSource="{Binding Entries, Mode=OneWay}"
                      SelectedItem="{Binding SelectedEntry, Mode=TwoWay}"
                      AutoGenerateColumns="False" CanUserAddRows="False"
                      RowHeight="38" FontSize="12" Margin="8" GridLinesVisibility="Horizontal" BorderThickness="1"
                      HorizontalGridLinesBrush="{DynamicResource MahApps.Brushes.Gray8}"
                      EnableRowVirtualization="True" EnableColumnVirtualization="True"
                      ScrollViewer.CanContentScroll="True"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling">
                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="FontWeight" Value="Bold" />
                        <Setter Property="Padding" Value="10,8" />
                        <Setter Property="BorderThickness" Value="0,0,1,1" />
                    </Style>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Padding" Value="8,4" />
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                    </Style>
                </DataGrid.Resources>
                <DataGrid.RowStyle>
                    <Style TargetType="{x:Type DataGridRow}" BasedOn="{StaticResource MahApps.Styles.DataGridRow}">
                        <Setter Property="mah:DataGridHelper.CellPadding" Value="8,4" />
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="EPC" Width="2*"
                                        Binding="{Binding EpcHex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        ElementStyle="{StaticResource LeftMonoCellTextStyle}" />
                    <DataGridTextColumn Header="TOI name" Width="1.2*"
                                        Binding="{Binding DisplayName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        ElementStyle="{StaticResource LeftCellTextStyle}" />
                    <DataGridTemplateColumn Header="Color" Width="220">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="18" Height="18" CornerRadius="3" BorderThickness="1"
                                            BorderBrush="{DynamicResource MahApps.Brushes.Gray7}"
                                            Background="{Binding ColorHex, Mode=OneWay, Converter={StaticResource HexColorToBrushConverter}}" />
                                    <TextBlock Text="{Binding ColorHex, Mode=OneWay}"
                                               Margin="8,0,0,0" FontFamily="Consolas, Courier New"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <mah:ColorPicker SelectedColor="{Binding ColorHex, Mode=TwoWay, Converter={StaticResource HexColorToColorConverter}}"
                                                 Height="32" HorizontalAlignment="Stretch" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="" Width="68" IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.RemoveEntryCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource DangerCircleButtonStyle}"
                                        Width="28" Height="28"
                                        VerticalAlignment="Center"
                                        ToolTip="Remove TOI">
                                    <fa:IconBlock Icon="Trash" IconFont="Solid" FontSize="13" />
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Grid Grid.Row="3" Margin="0,12,0,0">
            <ProgressBar Height="4" IsIndeterminate="True" VerticalAlignment="Top"
                         Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <TextBlock Margin="0,9,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource MahApps.Brushes.Gray3}">
                <Run Text="{Binding EntryCount, Mode=OneWay}" />
                <Run Text=" TOIs · " />
                <Run Text="{Binding Status, Mode=OneWay}" />
            </TextBlock>
        </Grid>
    </Grid>
</UserControl>
