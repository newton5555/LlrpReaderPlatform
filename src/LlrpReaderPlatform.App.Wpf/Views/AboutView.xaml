<UserControl x:Class="LlrpReaderPlatform.App.Wpf.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,24" MaxWidth="720" HorizontalAlignment="Left">
            <Border BorderThickness="1" BorderBrush="{DynamicResource MahApps.Brushes.Gray7}"
                    CornerRadius="4" Background="{DynamicResource MahApps.Brushes.ThemeBackground}"
                    Padding="32">
                <StackPanel>
                    <Image Source="/LlrpReaderPlatform;component/Assets/LlrpReader_Pro_Icon_Light.png"
                           Width="132" Height="132" HorizontalAlignment="Left"
                           Stretch="Uniform" Margin="0,0,0,18"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="{Binding AppName}" FontSize="32" FontWeight="SemiBold"
                               Foreground="{DynamicResource MahApps.Brushes.Accent}" />
                    <TextBlock Text="{Binding Version}" FontSize="14"
                               Foreground="{DynamicResource MahApps.Brushes.Gray3}" Margin="0,4,0,0" />
                    <Separator Margin="0,16" Background="{DynamicResource MahApps.Brushes.Gray7}" />
                    <TextBlock Text="{Binding Description}" TextWrapping="Wrap" FontSize="15"
                               LineHeight="24" Margin="0,0,0,24" />
                    <Border Background="{DynamicResource MahApps.Brushes.Gray10}" Padding="16" CornerRadius="4">
                        <StackPanel>
                            <TextBlock Text="License / Notice" FontSize="16" FontWeight="SemiBold"
                                       Margin="0,0,0,8" />
                            <TextBlock Text="{Binding LicenseNotice}" TextWrapping="Wrap" FontSize="13"
                                       LineHeight="22" Foreground="{DynamicResource MahApps.Brushes.Gray3}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
