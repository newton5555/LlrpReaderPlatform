@page "/runs"
@inject ReaderManagerState State
@inject IInventoryRunStore RunsStore

<div class="section-header">
    <div>
        <h1 class="section-title">Inventory Runs</h1>
        <p class="section-subtitle">Historical inventory session summaries and run logs persisted in SQLite.</p>
    </div>
    <div class="toolbar">
        <label class="form-label" for="runs-reader">Reader</label>
        <select id="runs-reader" style="width: min(280px, 50vw);" value="@selectedReaderText" @onchange="SelectReader">
            <option value="">Choose Reader</option>
            @foreach (ReaderRuntimeSnapshot reader in State.Readers)
            {
                <option value="@reader.ReaderId">@reader.Profile.Name (@reader.Profile.Host:@reader.Profile.Port)</option>
            }
        </select>
        <button class="btn btn-sm" @onclick="LoadAsync" disabled="@pageBusy">
            <AppIcon Name="rotate" Size="13" />
            <span>Refresh</span>
        </button>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(error))
{
    <div class="notice error" style="margin-bottom: var(--space-4);">@error</div>
}
@if (!string.IsNullOrWhiteSpace(statusMessage))
{
    <div class="notice ok" style="margin-bottom: var(--space-4);">@statusMessage</div>
}

<section class="card">
    <div class="card-header">
        <span class="card-title">
            <AppIcon Name="history" Size="14" />
            <span>Run History</span>
        </span>
        <span class="status-badge neutral">@runs.Count record(s)</span>
    </div>
    @if (runs.Count == 0)
    {
        <div class="empty-state">
            <AppIcon Name="history" Size="36" />
            <h2>No Completed Runs</h2>
            <p>Start and stop inventory on a Reader to generate historical run records.</p>
        </div>
    }
    else
    {
        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>Started</th>
                        <th>Ended</th>
                        <th>Stop Reason</th>
                        <th>Total Reads</th>
                        <th>Unique Tags</th>
                        <th>Snapshot File</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (InventoryRunRecord run in runs)
                    {
                        <tr>
                            <td class="mono">@run.StartedAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</td>
                            <td class="mono">@(run.EndedAtUtc?.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss") ?? "In Progress")</td>
                            <td><span class="status-badge neutral">@run.StopReason</span></td>
                            <td class="mono">@run.TotalReadCount</td>
                            <td class="mono" style="font-weight: 600;">@run.UniqueTagCount</td>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(run.SnapshotFilePath))
                                {
                                    <button class="btn btn-sm"
                                            style="padding: 2px 8px; font-size: 11px; gap: 4px;"
                                            @onclick="() => OpenSnapshotFileAsync(run.SnapshotFilePath)"
                                            title="Click to open @run.SnapshotFilePath">
                                        <AppIcon Name="folder-open" Size="12" />
                                        <span class="mono" style="max-width: 180px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                                            @System.IO.Path.GetFileName(run.SnapshotFilePath)
                                        </span>
                                    </button>
                                }
                                else
                                {
                                    <span class="muted mono">—</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

@code {
    private string? selectedReaderText;
    private List<InventoryRunRecord> runs = [];
    private string? error;
    private string? statusMessage;
    private bool pageBusy;

    protected override async Task OnInitializedAsync()
    {
        await State.InitializeAsync();
        selectedReaderText = State.SelectedReaderId?.ToString() ?? State.Readers.FirstOrDefault()?.ReaderId.ToString();
        await LoadAsync();
    }

    private void SelectReader(ChangeEventArgs args)
    {
        selectedReaderText = args.Value?.ToString();
        State.Select(ParseReaderId(selectedReaderText));
        _ = LoadAsync();
    }

    private async Task LoadAsync()
    {
        Guid? readerId = ParseReaderId(selectedReaderText);
        if (readerId is null || pageBusy)
        {
            runs = [];
            return;
        }

        pageBusy = true;
        error = null;
        statusMessage = null;
        try
        {
            runs = (await RunsStore.GetForReaderAsync(readerId.Value)).ToList();
        }
        catch (Exception exception)
        {
            error = exception.Message;
        }
        finally
        {
            pageBusy = false;
        }
    }

    private async Task OpenSnapshotFileAsync(string? filePath)
    {
        if (string.IsNullOrWhiteSpace(filePath))
        {
            return;
        }

        error = null;
        statusMessage = null;
        try
        {
            if (File.Exists(filePath))
            {
                if (OperatingSystem.IsWindows())
                {
                    System.Diagnostics.Process.Start(new System.Diagnostics.ProcessStartInfo
                    {
                        FileName = filePath,
                        UseShellExecute = true
                    });
                    statusMessage = $"Opened snapshot file: {Path.GetFileName(filePath)}";
                }
                else
                {
                    await Launcher.Default.OpenAsync(new OpenFileRequest
                    {
                        File = new ReadOnlyFile(filePath)
                    });
                }
            }
            else
            {
                error = $"Snapshot file not found on disk: {filePath}";
            }
        }
        catch (Exception ex)
        {
            error = $"Failed to open file: {ex.Message}";
        }
    }

    private static Guid? ParseReaderId(string? value) => Guid.TryParse(value, out Guid id) ? id : null;
}
