@page "/readers"
@implements IDisposable
@inject ReaderManagerState State
@inject VirtualReaderWidgetService VirtualDevices

<div class="section-header">
    <div>
        <h1 class="section-title">Reader Management</h1>
        <p class="section-subtitle">Manage physical RFID reader endpoints or launch a single local virtual device for UI testing.</p>
    </div>
    <div class="toolbar">
        <button class="btn btn-sm" @onclick="() => OpenPropertiesModal(null)">
            <AppIcon Name="plus" Size="13" />
            <span>Add Reader (Properties)</span>
        </button>
        <button class="btn btn-sm" @onclick="DiscoverAsync" disabled="@(State.IsBusy || VirtualDevices.IsBusy)">
            <AppIcon Name="rotate" Size="13" />
            <span>Scan Network</span>
        </button>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(message))
{
    <div class="notice @(messageIsError ? "error" : "info")" style="margin-bottom: var(--space-4);">
        @message
    </div>
}

<div class="split">
    <section class="stack">
        <!-- Physical Reader Quick Add Form -->
        <div class="card">
            <div class="card-header">
                <span class="card-title">
                    <AppIcon Name="plus" Size="14" />
                    <span>Add Physical Reader</span>
                </span>
                <span class="status-badge neutral">TCP Client</span>
            </div>
            <div class="card-pad">
                <div class="inline-form">
                    <div class="form-group">
                        <label class="form-label">Reader Name</label>
                        <input type="text" @bind="physicalName" placeholder="Warehouse Reader 1" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Host / IP Address</label>
                        <input type="text" @bind="physicalHost" placeholder="192.168.1.100" class="mono" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Port</label>
                        <input type="number" @bind="physicalPort" min="1" max="65535" class="mono" />
                    </div>
                    <div style="display: flex; gap: var(--space-2); align-self: flex-end;">
                        <button class="btn btn-primary" @onclick="AddPhysicalAsync" disabled="@(State.IsBusy || VirtualDevices.IsBusy || string.IsNullOrWhiteSpace(physicalHost))">
                            <AppIcon Name="plus" Size="13" />
                            <span>Add</span>
                        </button>
                        <button class="btn btn-sm" @onclick="() => OpenPropertiesModal(new ReaderProfile { Id = Guid.NewGuid(), Name = physicalName, Host = physicalHost, Port = physicalPort })" title="Advanced Connection Properties">
                            <AppIcon Name="sliders" Size="13" />
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Discovered Readers -->
        @if (State.DiscoveredReaders.Count > 0)
        {
            <div class="card">
                <div class="card-header">
                    <span class="card-title">
                        <AppIcon Name="search" Size="14" />
                        <span>Discovered Readers (@State.DiscoveredReaders.Count)</span>
                    </span>
                </div>
                <div class="table-wrap">
                    <table>
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Endpoint</th>
                                <th style="text-align: right;">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (DiscoveredReader discovered in State.DiscoveredReaders)
                            {
                                <tr>
                                    <td><strong>@discovered.DisplayName</strong></td>
                                    <td class="mono">@discovered.IpAddress:@discovered.Port</td>
                                    <td style="text-align: right;">
                                        <button class="btn btn-sm btn-primary" @onclick="() => AddDiscoveredAsync(discovered)" disabled="@State.IsBusy">
                                            <AppIcon Name="plus" Size="11" />
                                            <span>Add</span>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }

        <!-- Active Readers List -->
        @if (State.Readers.Count == 0)
        {
            <div class="card empty-state">
                <AppIcon Name="readers" Size="36" />
                <h2>No Readers Registered</h2>
                <p>Add a physical reader above or start the virtual device test target on the right.</p>
            </div>
        }
        else
        {
            @foreach (ReaderRuntimeSnapshot reader in State.Readers)
            {
                <div class="card reader-card">
                    <div class="reader-head">
                        <div class="reader-heading">
                            <div class="reader-icon @(IsVirtual(reader.ReaderId) ? "virtual" : string.Empty)">
                                <AppIcon Name="@(IsVirtual(reader.ReaderId) ? "cube" : "search")" Size="18" />
                            </div>
                            <div>
                                <div class="reader-name">@reader.Profile.Name</div>
                                <div class="reader-endpoint">@reader.Profile.Host:@reader.Profile.Port · @ProtocolText(reader)</div>
                            </div>
                        </div>
                        <div class="reader-statuses">
                            <span class="status-badge @(reader.IsEnabled ? "ok" : "neutral")">@(reader.IsEnabled ? "Enabled" : "Disabled")</span>
                            <span class="status-badge @StatusClass(reader.State)">@reader.State</span>
                        </div>
                    </div>
                    <div class="reader-body">
                        <div>
                            <div class="field-label">Model</div>
                            <div class="field-value">@(reader.Model ?? "Not captured")</div>
                        </div>
                        <div>
                            <div class="field-label">Firmware</div>
                            <div class="field-value mono">@(reader.Firmware ?? "—")</div>
                        </div>
                        <div>
                            <div class="field-label">Antennas</div>
                            <div class="field-value mono">@(reader.Antennas.Count > 0 ? reader.Antennas.Count : 0)</div>
                        </div>
                        <div>
                            <div class="field-label">GPI / GPO</div>
                            <div class="field-value mono">@(reader.GpiCount?.ToString() ?? "—") / @(reader.GpoCount?.ToString() ?? "—")</div>
                        </div>
                    </div>
                    <div class="reader-actions">
                        <button class="btn btn-sm" @onclick="() => ToggleReaderAsync(reader)" disabled="@State.IsBusy">
                            @(reader.IsEnabled ? "Disable" : "Enable")
                        </button>
                        <a class="btn btn-sm" href="/inventory">
                            <AppIcon Name="search" Size="12" />
                            <span>Inventory</span>
                        </a>
                        <a class="btn btn-sm" href="/tag-memory">
                            <AppIcon Name="microchip" Size="12" />
                            <span>Tag Ops</span>
                        </a>
                        <a class="btn btn-sm" href="/settings">
                            <AppIcon Name="gear" Size="12" />
                            <span>Settings</span>
                        </a>

                        @if (!IsVirtual(reader.ReaderId))
                        {
                            <button class="btn btn-sm" @onclick="() => OpenPropertiesModal(reader.Profile)" title="Properties">
                                <AppIcon Name="sliders" Size="12" />
                                <span>Properties</span>
                            </button>
                        }

                        @if (IsVirtual(reader.ReaderId))
                        {
                            <button class="btn btn-sm btn-danger push-right" @onclick="() => StopVirtualAsync(reader.ReaderId)" disabled="@(State.IsBusy || VirtualDevices.IsBusy)">
                                <AppIcon Name="stop" Size="11" />
                                <span>Stop Virtual</span>
                            </button>
                        }
                        else
                        {
                            <button class="btn btn-sm btn-danger push-right" @onclick="() => RemoveReaderAsync(reader.ReaderId)" disabled="@State.IsBusy">
                                <AppIcon Name="trash" Size="11" />
                                <span>Remove</span>
                            </button>
                        }
                    </div>
                </div>
            }
        }
    </section>

    <!-- Right: Single Virtual Device Test Target -->
    <aside class="stack">
        <section class="card virtual-widget-card">
            <div class="card-header">
                <span class="card-title">
                    <AppIcon Name="cube" Size="15" />
                    <span>Virtual Test Device</span>
                </span>
                <span class="status-badge @(VirtualDevices.IsRunning ? "ok" : "neutral")">
                    @(VirtualDevices.IsRunning ? "Running" : "Stopped")
                </span>
            </div>
            <div class="card-pad stack">
                <p class="form-hint">
                    A lightweight protocol test host that runs locally on loopback TCP (127.0.0.1) for testing the UI client.
                </p>

                @if (VirtualDevices.IsRunning && VirtualDevices.CurrentInstance is { } instance)
                {
                    <div class="notice ok">
                        <strong>@instance.Name</strong>
                        <div class="mono" style="margin-top: 4px; font-size: 11px;">
                            Listening on 127.0.0.1:@instance.Port
                        </div>
                        <div class="form-hint" style="margin-top: 2px;">
                            Connected Clients: @instance.ConnectedClientCount · State: @instance.State
                        </div>
                    </div>

                    <button class="btn btn-danger" style="width: 100%;" @onclick="() => StopVirtualAsync(instance.ReaderId)" disabled="@(State.IsBusy || VirtualDevices.IsBusy)">
                        <AppIcon Name="stop" Size="13" />
                        <span>Stop Virtual Device</span>
                    </button>
                }
                else
                {
                    <div class="form-group">
                        <label class="form-label">Capability Profile</label>
                        <select @bind="virtualProfileId" disabled="@(State.IsBusy || VirtualDevices.IsBusy)">
                            @foreach (VirtualDeviceProfileInfo profile in VirtualDeviceProfiles.All)
                            {
                                <option value="@profile.Id">@profile.Name (@profile.ProtocolVersion)</option>
                            }
                        </select>
                    </div>

                    <div class="form-group">
                        <label class="form-label">TCP Port (0 = auto-assign)</label>
                        <input type="number" min="0" max="65535" @bind="virtualPort" class="mono" disabled="@(State.IsBusy || VirtualDevices.IsBusy)" />
                    </div>

                    <button class="btn btn-primary" style="width: 100%;" @onclick="StartVirtualAsync" disabled="@(State.IsBusy || VirtualDevices.IsBusy)">
                        <AppIcon Name="play" Size="13" />
                        <span>Start Virtual Device</span>
                    </button>
                }
            </div>
        </section>
    </aside>
</div>

<!-- Complete Reader Properties Modal Dialog -->
@if (showPropertiesModal)
{
    <div class="modal-overlay" @onclick="ClosePropertiesModal">
        <div class="modal-dialog" @onclick:stopPropagation="true">
            <div class="modal-header">
                <span class="modal-title">
                    <AppIcon Name="sliders" Size="16" />
                    <span>Reader Properties & Connection Strategy</span>
                </span>
                <button class="btn btn-sm" style="padding: 2px 6px; border: 0;" @onclick="ClosePropertiesModal">
                    <AppIcon Name="xmark" Size="14" />
                </button>
            </div>
            <div class="modal-body">
                @if (!string.IsNullOrWhiteSpace(modalErrorMessage))
                {
                    <div class="notice error">
                        <strong>Connection / Activation Notice:</strong>
                        <div style="margin-top: 4px;">@modalErrorMessage</div>
                    </div>
                }

                <div class="form-group">
                    <label class="form-label">Reader Name / Alias</label>
                    <input type="text" @bind="modalName" placeholder="Warehouse Reader 1" />
                </div>

                <div style="display: grid; grid-template-columns: 1fr 140px; gap: var(--space-3);">
                    <div class="form-group">
                        <label class="form-label">Host / IP Address</label>
                        <input type="text" @bind="modalHost" placeholder="192.168.1.100 or host.domain" class="mono" />
                        <span class="form-hint">Physical IP or network hostname</span>
                    </div>
                    <div class="form-group">
                        <label class="form-label">LLRP Port</label>
                        <input type="number" @bind="modalPort" min="1" max="65535" class="mono" />
                        <span class="form-hint">Standard default: 5084</span>
                    </div>
                </div>

                <div class="form-group">
                    <label class="form-label">LLRP Protocol Version Strategy</label>
                    <select @bind="modalVersion">
                        <option value="@LlrpProtocolVersionOption.Auto">Auto Probe (Highest Supported: 2.0 → 1.1 → 1.0.1 · Recommended)</option>
                        <option value="@LlrpProtocolVersionOption.Force101">Force LLRP 1.0.1 Standard</option>
                        <option value="@LlrpProtocolVersionOption.Force11">Force LLRP 1.1 Standard</option>
                        <option value="@LlrpProtocolVersionOption.Force20">Force LLRP 2.0 Standard</option>
                    </select>
                    <span class="form-hint">Auto probe negotiates with standard LLRP devices as well as vendor extensions (Impinj/Zebra).</span>
                </div>

                <div class="form-group">
                    <label class="check-line" style="margin-top: 4px;">
                        <input type="checkbox" @bind="modalEnabled" />
                        <span>Enable immediately and synchronize capabilities</span>
                    </label>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-sm" @onclick="ClosePropertiesModal" disabled="@State.IsBusy">Cancel</button>
                <button class="btn btn-sm btn-primary" @onclick="SavePropertiesModalAsync" disabled="@(State.IsBusy || string.IsNullOrWhiteSpace(modalHost))">
                    <AppIcon Name="check" Size="13" />
                    <span>Save & Connect</span>
                </button>
            </div>
        </div>
    </div>
}

@code {
    private string physicalName = string.Empty;
    private string physicalHost = string.Empty;
    private int physicalPort = 5084;
    private string virtualProfileId = VirtualDeviceProfiles.Standard101Id;
    private int virtualPort = 5084;
    private string? message;
    private bool messageIsError;

    // Reader Properties Modal state
    private bool showPropertiesModal;
    private Guid? editingReaderId;
    private string modalName = string.Empty;
    private string modalHost = string.Empty;
    private int modalPort = 5084;
    private LlrpProtocolVersionOption modalVersion = LlrpProtocolVersionOption.Auto;
    private bool modalEnabled = true;
    private string? modalErrorMessage;

    protected override async Task OnInitializedAsync()
    {
        State.Changed += OnChanged;
        VirtualDevices.Changed += OnChanged;
        await State.InitializeAsync();
    }

    private void OpenPropertiesModal(ReaderProfile? existing)
    {
        if (existing is not null)
        {
            editingReaderId = existing.Id;
            modalName = existing.Name;
            modalHost = existing.Host;
            modalPort = existing.Port;
            modalVersion = existing.LlrpVersion;
            modalEnabled = existing.IsEnabled;
        }
        else
        {
            editingReaderId = null;
            modalName = string.IsNullOrWhiteSpace(physicalName) ? string.Empty : physicalName;
            modalHost = string.IsNullOrWhiteSpace(physicalHost) ? string.Empty : physicalHost;
            modalPort = physicalPort;
            modalVersion = LlrpProtocolVersionOption.Auto;
            modalEnabled = true;
        }

        modalErrorMessage = null;
        showPropertiesModal = true;
    }

    private void ClosePropertiesModal()
    {
        showPropertiesModal = false;
        modalErrorMessage = null;
    }

    private async Task SavePropertiesModalAsync()
    {
        if (string.IsNullOrWhiteSpace(modalHost))
        {
            modalErrorMessage = "Host / IP Address is required.";
            return;
        }

        Guid targetId = editingReaderId ?? Guid.NewGuid();
        var profile = new ReaderProfile
        {
            Id = targetId,
            Name = string.IsNullOrWhiteSpace(modalName) ? modalHost.Trim() : modalName.Trim(),
            Host = modalHost.Trim(),
            Port = modalPort,
            LlrpVersion = modalVersion,
            IsEnabled = modalEnabled,
        };

        try
        {
            if (editingReaderId is { } existingId)
            {
                await State.RemoveAsync(existingId);
            }

            ReaderAddResult result = await State.AddAsync(profile, enableAfterAdding: modalEnabled);
            if (result.Succeeded)
            {
                showPropertiesModal = false;
                SetMessage($"Reader '{profile.Name}' configured and activated successfully.", false);
                physicalName = string.Empty;
                physicalHost = string.Empty;
                editingReaderId = null;
            }
            else
            {
                modalErrorMessage = result.Error ?? "Failed to connect to reader. Please check IP, port, and LLRP version strategy.";
            }
        }
        catch (Exception exception)
        {
            modalErrorMessage = exception.Message;
        }
    }

    private async Task AddPhysicalAsync()
    {
        try
        {
            var profile = new ReaderProfile
            {
                Id = Guid.NewGuid(),
                Name = string.IsNullOrWhiteSpace(physicalName) ? physicalHost.Trim() : physicalName.Trim(),
                Host = physicalHost.Trim(),
                Port = physicalPort,
                LlrpVersion = LlrpProtocolVersionOption.Auto,
                IsEnabled = true,
            };

            ReaderAddResult result = await State.AddAsync(profile, enableAfterAdding: true);
            if (result.Succeeded)
            {
                SetMessage("Reader added and activated.", false);
                physicalName = string.Empty;
                physicalHost = string.Empty;
            }
            else
            {
                // Pop up the full properties dialog so the user can inspect/change protocol version, port, IP
                OpenPropertiesModal(profile);
                modalErrorMessage = result.Error ?? "Could not connect to reader. Please review the parameters below.";
            }
        }
        catch (Exception exception)
        {
            OpenPropertiesModal(new ReaderProfile
            {
                Id = Guid.NewGuid(),
                Name = string.IsNullOrWhiteSpace(physicalName) ? physicalHost.Trim() : physicalName.Trim(),
                Host = physicalHost.Trim(),
                Port = physicalPort,
                LlrpVersion = LlrpProtocolVersionOption.Auto,
                IsEnabled = true,
            });
            modalErrorMessage = exception.Message;
        }
    }

    private async Task DiscoverAsync()
    {
        try
        {
            await State.DiscoverAsync(TimeSpan.FromSeconds(3));
            SetMessage($"Discovery completed: {State.DiscoveredReaders.Count} endpoint(s) found.", false);
        }
        catch (Exception exception)
        {
            SetMessage(exception.Message, true);
        }
    }

    private async Task AddDiscoveredAsync(DiscoveredReader discovered)
    {
        try
        {
            var profile = new ReaderProfile
            {
                Id = Guid.NewGuid(),
                Name = discovered.DisplayName,
                Host = discovered.IpAddress,
                Port = discovered.Port,
                LlrpVersion = LlrpProtocolVersionOption.Auto,
                IsEnabled = true,
            };

            ReaderAddResult result = await State.AddAsync(profile, enableAfterAdding: true);
            if (result.Succeeded)
            {
                SetMessage($"{discovered.DisplayName} added and activated.", false);
            }
            else
            {
                OpenPropertiesModal(profile);
                modalErrorMessage = result.Error ?? "Discovered reader connection failed.";
            }
        }
        catch (Exception exception)
        {
            modalErrorMessage = exception.Message;
            showPropertiesModal = true;
        }
    }

    private async Task StartVirtualAsync()
    {
        VirtualReaderStartResult result = await VirtualDevices.StartAsync(virtualProfileId, null, virtualPort);
        SetMessage(result.Succeeded
            ? $"Virtual Reader started on 127.0.0.1:{result.Instance!.Port} and registered."
            : result.Error ?? "Virtual Reader start failed.", !result.Succeeded);
    }

    private async Task ToggleReaderAsync(ReaderRuntimeSnapshot reader)
    {
        try
        {
            await State.SetEnabledAsync(reader.ReaderId, !reader.IsEnabled);
            SetMessage(
                reader.IsEnabled
                    ? "Reader disabled and connection released."
                    : "Reader enabled and capabilities synchronized.",
                false);
        }
        catch (Exception exception)
        {
            SetMessage(exception.Message, true);
        }
    }

    private async Task RemoveReaderAsync(Guid readerId)
    {
        try
        {
            await State.RemoveAsync(readerId);
            SetMessage("Reader removed.", false);
        }
        catch (Exception exception)
        {
            SetMessage(exception.Message, true);
        }
    }

    private async Task StopVirtualAsync(Guid readerId)
    {
        try
        {
            await VirtualDevices.StopAsync(readerId);
            SetMessage("Virtual host stopped and removed.", false);
        }
        catch (Exception exception)
        {
            SetMessage(exception.Message, true);
        }
    }

    private bool IsVirtual(Guid readerId) => VirtualDevices.CurrentInstance?.ReaderId == readerId;

    private static string ProtocolText(ReaderRuntimeSnapshot reader)
    {
        if (reader.NegotiatedProtocolVersion is not null)
        {
            return reader.NegotiatedProtocolVersion switch
            {
                LlrpProtocolVersion.Version101 => "LLRP 1.0.1",
                LlrpProtocolVersion.Version11 => "LLRP 1.1",
                LlrpProtocolVersion.Version20 => "LLRP 2.0",
                _ => $"LLRP {reader.NegotiatedProtocolVersion}",
            };
        }

        return reader.Profile.LlrpVersion switch
        {
            LlrpProtocolVersionOption.Auto => "LLRP Auto (2.0 / 1.1 / 1.0.1)",
            LlrpProtocolVersionOption.Force101 => "LLRP 1.0.1 (Force)",
            LlrpProtocolVersionOption.Force11 => "LLRP 1.1 (Force)",
            LlrpProtocolVersionOption.Force20 => "LLRP 2.0 (Force)",
            _ => "LLRP Auto",
        };
    }

    private static string StatusClass(ReaderState state) => state switch
    {
        ReaderState.Connected or ReaderState.Inventorying => "ok",
        ReaderState.Connecting or ReaderState.Stopping or ReaderState.Disconnecting => "warn",
        ReaderState.Faulted => "danger",
        _ => "neutral",
    };

    private void SetMessage(string value, bool error)
    {
        message = value;
        messageIsError = error;
    }

    private void OnChanged(object? sender, EventArgs args) => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        State.Changed -= OnChanged;
        VirtualDevices.Changed -= OnChanged;
    }
}
