@page "/settings"
@implements IDisposable
@inject ReaderManagerState State

<!-- Section Header & Toolbar -->
<div class="section-header">
    <div>
        <h1 class="section-title">Reader Settings</h1>
        <p class="section-subtitle">Capability-driven configuration synchronized directly with the reader hardware.</p>
    </div>
    <div class="toolbar">
        <label class="form-label" for="settings-reader" style="margin-left: var(--space-2);">Reader</label>
        <select id="settings-reader" style="width: min(280px, 50vw);" value="@SelectedReaderText" @onchange="SelectReader">
            <option value="">Choose Reader</option>
            @foreach (ReaderRuntimeSnapshot reader in State.Readers)
            {
                <option value="@reader.ReaderId">@reader.Profile.Name (@reader.Profile.Host:@reader.Profile.Port)</option>
            }
        </select>
    </div>
</div>

<div class="toolbar" style="margin-bottom: var(--space-3); flex-wrap: wrap; gap: var(--space-2);">
    <button class="btn btn-sm" @onclick="() => LoadAsync(false)" disabled="@(pageBusy || SelectedReader is null)">
        <AppIcon Name="rotate" Size="13" />
        <span>Refresh from Reader</span>
    </button>
    <button class="btn btn-sm" @onclick="() => LoadAsync(true)" disabled="@(pageBusy || SelectedReader is null)">
        <AppIcon Name="history" Size="13" />
        <span>Load SDK Defaults</span>
    </button>
    <span class="toolbar-spacer"></span>
    <button class="btn btn-sm btn-primary" @onclick="SaveAsync" disabled="@(pageBusy || SettingsModel is null)">
        <AppIcon Name="check" Size="13" />
        <span>Save Configuration</span>
    </button>
</div>

@if (!string.IsNullOrWhiteSpace(message))
{
    <div class="notice @(messageIsError ? "error" : "info")" style="margin-bottom: var(--space-2); padding: 6px 10px; font-size: 11.5px;">
        @message
    </div>
}

@if (SettingsModel is null)
{
    <div class="card empty-state">
        <AppIcon Name="gear" Size="36" />
        <h2>No Settings Model</h2>
        <p>Choose an activated Reader above and load its capability-driven settings.</p>
    </div>
}
else
{
    <!-- Category Navigation Tabs & Search -->
    <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: var(--space-2); margin-bottom: var(--space-3);">
        <nav class="settings-nav-tabs">
            <button type="button"
                    class="settings-nav-tab @(activeCategory == "rf" ? "active" : string.Empty)"
                    @onclick='() => SelectCategory("rf")'>
                <AppIcon Name="bolt" Size="13" />
                <span>Antennas & RF</span>
            </button>
            <button type="button"
                    class="settings-nav-tab @(activeCategory == "protocol" ? "active" : string.Empty)"
                    @onclick='() => SelectCategory("protocol")'>
                <AppIcon Name="search" Size="13" />
                <span>Inventory & Protocol</span>
            </button>
            <button type="button"
                    class="settings-nav-tab @(activeCategory == "filters" ? "active" : string.Empty)"
                    @onclick='() => SelectCategory("filters")'>
                <AppIcon Name="filter" Size="13" />
                <span>Filters & Singulation</span>
            </button>
            <button type="button"
                    class="settings-nav-tab @(activeCategory == "triggers" ? "active" : string.Empty)"
                    @onclick='() => SelectCategory("triggers")'>
                <AppIcon Name="zap" Size="13" />
                <span>Triggers & Timers</span>
            </button>
            <button type="button"
                    class="settings-nav-tab @(activeCategory == "reports" ? "active" : string.Empty)"
                    @onclick='() => SelectCategory("reports")'>
                <AppIcon Name="tags" Size="13" />
                <span>Reports & Advanced</span>
            </button>
            <button type="button"
                    class="settings-nav-tab @(activeCategory == "all" ? "active" : string.Empty)"
                    @onclick='() => SelectCategory("all")'>
                <AppIcon Name="grid" Size="13" />
                <span>All Categories</span>
            </button>
        </nav>

        <div style="width: min(220px, 100%);">
            <input type="text"
                   placeholder="Filter settings..."
                   @bind="searchTerm"
                   @bind:event="oninput"
                   style="height: 32px; font-size: 12px;" />
        </div>
    </div>

    <section class="settings-card-grid">
        @foreach (SettingsGroup group in GetFilteredGroups())
        {
            var visibleEntries = group.Entries.Where(IsEntryVisible).ToList();
            if (visibleEntries.Count == 0)
            {
                continue;
            }

            <article class="card settings-card" style="min-width: 0;">
                <div class="card-header" style="cursor: pointer; user-select: none;" @onclick="() => ToggleGroup(group.Key)">
                    <div style="min-width: 0; flex: 1;">
                        <div style="display: flex; align-items: center; gap: 8px;">
                            <AppIcon Name="@GetGroupIcon(group.Key)" Size="14" />
                            <h2 class="card-title" style="margin-bottom: 0; font-size: 13px;">@group.Title</h2>
                        </div>
                        <div class="form-hint settings-card-description" style="margin-top: 2px;">@group.Description</div>
                    </div>
                    <div style="display: flex; align-items: center; gap: 8px; flex-shrink: 0;">
                        <span class="status-badge neutral">@visibleEntries.Count</span>
                        <span class="settings-collapse-icon @(IsGroupExpanded(group.Key) ? "expanded" : string.Empty)" aria-hidden="true">
                            <AppIcon Name="chevron-down" Size="14" />
                        </span>
                    </div>
                </div>
                @if (IsGroupExpanded(group.Key))
                {
                    <div class="settings-card-body">
                    @foreach (SettingsEntry entry in visibleEntries)
                    {
                        bool isDependent = IsEntryDependent(entry);
                        <div class="setting-row @(isDependent ? "dependent" : string.Empty)">
                            <div>
                                <div class="setting-title">
                                    @if (isDependent)
                                    {
                                        <span class="muted" style="font-size: 11px; margin-right: 4px;">↳</span>
                                    }
                                    @GetCustomTitle(entry)
                                </div>
                                <div class="setting-meta">@entry.Key@(entry.IsOptional ? " · optional" : string.Empty)</div>
                            </div>
                            <div>
                                @if (entry.IsReadOnly)
                                {
                                    <div class="mono muted">@DisplayValue(entry)</div>
                                    @if (!string.IsNullOrWhiteSpace(entry.ReadOnlyReason))
                                    {
                                        <div class="form-hint">@entry.ReadOnlyReason</div>
                                    }
                                }
                                else if (entry.Key == SettingsKeys.AntennaIds)
                                {
                                    <div class="pill-selector">
                                        @foreach (ushort antId in AvailableAntennas)
                                        {
                                            bool isSelected = IsAntennaSelected(entry, antId);
                                            <button type="button"
                                                    class="pill-option @(isSelected ? "selected" : string.Empty)"
                                                    @onclick="() => ToggleAntenna(entry, antId)">
                                                <span>@(isSelected ? "✓" : "+") Ant @antId</span>
                                            </button>
                                        }
                                        <button type="button"
                                                class="btn btn-sm btn-ghost"
                                                style="padding: 2px 8px; font-size: 11px; margin-left: 4px;"
                                                @onclick="() => ToggleAllAntennas(entry)">
                                            @(IsAllAntennasSelected(entry) ? "Clear" : "Select All")
                                        </button>
                                    </div>
                                    <div class="form-hint" style="margin-top: 4px;">Click antenna pills to toggle participating inventory antennas.</div>
                                }
                                else if (entry.Key.Contains("channels", StringComparison.OrdinalIgnoreCase) && entry.Options.Count > 0)
                                {
                                    <div class="pill-selector">
                                        @foreach (SettingsOption option in entry.Options)
                                        {
                                            string optVal = OptionValue(option);
                                            bool isSelected = IsChannelSelected(entry, optVal);
                                            <button type="button"
                                                    class="pill-option @(isSelected ? "selected" : string.Empty)"
                                                    @onclick="() => ToggleChannel(entry, optVal)">
                                                <span>@(isSelected ? "✓" : "+") @(option.Display ?? optVal)</span>
                                            </button>
                                        }
                                    </div>
                                }
                                else if (entry.EditorKind == EditorKind.Boolean)
                                {
                                    <label class="check-line" style="display: flex; align-items: center; justify-content: space-between; width: 100%; cursor: pointer; min-height: 32px;">
                                        <span style="font-weight: 600; font-size: 12px; color: var(--fg);">
                                            @(entry.Key == SettingsKeys.IndividualAntennaSettings ? "Configure RF Per Antenna (展开每个天线独立功率)" : (ReadBoolean(entry) ? "Enabled (已启用)" : "Disabled (未启用)"))
                                        </span>
                                        <input type="checkbox" style="width: 20px; height: 20px; accent-color: var(--accent); cursor: pointer;" checked="@ReadBoolean(entry)" @onchange="args => ChangeValue(entry, args)" />
                                    </label>
                                }
                                else if (entry.EditorKind == EditorKind.Choice)
                                {
                                    <select value="@DisplayValue(entry)" @onchange="args => ChangeValue(entry, args)">
                                        @foreach (SettingsOption option in entry.Options)
                                        {
                                            <option value="@OptionValue(option)">@(@option.Display ?? OptionValue(option))</option>
                                        }
                                    </select>
                                }
                                else if (entry.EditorKind == EditorKind.Collection)
                                {
                                    <input type="text" value="@DisplayValue(entry)" @onchange="args => ChangeValue(entry, args)" class="mono" />
                                    <div class="form-hint">Comma separated values</div>
                                }
                                else
                                {
                                    <input type="@(entry.EditorKind is EditorKind.Integer or EditorKind.Decimal ? "number" : "text")"
                                           value="@DisplayValue(entry)"
                                           @onchange="args => ChangeValue(entry, args)"
                                           class="@(entry.EditorKind is EditorKind.Integer or EditorKind.Decimal ? "mono" : string.Empty)" />
                                }
                            </div>
                        </div>
                    }
                </div>
                }
            </article>
        }
    </section>

    <!-- Floating Save Bar for Mobile/Handheld -->
    @if (hasUnsavedChanges && !pageBusy)
    {
        <div class="floating-save-bar">
            <div style="font-size: 11.5px; font-weight: 700; color: var(--accent); display: flex; align-items: center; gap: 5px;">
                <AppIcon Name="sliders" Size="13" />
                <span>Unsaved Changes</span>
            </div>
            <div style="display: flex; gap: 6px;">
                <button class="btn btn-sm" style="height: 30px; font-size: 11px;" @onclick="() => LoadAsync(false)">Discard</button>
                <button class="btn btn-sm btn-primary" style="height: 30px; font-size: 11px; font-weight: 700;" @onclick="SaveAsync">
                    <AppIcon Name="check" Size="11" />
                    <span>Save</span>
                </button>
            </div>
        </div>
    }
}

@code {
    private SettingsEditorModel? SettingsModel;
    private string? selectedReaderText;
    private Guid? lastLoadedReaderId;
    private Dictionary<string, object?> values = new(StringComparer.Ordinal);
    private string? message;
    private bool messageIsError;
    private bool pageBusy;
    private bool hasUnsavedChanges;

    private string activeCategory = "rf";
    private string searchTerm = string.Empty;
    private readonly HashSet<string> expandedGroups = new(StringComparer.OrdinalIgnoreCase) { "rf" };

    private bool IsGroupExpanded(string key) =>
        !string.IsNullOrWhiteSpace(searchTerm) || expandedGroups.Contains(key);

    private void ToggleGroup(string key)
    {
        if (expandedGroups.Contains(key))
        {
            expandedGroups.Remove(key);
        }
        else
        {
            expandedGroups.Add(key);
        }
    }

    private void SelectCategory(string category)
    {
        activeCategory = category;
        IReadOnlyList<string> categoryGroups = category switch
        {
            "rf" => new[] { SettingsGroups.Power, SettingsGroups.Antenna },
            "protocol" => new[] { SettingsGroups.Manual, SettingsGroups.Frequency },
            "filters" => new[] { SettingsGroups.Filter, SettingsGroups.StateAware },
            "triggers" => new[] { SettingsGroups.Gpi, SettingsGroups.LowDuty },
            "reports" => new[] { SettingsGroups.Report, SettingsGroups.Other },
            _ => Array.Empty<string>(),
        };

        foreach (string key in categoryGroups)
        {
            expandedGroups.Add(key);
        }
    }

    private string SelectedReaderText => selectedReaderText ?? State.SelectedReaderId?.ToString() ?? string.Empty;
    private ReaderRuntimeSnapshot? SelectedReader => State.Find(ParseReaderId(SelectedReaderText));

    private IReadOnlyList<ushort> AvailableAntennas =>
        SelectedReader?.Antennas.Count > 0
            ? SelectedReader.Antennas.Select(a => a.AntennaId).OrderBy(a => a).ToList()
            : [1, 2, 3, 4];

    protected override async Task OnInitializedAsync()
    {
        State.Changed += OnChanged;
        await State.InitializeAsync();
        if (State.SelectedReaderId is null)
        {
            State.Select(State.Readers.FirstOrDefault()?.ReaderId);
        }

        selectedReaderText = State.SelectedReaderId?.ToString();
        await LoadAsync(false);
    }

    private async Task SelectReader(ChangeEventArgs args)
    {
        selectedReaderText = args.Value?.ToString();
        Guid? readerId = ParseReaderId(selectedReaderText);
        State.Select(readerId);
        await LoadAsync(false);
    }

    private async Task LoadAsync(bool defaults)
    {
        if (SelectedReader is not { } reader)
        {
            SettingsModel = null;
            values.Clear();
            lastLoadedReaderId = null;
            await InvokeAsync(StateHasChanged);
            return;
        }

        if (pageBusy)
        {
            return;
        }

        pageBusy = true;
        message = null;
        try
        {
            lastLoadedReaderId = reader.ReaderId;
            selectedReaderText = reader.ReaderId.ToString();
            SettingsModel = defaults
                ? await State.Settings.GetDefaultsAsync(reader.ReaderId)
                : await State.Settings.QueryAsync(reader.ReaderId);
            values = SettingsModel.Snapshot.Values.ToDictionary(pair => pair.Key, pair => pair.Value, StringComparer.Ordinal);
            message = defaults ? "SDK defaults loaded." : "Reader settings refreshed.";
            messageIsError = false;
            hasUnsavedChanges = false;
        }
        catch (Exception exception)
        {
            message = exception.Message;
            messageIsError = true;
        }
        finally
        {
            pageBusy = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task SaveAsync()
    {
        if (SelectedReader is not { } reader || SettingsModel is null || pageBusy)
        {
            return;
        }

        pageBusy = true;
        try
        {
            var draft = new SettingsDraft
            {
                ReaderId = reader.ReaderId,
                CapabilityRevision = SettingsModel.Snapshot.CapabilityRevision,
            };
            foreach ((string key, object? value) in values)
            {
                if (value is not null)
                {
                    draft.Values[key] = value;
                }
            }

            SettingsValidationResult validation = State.Settings.Validate(draft);
            if (!validation.IsValid)
            {
                message = string.Join(" ", validation.Issues.Select(issue => $"{issue.Key}: {issue.Message}"));
                messageIsError = true;
                return;
            }

            SettingsApplyResult result = await State.Settings.ApplyAsync(reader.ReaderId, draft);
            message = result.Succeeded ? "Settings saved and reread from Reader." : result.Error ?? "Settings save failed.";
            messageIsError = !result.Succeeded;
            if (result.Succeeded)
            {
                hasUnsavedChanges = false;
                await LoadAsync(false);
            }
        }
        catch (Exception exception)
        {
            message = exception.Message;
            messageIsError = true;
        }
        finally
        {
            pageBusy = false;
        }
    }

    private void ChangeValue(SettingsEntry entry, ChangeEventArgs args)
    {
        object? value = ParseValue(entry, args.Value);
        values[entry.Key] = value;
        hasUnsavedChanges = true;
    }

    private bool ReadBoolean(SettingsEntry entry) => ReadBooleanByKey(entry.Key);

    private bool ReadBooleanByKey(string key) => values.TryGetValue(key, out object? value)
        && value is bool boolean && boolean;

    private string DisplayValue(SettingsEntry entry) => values.TryGetValue(entry.Key, out object? value)
        ? Convert.ToString(value, CultureInfo.InvariantCulture) ?? string.Empty
        : Convert.ToString(entry.CurrentValue, CultureInfo.InvariantCulture) ?? string.Empty;

    private static string OptionValue(SettingsOption option) => Convert.ToString(option.Value, CultureInfo.InvariantCulture) ?? string.Empty;

    private static object? ParseValue(SettingsEntry entry, object? raw)
    {
        string text = Convert.ToString(raw, CultureInfo.InvariantCulture) ?? string.Empty;
        if (entry.ValueType == typeof(bool))
        {
            return raw is bool boolean ? boolean : bool.TryParse(text, out bool parsed) && parsed;
        }

        if (entry.ValueType == typeof(ushort))
        {
            return ushort.TryParse(text, NumberStyles.Integer, CultureInfo.InvariantCulture, out ushort parsed) ? parsed : raw;
        }

        if (entry.ValueType == typeof(int))
        {
            return int.TryParse(text, NumberStyles.Integer, CultureInfo.InvariantCulture, out int parsed) ? parsed : raw;
        }

        if (entry.ValueType == typeof(decimal))
        {
            return decimal.TryParse(text, NumberStyles.Number, CultureInfo.InvariantCulture, out decimal parsed) ? parsed : raw;
        }

        return text;
    }

    private bool HasAntennaIdsEntry() => SettingsModel?.Layout.Entries.Any(e => e.Key == SettingsKeys.AntennaIds) ?? false;

    private bool IsIndividualAntennaEnabled() => ReadBooleanByKey(SettingsKeys.IndividualAntennaSettings);

    private bool IsFixedFrequencyEnabled()
    {
        if (values.TryGetValue(SettingsSemantics.FixedFrequency, out object? val))
        {
            if (val is bool b) return b;
            string str = Convert.ToString(val, CultureInfo.InvariantCulture) ?? string.Empty;
            return bool.TryParse(str, out bool parsed) && parsed;
        }

        foreach (var pair in values)
        {
            if (pair.Key.Contains("fixed-frequency", StringComparison.OrdinalIgnoreCase) && pair.Key != SettingsSemantics.FixedFrequencyChannels)
            {
                if (pair.Value is bool b) return b;
                string s = Convert.ToString(pair.Value, CultureInfo.InvariantCulture) ?? string.Empty;
                if (bool.TryParse(s, out bool p)) return p;
                if (s.Equals("Fixed", StringComparison.OrdinalIgnoreCase) || s.Equals("1", StringComparison.OrdinalIgnoreCase)) return true;
            }
        }

        return false;
    }

    private bool IsLowDutyEnabled()
    {
        if (values.TryGetValue(SettingsSemantics.LowDutyCycle, out object? val))
        {
            if (val is bool b) return b;
            string str = Convert.ToString(val, CultureInfo.InvariantCulture) ?? string.Empty;
            return bool.TryParse(str, out bool parsed) && parsed;
        }
        return false;
    }

    private bool IsEntryVisible(SettingsEntry entry)
    {
        if (!string.IsNullOrWhiteSpace(searchTerm))
        {
            return entry.Title.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)
                || entry.Key.Contains(searchTerm, StringComparison.OrdinalIgnoreCase);
        }

        // Standard antenna redundancy
        if (entry.Key == SettingsKeys.Antenna && HasAntennaIdsEntry())
        {
            return false;
        }

        // Per-antenna RF settings: ONLY visible when IndividualAntennaSettings is checked
        if (entry.Key.StartsWith("antenna-", StringComparison.Ordinal)
            && entry.Key != SettingsKeys.AntennaIds
            && entry.Key != SettingsKeys.IndividualAntennaSettings)
        {
            return IsIndividualAntennaEnabled();
        }

        // Frequency channels list: ONLY visible when FixedFrequency is enabled
        if (entry.Key.Contains("channels", StringComparison.OrdinalIgnoreCase) || entry.Key == SettingsSemantics.FixedFrequencyChannels)
        {
            return IsFixedFrequencyEnabled();
        }

        // Filter 1 & Filter 2 sub-fields
        if (entry.Key.StartsWith("filter-1-", StringComparison.Ordinal) && entry.Key != SettingsKeys.FilterEnabled(1))
        {
            return ReadBooleanByKey(SettingsKeys.FilterEnabled(1));
        }

        if (entry.Key.StartsWith("filter-2-", StringComparison.Ordinal) && entry.Key != SettingsKeys.FilterEnabled(2))
        {
            return ReadBooleanByKey(SettingsKeys.FilterEnabled(2));
        }

        // State-Aware sub-fields
        if (entry.Key is SettingsKeys.StateAwareTarget or SettingsKeys.StateAwareSelectedFlag)
        {
            return ReadBooleanByKey(SettingsKeys.StateAwareFiltersEnabled);
        }

        // Low Duty sub-fields
        if (entry.Key is SettingsSemantics.EmptyFieldTimeout or SettingsSemantics.FieldPingInterval
            || entry.Key.Contains("empty-field-timeout", StringComparison.OrdinalIgnoreCase)
            || entry.Key.Contains("field-ping-interval", StringComparison.OrdinalIgnoreCase))
        {
            return IsLowDutyEnabled();
        }

        // Start / Stop GPI sub-fields
        if (entry.Key is SettingsKeys.StartGpiPort or SettingsKeys.StartGpiLevel)
        {
            return ReadBooleanByKey(SettingsKeys.StartGpiEnabled);
        }

        if (entry.Key is SettingsKeys.StopGpiPort or SettingsKeys.StopGpiLevel or SettingsKeys.StopGpiTimeoutMs)
        {
            return ReadBooleanByKey(SettingsKeys.StopGpiEnabled);
        }

        return true;
    }

    private static bool IsEntryDependent(SettingsEntry entry)
    {
        string key = entry.Key;
        if (key.StartsWith("antenna-", StringComparison.Ordinal)
            && key != SettingsKeys.AntennaIds
            && key != SettingsKeys.IndividualAntennaSettings)
        {
            return true;
        }

        if (key.Contains("channels", StringComparison.OrdinalIgnoreCase) || key == SettingsSemantics.FixedFrequencyChannels)
        {
            return true;
        }

        if (key.StartsWith("filter-1-", StringComparison.Ordinal) && key != SettingsKeys.FilterEnabled(1))
        {
            return true;
        }

        if (key.StartsWith("filter-2-", StringComparison.Ordinal) && key != SettingsKeys.FilterEnabled(2))
        {
            return true;
        }

        if (key is SettingsKeys.StateAwareTarget or SettingsKeys.StateAwareSelectedFlag)
        {
            return true;
        }

        if (key is SettingsSemantics.EmptyFieldTimeout or SettingsSemantics.FieldPingInterval
            || key.Contains("empty-field-timeout", StringComparison.OrdinalIgnoreCase)
            || key.Contains("field-ping-interval", StringComparison.OrdinalIgnoreCase))
        {
            return true;
        }

        if (key is SettingsKeys.StartGpiPort or SettingsKeys.StartGpiLevel or SettingsKeys.StopGpiPort or SettingsKeys.StopGpiLevel or SettingsKeys.StopGpiTimeoutMs)
        {
            return true;
        }

        return false;
    }

    private bool IsAntennaSelected(SettingsEntry entry, ushort antennaId)
    {
        string current = DisplayValue(entry);
        var parts = current.Split([',', ' '], StringSplitOptions.RemoveEmptyEntries);
        return parts.Contains(antennaId.ToString(CultureInfo.InvariantCulture));
    }

    private void ToggleAntenna(SettingsEntry entry, ushort antennaId)
    {
        string current = DisplayValue(entry);
        var parts = current.Split([',', ' '], StringSplitOptions.RemoveEmptyEntries).ToList();
        string idStr = antennaId.ToString(CultureInfo.InvariantCulture);
        if (parts.Contains(idStr))
        {
            parts.Remove(idStr);
        }
        else
        {
            parts.Add(idStr);
        }
        values[entry.Key] = string.Join(", ", parts.OrderBy(p => ushort.TryParse(p, out ushort u) ? u : 0));
        hasUnsavedChanges = true;
    }

    private bool IsAllAntennasSelected(SettingsEntry entry) =>
        AvailableAntennas.All(ant => IsAntennaSelected(entry, ant));

    private void ToggleAllAntennas(SettingsEntry entry)
    {
        if (IsAllAntennasSelected(entry))
        {
            values[entry.Key] = string.Empty;
        }
        else
        {
            values[entry.Key] = string.Join(", ", AvailableAntennas);
        }
        hasUnsavedChanges = true;
    }

    private bool IsChannelSelected(SettingsEntry entry, string channel)
    {
        string current = DisplayValue(entry);
        var parts = current.Split([',', ' '], StringSplitOptions.RemoveEmptyEntries);
        return parts.Contains(channel);
    }

    private void ToggleChannel(SettingsEntry entry, string channel)
    {
        string current = DisplayValue(entry);
        var parts = current.Split([',', ' '], StringSplitOptions.RemoveEmptyEntries).ToList();
        if (parts.Contains(channel))
        {
            parts.Remove(channel);
        }
        else
        {
            parts.Add(channel);
        }
        values[entry.Key] = string.Join(", ", parts);
        hasUnsavedChanges = true;
    }

    private static string GetCustomTitle(SettingsEntry entry)
    {
        if (entry.Key == SettingsKeys.Antenna)
        {
            return "Default AISpec Antenna (0 = Global)";
        }
        if (entry.Key == SettingsKeys.AntennaIds)
        {
            return "Participating Antennas (寻卡天线)";
        }
        if (entry.Key == SettingsKeys.IndividualAntennaSettings)
        {
            return "Per-Antenna RF Configuration (每个天线独立设置)";
        }
        return entry.Title;
    }

    private IEnumerable<SettingsGroup> GetFilteredGroups()
    {
        var allGroups = BuildSettingsGroups();
        if (activeCategory == "all" || !string.IsNullOrWhiteSpace(searchTerm))
        {
            return allGroups;
        }

        return activeCategory switch
        {
            "rf" => allGroups.Where(g => g.Key is SettingsGroups.Power or SettingsGroups.Antenna),
            "protocol" => allGroups.Where(g => g.Key is SettingsGroups.Manual or SettingsGroups.Frequency),
            "filters" => allGroups.Where(g => g.Key is SettingsGroups.Filter or SettingsGroups.StateAware),
            "triggers" => allGroups.Where(g => g.Key is SettingsGroups.Gpi or SettingsGroups.LowDuty),
            "reports" => allGroups.Where(g => g.Key is SettingsGroups.Report or SettingsGroups.Other),
            _ => allGroups,
        };
    }

    private static string GetGroupIcon(string key) => key switch
    {
        SettingsGroups.Power => "bolt",
        SettingsGroups.Antenna => "satellite-dish",
        SettingsGroups.Manual => "search",
        SettingsGroups.Frequency => "rotate",
        SettingsGroups.Filter => "filter",
        SettingsGroups.StateAware => "microchip",
        SettingsGroups.Gpi => "zap",
        SettingsGroups.LowDuty => "history",
        SettingsGroups.Report => "tags",
        _ => "gear",
    };

    private static Guid? ParseReaderId(string? value) => Guid.TryParse(value, out Guid id) ? id : null;

    private IReadOnlyList<SettingsGroup> BuildSettingsGroups() => SettingsModel?.Layout.Entries
        .GroupBy(ResolveGroupKey, StringComparer.Ordinal)
        .OrderBy(group => GroupOrder(group.Key))
        .Select(group => new SettingsGroup(
            group.Key,
            GroupTitle(group.Key),
            GroupDescription(group.Key),
            group.ToArray()))
        .ToArray()
        ?? [];

    private static string ResolveGroupKey(SettingsEntry entry)
    {
        if (!string.IsNullOrWhiteSpace(entry.GroupKey))
        {
            return entry.GroupKey;
        }

        string key = entry.Key;
        if (key.StartsWith("filter-", StringComparison.Ordinal))
        {
            return SettingsGroups.Filter;
        }

        if (key.StartsWith("state-aware-", StringComparison.Ordinal))
        {
            return SettingsGroups.StateAware;
        }

        if (key.StartsWith("start-gpi-", StringComparison.Ordinal)
            || key.StartsWith("stop-gpi-", StringComparison.Ordinal)
            || key.Contains("gpi-debounce-ms.", StringComparison.Ordinal))
        {
            return SettingsGroups.Gpi;
        }

        if (key.Contains("fixed-frequency-", StringComparison.Ordinal) || key.Contains("frequency-channel", StringComparison.Ordinal))
        {
            return SettingsGroups.Frequency;
        }

        if (key.Contains("low-duty-cycle", StringComparison.Ordinal)
            || key.Contains("empty-field-timeout-ms", StringComparison.Ordinal)
            || key.Contains("field-ping-interval-ms", StringComparison.Ordinal))
        {
            return SettingsGroups.LowDuty;
        }

        if (key.StartsWith("report-", StringComparison.Ordinal))
        {
            return SettingsGroups.Report;
        }

        if (key is SettingsKeys.TxPowerIndex
            or SettingsKeys.RxSensitivityIndex
            or SettingsKeys.AntennaIds
            or SettingsKeys.IndividualAntennaSettings)
        {
            return SettingsGroups.Power;
        }

        if (key.StartsWith("antenna-", StringComparison.Ordinal))
        {
            return SettingsGroups.Antenna;
        }

        if (key is SettingsKeys.Antenna
            or SettingsKeys.Session
            or SettingsKeys.TagPopulation
            or SettingsKeys.ReportEvery
            or SettingsKeys.RfMode
            or SettingsKeys.Tari)
        {
            return SettingsGroups.Manual;
        }

        return SettingsGroups.Other;
    }

    private static int GroupOrder(string key) => key switch
    {
        SettingsGroups.Power => 0,
        SettingsGroups.Antenna => 1,
        SettingsGroups.Manual => 2,
        SettingsGroups.Frequency => 3,
        SettingsGroups.Filter => 4,
        SettingsGroups.StateAware => 5,
        SettingsGroups.Gpi => 6,
        SettingsGroups.LowDuty => 7,
        SettingsGroups.Report => 8,
        _ => 9,
    };

    private static string GroupTitle(string key) => key switch
    {
        SettingsGroups.Power => "Power & Antenna Selection",
        SettingsGroups.Antenna => "Per-Antenna RF Configuration",
        SettingsGroups.Manual => "Inventory & RF Protocol",
        SettingsGroups.Frequency => "Frequency & Hop Channels",
        SettingsGroups.Filter => "Tag Filters & Singulation",
        SettingsGroups.StateAware => "State-Aware Inventory",
        SettingsGroups.Gpi => "GPI Triggers & Debounce",
        SettingsGroups.LowDuty => "Low-Duty Cycle Timing",
        SettingsGroups.Report => "Tag Report Fields",
        _ => "Vendor & Capabilities",
    };

    private static string GroupDescription(string key) => key switch
    {
        SettingsGroups.Power => "Participating antenna selection, default Tx power and Rx sensitivity.",
        SettingsGroups.Antenna => "Specific Tx power and Rx sensitivity per antenna port.",
        SettingsGroups.Manual => "Session, inventory behavior, tag population and air-protocol parameters.",
        SettingsGroups.Frequency => "Channel list and hop table frequency configuration.",
        SettingsGroups.Filter => "EPC, TID, user-memory match filters and action masks.",
        SettingsGroups.StateAware => "State target and selected-flag singulation behavior.",
        SettingsGroups.Gpi => "Hardware GPI start/stop trigger conditions and debounce timings.",
        SettingsGroups.LowDuty => "Reader idle and field ping timing controls.",
        SettingsGroups.Report => "Fields and metadata requested in tag inventory reports.",
        _ => "Additional capability-driven Reader parameters.",
    };

    private sealed record SettingsGroup(
        string Key,
        string Title,
        string Description,
        IReadOnlyList<SettingsEntry> Entries);

    private async void OnChanged(object? sender, EventArgs args)
    {
        Guid? current = State.SelectedReaderId;
        if (current != lastLoadedReaderId)
        {
            selectedReaderText = current?.ToString();
            await LoadAsync(false);
        }
        else
        {
            await InvokeAsync(StateHasChanged);
        }
    }

    public void Dispose() => State.Changed -= OnChanged;
}
