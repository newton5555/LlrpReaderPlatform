@page "/gpio"
@implements IDisposable
@inject ReaderManagerState State

<div class="section-header">
    <div>
        <h1 class="section-title">GPI / GPO Control</h1>
        <p class="section-subtitle">Read live digital input status and trigger standard LLRP output ports through platform services.</p>
    </div>
    <div class="toolbar">
        <label class="form-label" for="gpio-reader">Reader</label>
        <select id="gpio-reader" style="width: min(280px, 50vw);" value="@SelectedReaderText" @onchange="SelectReader">
            <option value="">Choose Reader</option>
            @foreach (ReaderRuntimeSnapshot reader in State.Readers)
            {
                <option value="@reader.ReaderId">@reader.Profile.Name (@reader.Profile.Host:@reader.Profile.Port)</option>
            }
        </select>
        <button class="btn btn-sm" @onclick="LoadAsync" disabled="@(pageBusy || SelectedReader is null)">
            <AppIcon Name="rotate" Size="13" />
            <span>Refresh</span>
        </button>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(message))
{
    <div class="notice @(messageIsError ? "error" : "info")" style="margin-bottom: var(--space-4);">@message</div>
}

@if (SelectedReader is null)
{
    <div class="card empty-state">
        <AppIcon Name="bolt" Size="36" />
        <h2>Select a Reader</h2>
        <p>GPI/GPO uses short-operation leases. Inventory must be stopped before querying or toggling ports.</p>
    </div>
}
else
{
    <!-- Port Telemetry Stats -->
    <div class="card-grid" style="margin-bottom: var(--space-4);">
        <div class="card card-pad">
            <div class="stat-label">GPI Digital Inputs</div>
            <div class="stat-value">@(snapshot?.Gpis.Count ?? 0)</div>
            <div class="stat-note">@(snapshot?.Gpis.Count(p => p.State) ?? 0) currently Active (High)</div>
        </div>
        <div class="card card-pad">
            <div class="stat-label">GPO Digital Outputs</div>
            <div class="stat-value">@(snapshot?.Gpos.Count ?? 0)</div>
            <div class="stat-note">@(snapshot?.Gpos.Count(p => p.State) ?? 0) currently Active (High)</div>
        </div>
        <div class="card card-pad">
            <div class="stat-label">Reader Lease State</div>
            <div class="stat-value" style="font-size: 20px; line-height: 34px;">@SelectedReader.State</div>
            <div class="stat-note">Short-operation lease available</div>
        </div>
    </div>

    <div class="split">
        <!-- Left: GPI Inputs Table -->
        <section class="card">
            <div class="card-header">
                <span class="card-title">
                    <AppIcon Name="bolt" Size="14" />
                    <span>GPI Digital Inputs</span>
                </span>
                <span class="status-badge neutral">Reader Reported</span>
            </div>
            @if (snapshot?.Gpis.Count is not > 0)
            {
                <div class="card-pad muted" style="font-size: 12.5px;">No GPI status has been loaded, or this Reader has no standard GPI ports.</div>
            }
            else
            {
                <div class="table-wrap">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Port</th>
                                <th>Configured</th>
                                <th>Logic State</th>
                                <th>Last Timestamp</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (GpiPortStatus port in snapshot!.Gpis)
                            {
                                <tr>
                                    <td class="mono" style="font-weight: 600;">Port @port.PortNumber</td>
                                    <td>@(port.Configured ? "Configured" : "Unconfigured")</td>
                                    <td>
                                        <span class="status-badge @(port.State ? "ok" : "neutral")">
                                            @(port.State ? "HIGH (ON)" : "LOW (OFF)")
                                        </span>
                                    </td>
                                    <td class="mono">@(port.Timestamp?.ToLocalTime().ToString("HH:mm:ss.fff") ?? "—")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>

        <!-- Right: GPO Outputs Controls -->
        <section class="card">
            <div class="card-header">
                <span class="card-title">
                    <AppIcon Name="zap" Size="14" />
                    <span>GPO Digital Outputs</span>
                </span>
                <span class="status-badge neutral">Command Target</span>
            </div>
            @if (snapshot?.Gpos.Count is not > 0)
            {
                <div class="card-pad muted" style="font-size: 12.5px;">No GPO status has been loaded, or this Reader has no standard GPO ports.</div>
            }
            else
            {
                <div class="gpo-grid" style="padding: var(--space-4);">
                    @foreach (GpoPortStatus port in snapshot!.Gpos)
                    {
                        <div class="gpo-card @(port.State ? "active" : string.Empty)">
                            <div class="gpo-card-head">
                                <strong style="font-size: 13px;">GPO Port @port.PortNumber</strong>
                                <span class="status-badge @(port.State ? "ok" : "neutral")">@(port.State ? "HIGH (ON)" : "LOW (OFF)")</span>
                            </div>
                            <div class="form-hint" style="font-size: 11px;">
                                @(port.State ? "Digital output active (High)" : "Digital output idle (Low)")
                            </div>
                            <button class="btn btn-sm @(port.State ? "btn-danger" : "btn-primary")"
                                    style="width: 100%; margin-top: 4px;"
                                    @onclick="() => SetGpoAsync(port)"
                                    disabled="@pageBusy">
                                <AppIcon Name="zap" Size="12" />
                                <span>@(port.State ? "Turn OFF" : "Turn ON")</span>
                            </button>
                        </div>
                    }
                </div>
            }
        </section>
    </div>
}

@code {
    private string? selectedReaderText;
    private GpioStatusSnapshot? snapshot;
    private string? message;
    private bool messageIsError;
    private bool pageBusy;

    private string SelectedReaderText => selectedReaderText ?? State.SelectedReaderId?.ToString() ?? string.Empty;
    private ReaderRuntimeSnapshot? SelectedReader => State.Find(ParseReaderId(SelectedReaderText));

    protected override async Task OnInitializedAsync()
    {
        State.Changed += OnChanged;
        State.Inventory.GpiChanged += OnGpiChanged;
        await State.InitializeAsync();
        if (State.SelectedReaderId is null)
        {
            State.Select(State.Readers.FirstOrDefault()?.ReaderId);
        }

        selectedReaderText = State.SelectedReaderId?.ToString();
        if (SelectedReader is not null)
        {
            await LoadAsync();
        }
    }

    private void SelectReader(ChangeEventArgs args)
    {
        selectedReaderText = args.Value?.ToString();
        State.Select(ParseReaderId(selectedReaderText));
        _ = LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (SelectedReader is not { } reader || pageBusy)
        {
            return;
        }

        pageBusy = true;
        message = null;
        try
        {
            snapshot = await State.GetGpioStatusAsync(reader.ReaderId);
        }
        catch (Exception exception)
        {
            SetMessage(exception.Message, true);
        }
        finally
        {
            pageBusy = false;
        }
    }

    private async Task SetGpoAsync(GpoPortStatus port)
    {
        if (SelectedReader is not { } reader || pageBusy)
        {
            return;
        }

        pageBusy = true;
        message = null;
        try
        {
            bool targetState = !port.State;
            await State.SetGpoAsync(reader.ReaderId, port.PortNumber, targetState);
            SetMessage($"GPO {port.PortNumber} set to {(targetState ? "HIGH" : "LOW")}.", false);
            await LoadAsync();
        }
        catch (Exception exception)
        {
            SetMessage(exception.Message, true);
        }
        finally
        {
            pageBusy = false;
        }
    }

    private void SetMessage(string value, bool error)
    {
        message = value;
        messageIsError = error;
    }

    private static Guid? ParseReaderId(string? value) => Guid.TryParse(value, out Guid id) ? id : null;

    private void OnChanged(object? sender, EventArgs args) => InvokeAsync(StateHasChanged);

    private void OnGpiChanged(object? sender, GpiObservedEventArgs @event)
    {
        if (SelectedReader is not null && @event.ReaderId == SelectedReader.ReaderId)
        {
            _ = LoadAsync();
        }
    }

    public void Dispose()
    {
        State.Changed -= OnChanged;
        State.Inventory.GpiChanged -= OnGpiChanged;
    }
}
