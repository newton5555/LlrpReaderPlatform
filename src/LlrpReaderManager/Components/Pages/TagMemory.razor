@page "/tag-memory"
@implements IDisposable
@inject ReaderManagerState State

<div class="section-header">
    <div>
        <h1 class="section-title">Tag Operations</h1>
        <p class="section-subtitle">Targeted C1G2 Read and Write memory operations with live visual memory map.</p>
    </div>
    <div class="toolbar">
        <label class="check-line" style="margin-bottom: 0; font-size: 12.5px; cursor: pointer;" title="Automatically switch execution reader based on selected tag">
            <input type="checkbox" @bind="autoSelectReader" />
            <span>Auto-select Reader</span>
        </label>
        <label class="form-label" for="tag-memory-reader" style="margin-left: var(--space-2);">Reader</label>
        <select id="tag-memory-reader" style="width: min(260px, 45vw);" value="@SelectedReaderText" @onchange="SelectReader" disabled="@(autoSelectReader && selectedTagRef is not null)">
            <option value="">Choose Reader</option>
            @foreach (ReaderRuntimeSnapshot reader in State.Readers)
            {
                <option value="@reader.ReaderId">@reader.Profile.Name (@reader.Profile.Host:@reader.Profile.Port)</option>
            }
        </select>
    </div>
</div>

<!-- Mobile-Only Tab Switcher (Active on Handheld/Phone screens <= 768px) -->
<div class="tag-memory-mobile-tabs">
    <button type="button"
            class="btn btn-sm @(mobileTab == "tags" ? "btn-primary" : "btn-ghost")"
            style="flex: 1; height: 34px; font-size: 12px; font-weight: 700; border-radius: var(--radius-sm); justify-content: center;"
            @onclick='() => mobileTab = "tags"'>
        <AppIcon Name="tags" Size="13" />
        <span>Observed Tags (@FilteredTags.Count)</span>
    </button>
    <button type="button"
            class="btn btn-sm @(mobileTab == "ops" ? "btn-primary" : "btn-ghost")"
            style="flex: 1; height: 34px; font-size: 12px; font-weight: 700; border-radius: var(--radius-sm); justify-content: center;"
            @onclick='() => mobileTab = "ops"'>
        <AppIcon Name="microchip" Size="13" />
        <span>Operations & Map</span>
    </button>
</div>

@if (EffectiveReader is null && State.Readers.Count == 0)
{
    <div class="card empty-state">
        <AppIcon Name="microchip" Size="36" />
        <h2>No Reader Available</h2>
        <p>Please connect or activate a Reader first before performing tag memory access operations.</p>
        <a class="btn btn-primary" href="/readers" style="margin-top: var(--space-2);">Open Readers</a>
    </div>
}
else
{
    <div class="access-layout @(mobileTab == "tags" ? "mobile-tab-tags" : "mobile-tab-ops")">
        <!-- Left: Observed Tags Selector -->
        <div class="tag-selector">
            <div class="tag-selector-header">
                <span class="card-title" style="font-size: 12px;">Observed Tags</span>
                <span class="tag-count-label">@FilteredTags.Count tags</span>
            </div>
            <div style="padding: 0 var(--space-3) var(--space-2) var(--space-3);">
                <input type="text" placeholder="Filter EPC / TID..." @bind="searchText" @bind:event="oninput" style="height: 32px; font-size: 12px;" />
            </div>
            <div class="tag-list">
                @if (FilteredTags.Count == 0)
                {
                    <div class="empty-state" style="padding: var(--space-4); min-height: 120px;">
                        <span class="muted" style="font-size: 11.5px;">No tags observed in inventory.</span>
                    </div>
                }
                @foreach (TagSourceItem item in FilteredTags)
                {
                    bool isSelected = selectedTagRef is not null &&
                                      ((selectionBank == TagMemoryBank.Epc && targetHex.Equals(item.Tag.Epc, StringComparison.OrdinalIgnoreCase)) ||
                                       (selectionBank == TagMemoryBank.Tid && !string.IsNullOrWhiteSpace(item.Tag.Tid) && targetHex.Equals(item.Tag.Tid, StringComparison.OrdinalIgnoreCase)));
                    <button type="button" class="tag-list-item @(isSelected ? "selected" : string.Empty)"
                            @onclick="() => SelectTag(item)">
                        <div class="tag-list-item-epc">@item.Tag.Epc</div>
                        @if (!string.IsNullOrWhiteSpace(item.Tag.Tid))
                        {
                            <div class="mono muted" style="font-size: 10.5px; overflow: hidden; text-overflow: ellipsis;">TID: @item.Tag.Tid</div>
                        }
                        <div class="tag-list-item-meta">
                            <span class="status-badge neutral" style="font-size: 9.5px; padding: 1px 4px;">@item.ReaderName</span>
                            <span>Ant @(item.Tag.LastAntenna?.ToString() ?? "—")</span>
                            <span>·</span>
                            <span>@(item.Tag.LastRssi?.ToString("0.0") ?? "—") dBm</span>
                            <span>·</span>
                            <span>seen @item.Tag.ReadCount</span>
                        </div>
                    </button>
                }
            </div>
        </div>

        <!-- Right: Operations Panel -->
        <div class="operations-panel">
            <!-- Mobile Target Banner -->
            @if (selectedTagRef is not null)
            {
                <div class="target-tag-banner mobile-only" style="margin-bottom: var(--space-2);">
                    <div class="target-tag-banner-left">
                        <span class="target-tag-label">Selected Target EPC</span>
                        <span class="mono target-tag-epc">@targetHex</span>
                    </div>
                    <button type="button" class="btn btn-sm btn-ghost" style="height: 28px; padding: 0 8px; font-size: 11px;" @onclick='() => mobileTab = "tags"'>
                        <AppIcon Name="tags" Size="11" />
                        <span>Switch Tag</span>
                    </button>
                </div>
            }

            <!-- Target Tag Specification Card -->
            <div class="card selected-tag-card">
                <div class="card-header" style="padding: var(--space-2) var(--space-4); background: var(--surface-raised);">
                    <div style="display: flex; align-items: center; gap: 8px;">
                        <AppIcon Name="tags" Size="13" />
                        <span class="card-title" style="font-size: 12.5px;">Target Tag Specification</span>
                    </div>
                    @if (EffectiveReader is not null)
                    {
                        <span class="status-badge @(EffectiveReader.IsEnabled ? "ok" : "warn")">
                            Targeting: @EffectiveReader.Profile.Name (@EffectiveReader.Profile.Host:@EffectiveReader.Profile.Port)
                        </span>
                    }
                </div>
                <div class="card-pad stack" style="gap: var(--space-3);">
                    <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: var(--space-3);">
                        <div class="form-group" style="min-width: 170px;">
                            <label class="form-label">Match Target Bank</label>
                            <div class="bank-tabs">
                                <button type="button"
                                        class="bank-tab @(selectionBank == TagMemoryBank.Epc ? "active" : string.Empty)"
                                        @onclick="() => SetSelectionBank(TagMemoryBank.Epc)"
                                        disabled="@pageBusy">
                                    EPC
                                </button>
                                <button type="button"
                                        class="bank-tab @(selectionBank == TagMemoryBank.Tid ? "active" : string.Empty)"
                                        @onclick="() => SetSelectionBank(TagMemoryBank.Tid)"
                                        disabled="@pageBusy">
                                    TID
                                </button>
                            </div>
                        </div>

                        <div class="form-group" style="flex: 1; min-width: 240px;">
                            <label class="form-label">Target @(selectionBank == TagMemoryBank.Epc ? "EPC" : "TID") Hex Data</label>
                            <input type="text"
                                   value="@targetHex"
                                   @oninput="OnTargetHexInput"
                                   placeholder="Enter target hexadecimal pattern (e.g. E2801160...)"
                                   class="mono"
                                   disabled="@pageBusy" />
                        </div>
                    </div>
                </div>
            </div>

            <!-- Read Memory Card -->
            <div class="op-card">
                <div class="op-card-header">
                    <span class="op-card-title">
                        <AppIcon Name="read" Size="15" />
                        <span>Read Memory</span>
                    </span>
                    <button class="btn btn-sm btn-primary" @onclick="ReadAsync" disabled="@(pageBusy || !CanOperate || string.IsNullOrWhiteSpace(targetHex))">
                        <AppIcon Name="play" Size="11" />
                        <span>Execute Read</span>
                    </button>
                </div>
                <div class="op-card-body">
                    <div class="form-group">
                        <label class="form-label">Memory Bank</label>
                        <div class="bank-tabs">
                            @foreach (TagMemoryBank bank in BankOptions)
                            {
                                <button type="button" class="bank-tab @(readBank == bank ? "active" : string.Empty)"
                                        @onclick="() => SetReadBank(bank)"
                                        disabled="@pageBusy">
                                    @bank
                                </button>
                            }
                        </div>
                    </div>

                    <div class="memory-op-form-grid">
                        <div class="form-group">
                            <label class="form-label">Word Pointer</label>
                            <input type="number" min="0" @bind="readPointer" disabled="@pageBusy" />
                            <span class="form-hint">EPC starts at word 2.</span>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Word Count</label>
                            <input type="number" min="1" max="64" @bind="readCount" disabled="@pageBusy" />
                            <span class="form-hint">16-bit words.</span>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Access Password (Hex)</label>
                            <input type="text" @bind="accessPassword" placeholder="00000000" class="mono" disabled="@pageBusy" />
                        </div>
                    </div>

                    <div class="op-result @(lastReadSucceeded.HasValue ? (lastReadSucceeded.Value ? "success" : "error") : string.Empty)">
                        @readStatusText
                    </div>
                </div>
            </div>

            <!-- Write Memory Card -->
            <div class="op-card">
                <div class="op-card-header">
                    <span class="op-card-title">
                        <AppIcon Name="write" Size="15" />
                        <span>Write Memory</span>
                    </span>
                    <button class="btn btn-sm btn-primary" @onclick="WriteAsync" disabled="@(pageBusy || !CanOperate || string.IsNullOrWhiteSpace(targetHex))">
                        <AppIcon Name="play" Size="11" />
                        <span>Execute Write</span>
                    </button>
                </div>
                <div class="op-card-body">
                    <div class="form-group">
                        <label class="form-label">Memory Bank</label>
                        <div class="bank-tabs">
                            @foreach (TagMemoryBank bank in BankOptions)
                            {
                                <button type="button" class="bank-tab @(writeBank == bank ? "active" : string.Empty)"
                                        @onclick="() => SetWriteBank(bank)"
                                        disabled="@pageBusy">
                                    @bank
                                </button>
                            }
                        </div>
                    </div>

                    <div class="memory-write-form-grid">
                        <div class="form-group">
                            <label class="form-label">Word Pointer</label>
                            <input type="number" min="0" @bind="writePointer" disabled="@pageBusy" />
                            <span class="form-hint">EPC starts at word 2.</span>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Data Hex (16-bit Word Aligned)</label>
                            <input type="text" @bind="writeDataHex" placeholder="e.g. 11223344" class="mono" disabled="@pageBusy" />
                            <span class="form-hint">Must be 4, 8, 12, 16... hex chars.</span>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Access Password (Hex)</label>
                            <input type="text" @bind="accessPassword" placeholder="00000000" class="mono" disabled="@pageBusy" />
                        </div>
                    </div>

                    <div class="op-result @(lastWriteSucceeded.HasValue ? (lastWriteSucceeded.Value ? "success" : "error") : string.Empty)">
                        @writeStatusText
                    </div>
                </div>
            </div>

            <!-- Visual Memory Map -->
            <div class="card memory-map-card">
                <div class="card-header">
                    <span class="card-title">
                        <AppIcon Name="microchip" Size="14" />
                        <span>Live Visual Memory Map (Word 0x00 - 0x0F)</span>
                    </span>
                    <span class="status-badge neutral">Bank: @readBank</span>
                </div>
                <div class="memory-view-container">
                    <div class="memory-view-blocks">
                        <!-- Half 1: 0x00 - 0x07 -->
                        <div class="memory-view-half">
                            <div class="memory-view-grid">
                                @for (int i = 0; i < 8; i++)
                                {
                                    <div class="memory-cell header">@($"{i:X2}")</div>
                                }
                                @for (int i = 0; i < 8; i++)
                                {
                                    int wordIndex = i;
                                    string wordHex = GetWordHex(wordIndex);
                                    bool isHighlighted = IsWordHighlighted(wordIndex);
                                    <div class="memory-cell @(isHighlighted ? "highlight" : string.Empty)"
                                         style="cursor: pointer; user-select: none;"
                                         @onclick="() => SelectMemoryWord(wordIndex)"
                                         title="@($"Word 0x{wordIndex:X2} ({wordHex}) - Click to set Word Pointer")">
                                        @wordHex
                                    </div>
                                }
                            </div>
                        </div>

                        <!-- Half 2: 0x08 - 0x0F -->
                        <div class="memory-view-half">
                            <div class="memory-view-grid">
                                @for (int i = 8; i < 16; i++)
                                {
                                    <div class="memory-cell header">@($"{i:X2}")</div>
                                }
                                @for (int i = 8; i < 16; i++)
                                {
                                    int wordIndex = i;
                                    string wordHex = GetWordHex(wordIndex);
                                    bool isHighlighted = IsWordHighlighted(wordIndex);
                                    <div class="memory-cell @(isHighlighted ? "highlight" : string.Empty)"
                                         style="cursor: pointer; user-select: none;"
                                         @onclick="() => SelectMemoryWord(wordIndex)"
                                         title="@($"Word 0x{wordIndex:X2} ({wordHex}) - Click to set Word Pointer")">
                                        @wordHex
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Diagnostics & Session History -->
            @if (history.Count > 0)
            {
                <div class="card">
                    <div class="card-header">
                        <span class="card-title">
                            <AppIcon Name="history" Size="14" />
                            <span>Session History & Diagnostics</span>
                        </span>
                        <span class="status-badge neutral">@history.Count record(s)</span>
                    </div>
                    <div class="operation-history">
                        @foreach (TagAccessRecord record in history)
                        {
                            <div class="operation-history-row @(record.Succeeded ? string.Empty : "error")">
                                <span class="status-dot @(record.Succeeded ? "online" : string.Empty)"></span>
                                <div>
                                    <strong>@record.Kind · @record.MemoryBank (word @record.WordPointer, @record.WordCount word(s))</strong>
                                    <small>@record.StartedAt.ToLocalTime().ToString("HH:mm:ss.fff") · @FormatDuration(record.Duration) · @record.Target</small>
                                </div>
                                <div style="text-align: right;">
                                    <span class="status-badge @(record.Succeeded ? "ok" : "danger")">@(record.Succeeded ? "OK" : record.ErrorCode)</span>
                                    @if (!string.IsNullOrWhiteSpace(record.DataHex))
                                    {
                                        <div class="mono muted" style="font-size: 10.5px; margin-top: 2px;">@record.DataHex</div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
}

@code {
    private static readonly TagMemoryBank[] BankOptions = [TagMemoryBank.Reserved, TagMemoryBank.Epc, TagMemoryBank.Tid, TagMemoryBank.User];

    private readonly List<TagAccessRecord> history = [];
    private string? selectedReaderText;
    private string searchText = string.Empty;
    private bool autoSelectReader = true;
    private string mobileTab = "tags"; // "tags" or "ops" on mobile

    // Target Selection
    private string targetHex = string.Empty;
    private TagMemoryBank selectionBank = TagMemoryBank.Epc;
    private TagObservation? selectedTagRef;
    private Guid? tagOriginReaderId;

    // Read form
    private TagMemoryBank readBank = TagMemoryBank.Epc;
    private ushort readPointer = 2;
    private ushort readCount = 4;
    private string accessPassword = "00000000";
    private string readStatusText = "Ready to execute. Select a tag or type a target Hex above and click Execute Read.";
    private bool? lastReadSucceeded;
    private string activeMemoryDataHex = string.Empty;
    private int activeHighlightStart = -1;
    private int activeHighlightLength = 0;

    // Write form
    private TagMemoryBank writeBank = TagMemoryBank.Epc;
    private ushort writePointer = 2;
    private string writeDataHex = string.Empty;
    private string writeStatusText = "Enter hex words (e.g. 1234ABCD) and click Execute Write.";
    private bool? lastWriteSucceeded;

    private bool pageBusy;

    private string SelectedReaderText => selectedReaderText ?? State.SelectedReaderId?.ToString() ?? string.Empty;
    private ReaderRuntimeSnapshot? ManualSelectedReader => State.Find(ParseReaderId(SelectedReaderText));

    // Effective Reader for Execution
    private ReaderRuntimeSnapshot? EffectiveReader
    {
        get
        {
            if (autoSelectReader && tagOriginReaderId.HasValue)
            {
                return State.Find(tagOriginReaderId.Value) ?? ManualSelectedReader;
            }
            return ManualSelectedReader;
        }
    }

    private bool CanOperate => EffectiveReader is not null && !pageBusy;

    public sealed record TagSourceItem(TagObservation Tag, Guid ReaderId, string ReaderName);

    private IReadOnlyList<TagSourceItem> AvailableTags
    {
        get
        {
            if (autoSelectReader)
            {
                return State.Readers
                    .SelectMany(r => State.GetTags(r.ReaderId).Select(t => new TagSourceItem(t, r.ReaderId, r.Profile.Name)))
                    .OrderByDescending(item => item.Tag.LastSeen)
                    .ToList();
            }

            if (EffectiveReader is { } reader)
            {
                return State.GetTags(reader.ReaderId)
                    .Select(t => new TagSourceItem(t, reader.ReaderId, reader.Profile.Name))
                    .OrderByDescending(item => item.Tag.LastSeen)
                    .ToList();
            }

            return [];
        }
    }

    private IReadOnlyList<TagSourceItem> FilteredTags => AvailableTags
        .Where(item => string.IsNullOrWhiteSpace(searchText) ||
                       item.Tag.Epc.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
                       (!string.IsNullOrWhiteSpace(item.Tag.Tid) && item.Tag.Tid.Contains(searchText, StringComparison.OrdinalIgnoreCase)) ||
                       item.ReaderName.Contains(searchText, StringComparison.OrdinalIgnoreCase))
        .ToList();

    protected override async Task OnInitializedAsync()
    {
        State.Changed += OnChanged;
        await State.InitializeAsync();
        if (State.SelectedReaderId is null)
        {
            State.Select(State.Readers.FirstOrDefault()?.ReaderId);
        }
        selectedReaderText = State.SelectedReaderId?.ToString();
    }

    private void SelectReader(ChangeEventArgs args)
    {
        selectedReaderText = args.Value?.ToString();
        Guid? id = ParseReaderId(selectedReaderText);
        State.Select(id);
    }

    private void SelectTag(TagSourceItem item)
    {
        selectedTagRef = item.Tag;
        tagOriginReaderId = item.ReaderId;

        if (autoSelectReader)
        {
            selectedReaderText = item.ReaderId.ToString();
            State.Select(item.ReaderId);
        }

        if (selectionBank == TagMemoryBank.Tid && !string.IsNullOrWhiteSpace(item.Tag.Tid))
        {
            targetHex = item.Tag.Tid;
        }
        else
        {
            targetHex = item.Tag.Epc;
            selectionBank = TagMemoryBank.Epc;
        }
        readStatusText = $"Selected target {item.Tag.Epc}. Ready to execute.";
        mobileTab = "ops"; // Automatically switch to Operations tab on mobile!
    }

    private void OnTargetHexInput(ChangeEventArgs args)
    {
        targetHex = args.Value?.ToString() ?? string.Empty;
        if (selectedTagRef is not null &&
            !targetHex.Equals(selectedTagRef.Epc, StringComparison.OrdinalIgnoreCase) &&
            !targetHex.Equals(selectedTagRef.Tid, StringComparison.OrdinalIgnoreCase))
        {
            selectedTagRef = null;
            tagOriginReaderId = null;
        }
    }

    private void SetSelectionBank(TagMemoryBank bank)
    {
        selectionBank = bank;
        if (selectedTagRef is not null)
        {
            if (bank == TagMemoryBank.Tid && !string.IsNullOrWhiteSpace(selectedTagRef.Tid))
            {
                targetHex = selectedTagRef.Tid;
            }
            else if (bank == TagMemoryBank.Epc)
            {
                targetHex = selectedTagRef.Epc;
            }
        }
    }

    private void SetReadBank(TagMemoryBank bank)
    {
        readBank = bank;
        readPointer = bank == TagMemoryBank.Epc ? (ushort)2 : (ushort)0;
    }

    private void SetWriteBank(TagMemoryBank bank)
    {
        writeBank = bank;
        writePointer = bank == TagMemoryBank.Epc ? (ushort)2 : (ushort)0;
    }

    private async Task ReadAsync()
    {
        if (EffectiveReader is not { } reader || pageBusy)
        {
            return;
        }

        string cleanTarget = NormalizeHex(targetHex);
        if (string.IsNullOrWhiteSpace(cleanTarget))
        {
            readStatusText = "Please specify a valid hexadecimal target EPC / TID.";
            lastReadSucceeded = false;
            return;
        }

        pageBusy = true;
        readStatusText = $"Executing read on {reader.Profile.Name}...";
        DateTimeOffset startedAt = DateTimeOffset.UtcNow;
        TagAccessResult? result = null;
        Exception? failure = null;

        try
        {
            result = await State.Inventory.ReadTagMemoryAsync(reader.ReaderId, new TagReadRequest
            {
                Epc = cleanTarget,
                SelectionBank = selectionBank,
                MemoryBank = readBank,
                OffsetWords = readPointer,
                WordCount = readCount,
                AccessPasswordHex = NormalizeHex(accessPassword),
            });

            lastReadSucceeded = result.Succeeded;
            if (result.Succeeded)
            {
                string data = result.DataHex ?? string.Empty;
                activeMemoryDataHex = data;
                activeHighlightStart = readPointer;
                activeHighlightLength = readCount;
                readStatusText = $"Read succeeded. Data: {FormatHexWords(data)}";
            }
            else
            {
                readStatusText = $"Read failed: {result.Error ?? result.ErrorCode.ToString()}";
            }
        }
        catch (Exception ex)
        {
            failure = ex;
            lastReadSucceeded = false;
            readStatusText = $"Read failed with exception: {ex.Message}";
        }
        finally
        {
            DateTimeOffset completedAt = DateTimeOffset.UtcNow;
            AddHistoryRecord(new TagAccessRecord(
                "Read",
                $"{reader.Profile.Name} ({reader.Profile.Host}:{reader.Profile.Port})",
                $"{selectionBank}:{cleanTarget}",
                readBank,
                readPointer,
                readCount,
                startedAt,
                completedAt,
                result?.Succeeded ?? false,
                result?.ErrorCode.ToString() ?? "Exception",
                result?.Error ?? failure?.Message,
                result?.DataHex));

            pageBusy = false;
        }
    }

    private async Task WriteAsync()
    {
        if (EffectiveReader is not { } reader || pageBusy)
        {
            return;
        }

        string cleanTarget = NormalizeHex(targetHex);
        if (string.IsNullOrWhiteSpace(cleanTarget))
        {
            writeStatusText = "Please specify a valid hexadecimal target EPC / TID.";
            lastWriteSucceeded = false;
            return;
        }

        string cleanData = NormalizeHex(writeDataHex);
        if (string.IsNullOrWhiteSpace(cleanData))
        {
            writeStatusText = "Write data cannot be empty.";
            lastWriteSucceeded = false;
            return;
        }

        if (cleanData.Length % 4 != 0)
        {
            writeStatusText = $"Write data length ({cleanData.Length} chars) must be a multiple of 4 hex digits (16-bit word alignment).";
            lastWriteSucceeded = false;
            return;
        }

        pageBusy = true;
        writeStatusText = $"Executing write on {reader.Profile.Name}...";
        DateTimeOffset startedAt = DateTimeOffset.UtcNow;
        TagAccessResult? result = null;
        Exception? failure = null;
        ushort wordsWritten = (ushort)(cleanData.Length / 4);

        try
        {
            result = await State.Inventory.WriteTagMemoryAsync(reader.ReaderId, new TagWriteRequest
            {
                Epc = cleanTarget,
                SelectionBank = selectionBank,
                MemoryBank = writeBank,
                OffsetWords = writePointer,
                DataHex = cleanData,
                AccessPasswordHex = NormalizeHex(accessPassword),
            });

            lastWriteSucceeded = result.Succeeded;
            if (result.Succeeded)
            {
                activeMemoryDataHex = cleanData;
                activeHighlightStart = writePointer;
                activeHighlightLength = wordsWritten;
                writeStatusText = $"Write succeeded. Written {wordsWritten} word(s): {FormatHexWords(cleanData)}";
            }
            else
            {
                writeStatusText = $"Write failed: {result.Error ?? result.ErrorCode.ToString()}";
            }
        }
        catch (Exception ex)
        {
            failure = ex;
            lastWriteSucceeded = false;
            writeStatusText = $"Write failed with exception: {ex.Message}";
        }
        finally
        {
            DateTimeOffset completedAt = DateTimeOffset.UtcNow;
            AddHistoryRecord(new TagAccessRecord(
                "Write",
                $"{reader.Profile.Name} ({reader.Profile.Host}:{reader.Profile.Port})",
                $"{selectionBank}:{cleanTarget}",
                writeBank,
                writePointer,
                wordsWritten,
                startedAt,
                completedAt,
                result?.Succeeded ?? false,
                result?.ErrorCode.ToString() ?? "Exception",
                result?.Error ?? failure?.Message,
                cleanData));

            pageBusy = false;
        }
    }

    private void AddHistoryRecord(TagAccessRecord record)
    {
        history.Insert(0, record);
        if (history.Count > 30)
        {
            history.RemoveAt(history.Count - 1);
        }
    }

    private string GetWordHex(int wordIndex)
    {
        if (string.IsNullOrWhiteSpace(activeMemoryDataHex) || activeHighlightStart < 0)
        {
            return "0000";
        }

        int relIndex = wordIndex - activeHighlightStart;
        if (relIndex >= 0 && relIndex < activeHighlightLength)
        {
            int charStart = relIndex * 4;
            if (charStart + 4 <= activeMemoryDataHex.Length)
            {
                return activeMemoryDataHex.Substring(charStart, 4).ToUpperInvariant();
            }
        }

        return "0000";
    }

    private bool IsWordHighlighted(int wordIndex)
    {
        if (activeHighlightStart < 0 || activeHighlightLength <= 0)
        {
            return false;
        }
        return wordIndex >= activeHighlightStart && wordIndex < (activeHighlightStart + activeHighlightLength);
    }

    private void SelectMemoryWord(int wordIndex)
    {
        readPointer = (ushort)wordIndex;
        writePointer = (ushort)wordIndex;
    }

    private static string NormalizeHex(string? raw)
    {
        if (string.IsNullOrWhiteSpace(raw)) return string.Empty;
        var chars = raw.Where(c => Uri.IsHexDigit(c)).ToArray();
        return new string(chars).ToUpperInvariant();
    }

    private static string FormatHexWords(string hex)
    {
        if (string.IsNullOrWhiteSpace(hex)) return string.Empty;
        var sb = new System.Text.StringBuilder();
        for (int i = 0; i < hex.Length; i += 4)
        {
            if (i > 0) sb.Append(' ');
            int len = Math.Min(4, hex.Length - i);
            sb.Append(hex.Substring(i, len));
        }
        return sb.ToString().ToUpperInvariant();
    }

    private static string FormatDuration(TimeSpan duration) =>
        duration.TotalMilliseconds < 1000
            ? $"{duration.TotalMilliseconds:0}ms"
            : $"{duration.TotalSeconds:0.00}s";

    private static Guid? ParseReaderId(string? value) => Guid.TryParse(value, out Guid id) ? id : null;

    private void OnChanged(object? sender, EventArgs args) => InvokeAsync(StateHasChanged);

    public void Dispose() => State.Changed -= OnChanged;

    public sealed record TagAccessRecord(
        string Kind,
        string TargetReader,
        string Target,
        TagMemoryBank MemoryBank,
        ushort WordPointer,
        ushort WordCount,
        DateTimeOffset StartedAt,
        DateTimeOffset CompletedAt,
        bool Succeeded,
        string ErrorCode,
        string? Error,
        string? DataHex)
    {
        public TimeSpan Duration => CompletedAt - StartedAt;
    }
