@page "/tag-memory"
@implements IDisposable
@inject ReaderManagerState State

<div class="section-header">
    <div>
        <h1 class="section-title">Tag Operations</h1>
        <p class="section-subtitle">Targeted C1G2 Read and Write memory operations with live visual memory map.</p>
    </div>
    <div class="toolbar">
        <label class="form-label" for="tag-memory-reader">Reader</label>
        <select id="tag-memory-reader" style="width: min(280px, 50vw);" value="@SelectedReaderText" @onchange="SelectReader">
            <option value="">Choose Reader</option>
            @foreach (ReaderRuntimeSnapshot reader in State.Readers)
            {
                <option value="@reader.ReaderId">@reader.Profile.Name (@reader.Profile.Host:@reader.Profile.Port)</option>
            }
        </select>
    </div>
</div>

@if (SelectedReader is null)
{
    <div class="card empty-state">
        <AppIcon Name="microchip" Size="36" />
        <h2>Select a Reader</h2>
        <p>Tag Operations run as isolated short-connection leases against the selected Reader.</p>
        <a class="btn btn-primary" href="/readers" style="margin-top: var(--space-2);">Open Readers</a>
    </div>
}
else
{
    <div class="access-layout">
        <!-- Left: Tag Selector -->
        <div class="tag-selector">
            <div class="tag-selector-header">
                <input type="text" placeholder="Filter EPC / TID..." @bind="searchText" @bind:event="oninput" />
                <span class="tag-count-label">@FilteredTags.Count tags</span>
            </div>
            <div class="tag-list">
                @if (FilteredTags.Count == 0)
                {
                    <div class="empty-state" style="padding: var(--space-4); min-height: 120px;">
                        <span class="muted" style="font-size: 11.5px;">No tags in inventory.<br />Enter a target EPC manually.</span>
                    </div>
                }
                @foreach (TagObservation tag in FilteredTags)
                {
                    <button class="tag-list-item @(targetEpc.Equals(tag.Epc, StringComparison.OrdinalIgnoreCase) ? "selected" : string.Empty)"
                            @onclick="() => SelectTag(tag)">
                        <div class="tag-list-item-epc">@tag.Epc</div>
                        <div class="tag-list-item-meta">
                            <span>Ant @(tag.LastAntenna?.ToString() ?? "—")</span>
                            <span>·</span>
                            <span>@(tag.LastRssi?.ToString("0.0") ?? "—") dBm</span>
                            <span>·</span>
                            <span>seen @tag.ReadCount</span>
                        </div>
                    </button>
                }
            </div>
            <div style="padding: var(--space-2) var(--space-3); border-top: 1px solid var(--border); background: var(--surface-sunken);">
                <button class="btn btn-sm" style="width: 100%;" @onclick="ClearTarget">
                    <AppIcon Name="plus" Size="12" />
                    <span>Custom / Manual Target</span>
                </button>
            </div>
        </div>

        <!-- Right: Operations Panel -->
        <div class="operations-panel">
            <!-- Selected Tag Banner -->
            <div class="card selected-tag-card">
                <div class="selected-tag-row">
                    <div>
                        <div class="stat-label">Target Tag</div>
                        <div class="selected-epc-display">
                            @(string.IsNullOrWhiteSpace(targetEpc) ? "Enter target EPC below" : targetEpc)
                        </div>
                    </div>
                    <div class="selected-tag-meta">
                        <span>@SelectedReader.Profile.Host:@SelectedReader.Profile.Port</span>
                        <span class="status-badge @(SelectedReader.IsEnabled ? "ok" : "warn")" style="margin-left: 6px;">
                            @(SelectedReader.IsEnabled ? "Active" : "Disabled")
                        </span>
                    </div>
                </div>
            </div>

            <!-- Read Memory Card -->
            <div class="op-card">
                <div class="op-card-header">
                    <span class="op-card-title">
                        <AppIcon Name="read" Size="15" />
                        <span>Read Memory</span>
                    </span>
                    <button class="btn btn-sm btn-primary" @onclick="ReadAsync" disabled="@(pageBusy || !CanOperate)">
                        <AppIcon Name="play" Size="11" />
                        <span>Execute Read</span>
                    </button>
                </div>
                <div class="op-card-body">
                    <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: var(--space-2);">
                        <div class="form-group">
                            <label class="form-label">Memory Bank</label>
                            <div class="bank-tabs">
                                @foreach (TagMemoryBank bank in BankOptions)
                                {
                                    <button class="bank-tab @(readBank == bank ? "active" : string.Empty)"
                                            @onclick="() => SetReadBank(bank)"
                                            disabled="@pageBusy">
                                        @bank
                                    </button>
                                }
                            </div>
                        </div>

                        <div class="form-group" style="min-width: 180px;">
                            <label class="form-label">Match Bank</label>
                            <div class="bank-tabs">
                                <button class="bank-tab @(selectionBank == TagMemoryBank.Epc ? "active" : string.Empty)"
                                        @onclick="() => selectionBank = TagMemoryBank.Epc"
                                        disabled="@pageBusy">EPC</button>
                                <button class="bank-tab @(selectionBank == TagMemoryBank.Tid ? "active" : string.Empty)"
                                        @onclick="() => selectionBank = TagMemoryBank.Tid"
                                        disabled="@pageBusy">TID</button>
                            </div>
                        </div>
                    </div>

                    <div style="display: grid; grid-template-columns: 1fr 1fr 1.5fr; gap: var(--space-3);">
                        <div class="form-group">
                            <label class="form-label">Word Pointer</label>
                            <input type="number" min="0" @bind="readPointer" disabled="@pageBusy" />
                            <span class="form-hint">1 word = 16-bit. EPC starts at word 2.</span>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Word Count</label>
                            <input type="number" min="1" max="64" @bind="readCount" disabled="@pageBusy" />
                            <span class="form-hint">Number of 16-bit words to read.</span>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Target EPC / TID Hex</label>
                            <input type="text" @bind="targetEpc" placeholder="Hex target (e.g. E2801160...)" class="mono" disabled="@pageBusy" />
                            <span class="form-hint">Editable target matching string.</span>
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="form-label">Access Password (Hex)</label>
                        <input type="text" @bind="accessPassword" placeholder="00000000" class="mono" style="max-width: 220px;" disabled="@pageBusy" />
                    </div>

                    <div class="op-result @(lastReadSucceeded.HasValue ? (lastReadSucceeded.Value ? "success" : "error") : string.Empty)">
                        @readStatusText
                    </div>
                </div>
            </div>

            <!-- Write Memory Card -->
            <div class="op-card">
                <div class="op-card-header">
                    <span class="op-card-title">
                        <AppIcon Name="write" Size="15" />
                        <span>Write Memory</span>
                    </span>
                    <button class="btn btn-sm btn-primary" @onclick="WriteAsync" disabled="@(pageBusy || !CanOperate)">
                        <AppIcon Name="play" Size="11" />
                        <span>Execute Write</span>
                    </button>
                </div>
                <div class="op-card-body">
                    <div class="form-group">
                        <label class="form-label">Memory Bank</label>
                        <div class="bank-tabs">
                            @foreach (TagMemoryBank bank in BankOptions)
                            {
                                <button class="bank-tab @(writeBank == bank ? "active" : string.Empty)"
                                        @onclick="() => SetWriteBank(bank)"
                                        disabled="@pageBusy">
                                    @bank
                                </button>
                            }
                        </div>
                    </div>

                    <div style="display: grid; grid-template-columns: 140px 1fr; gap: var(--space-3);">
                        <div class="form-group">
                            <label class="form-label">Word Pointer</label>
                            <input type="number" min="0" @bind="writePointer" disabled="@pageBusy" />
                            <span class="form-hint">Word offset (EPC word 2).</span>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Write Data (Hex Words)</label>
                            <input type="text" @bind="writeDataHex" placeholder="Hex words, e.g. 1234 5678" class="mono" disabled="@pageBusy" />
                            <span class="form-hint">Must be complete 16-bit words (4 hex digits per word).</span>
                        </div>
                    </div>

                    <div class="op-result @(lastWriteSucceeded.HasValue ? (lastWriteSucceeded.Value ? "success" : "error") : string.Empty)">
                        @writeStatusText
                    </div>
                </div>
            </div>

            <!-- 16-Word Memory Map Viewer -->
            <div class="card">
                <div class="card-header">
                    <span class="card-title">
                        <AppIcon Name="grid" Size="14" />
                        <span>Memory Map — @readBank Bank (16 Words)</span>
                    </span>
                    <span class="form-hint mono">Indices 0x00 – 0x0F</span>
                </div>
                <div class="memory-view-container">
                    <div class="memory-view">
                        @for (int i = 0; i < 16; i++)
                        {
                            <div class="memory-cell header">@i.ToString("X2")</div>
                        }
                        @for (int i = 0; i < 16; i++)
                        {
                            int wordIndex = i;
                            string wordHex = GetWordHex(wordIndex);
                            bool isHighlighted = IsWordHighlighted(wordIndex);
                            <div class="memory-cell @(isHighlighted ? "highlight" : string.Empty)" title="Word @wordIndex: @wordHex">
                                @wordHex
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Diagnostics & Session History -->
            @if (history.Count > 0)
            {
                <div class="card">
                    <div class="card-header">
                        <span class="card-title">
                            <AppIcon Name="history" Size="14" />
                            <span>Session History & Diagnostics</span>
                        </span>
                        <span class="status-badge neutral">@history.Count record(s)</span>
                    </div>
                    <div class="operation-history">
                        @foreach (TagAccessRecord record in history)
                        {
                            <div class="operation-history-row @(record.Succeeded ? string.Empty : "error")">
                                <span class="status-dot @(record.Succeeded ? "online" : string.Empty)"></span>
                                <div>
                                    <strong>@record.Kind · @record.MemoryBank (word @record.WordPointer, @record.WordCount word(s))</strong>
                                    <small>@record.StartedAt.ToLocalTime().ToString("HH:mm:ss.fff") · @FormatDuration(record.Duration) · @record.Target</small>
                                </div>
                                <div style="text-align: right;">
                                    <span class="status-badge @(record.Succeeded ? "ok" : "danger")">@(record.Succeeded ? "OK" : record.ErrorCode)</span>
                                    @if (!string.IsNullOrWhiteSpace(record.DataHex))
                                    {
                                        <div class="mono muted" style="font-size: 10.5px; margin-top: 2px;">@record.DataHex</div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
}

@code {
    private static readonly TagMemoryBank[] BankOptions = [TagMemoryBank.Reserved, TagMemoryBank.Epc, TagMemoryBank.Tid, TagMemoryBank.User];

    private readonly List<TagAccessRecord> history = [];
    private string? selectedReaderText;
    private string searchText = string.Empty;

    private string targetEpc = string.Empty;
    private TagMemoryBank selectionBank = TagMemoryBank.Epc;

    // Read form
    private TagMemoryBank readBank = TagMemoryBank.Epc;
    private ushort readPointer = 2;
    private ushort readCount = 4;
    private string accessPassword = "00000000";
    private string readStatusText = "Ready to execute. Select a tag and click Execute Read.";
    private bool? lastReadSucceeded;
    private string activeMemoryDataHex = string.Empty;
    private int activeHighlightStart = -1;
    private int activeHighlightLength = 0;

    // Write form
    private TagMemoryBank writeBank = TagMemoryBank.Epc;
    private ushort writePointer = 2;
    private string writeDataHex = string.Empty;
    private string writeStatusText = "Enter hex words (e.g. 1234ABCD) and click Execute Write.";
    private bool? lastWriteSucceeded;

    private bool pageBusy;

    private string SelectedReaderText => selectedReaderText ?? State.SelectedReaderId?.ToString() ?? string.Empty;
    private ReaderRuntimeSnapshot? SelectedReader => State.Find(ParseReaderId(SelectedReaderText));
    private bool CanOperate => SelectedReader is not null && !pageBusy;

    private IReadOnlyList<TagObservation> Tags => SelectedReader is { } reader ? State.GetTags(reader.ReaderId) : [];

    private IReadOnlyList<TagObservation> FilteredTags => Tags
        .Where(t => string.IsNullOrWhiteSpace(searchText) ||
                    t.Epc.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
                    (t.Tid?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false))
        .ToList();

    protected override async Task OnInitializedAsync()
    {
        State.Changed += OnChanged;
        await State.InitializeAsync();
        if (State.SelectedReaderId is null)
        {
            State.Select(State.Readers.FirstOrDefault()?.ReaderId);
        }
        selectedReaderText = State.SelectedReaderId?.ToString();
    }

    private void SelectReader(ChangeEventArgs args)
    {
        selectedReaderText = args.Value?.ToString();
        State.Select(ParseReaderId(selectedReaderText));
        ClearTarget();
    }

    private void SelectTag(TagObservation tag)
    {
        targetEpc = tag.Epc;
        selectionBank = TagMemoryBank.Epc;
        if (!string.IsNullOrWhiteSpace(tag.Tid) && readBank == TagMemoryBank.Tid)
        {
            selectionBank = TagMemoryBank.Tid;
        }
    }

    private void ClearTarget()
    {
        targetEpc = string.Empty;
        activeMemoryDataHex = string.Empty;
        activeHighlightStart = -1;
        activeHighlightLength = 0;
    }

    private void SetReadBank(TagMemoryBank bank)
    {
        readBank = bank;
        readPointer = bank == TagMemoryBank.Epc ? (ushort)2 : (ushort)0;
    }

    private void SetWriteBank(TagMemoryBank bank)
    {
        writeBank = bank;
        writePointer = bank == TagMemoryBank.Epc ? (ushort)2 : (ushort)0;
    }

    private async Task ReadAsync()
    {
        if (SelectedReader is not { } reader || pageBusy)
        {
            return;
        }

        string cleanTarget = NormalizeHex(targetEpc);
        if (string.IsNullOrWhiteSpace(cleanTarget))
        {
            readStatusText = "Please select or enter a valid hexadecimal target EPC / TID.";
            lastReadSucceeded = false;
            return;
        }

        pageBusy = true;
        readStatusText = "Executing read operation...";
        DateTimeOffset startedAt = DateTimeOffset.UtcNow;
        TagAccessResult? result = null;
        Exception? failure = null;

        try
        {
            result = await State.Inventory.ReadTagMemoryAsync(reader.ReaderId, new TagReadRequest
            {
                Epc = cleanTarget,
                SelectionBank = selectionBank,
                MemoryBank = readBank,
                OffsetWords = readPointer,
                WordCount = readCount,
                AccessPasswordHex = NormalizeHex(accessPassword),
            });

            lastReadSucceeded = result.Succeeded;
            if (result.Succeeded)
            {
                string data = result.DataHex ?? string.Empty;
                activeMemoryDataHex = data;
                activeHighlightStart = readPointer;
                activeHighlightLength = readCount;
                readStatusText = $"Read succeeded. Data: {FormatHexWords(data)}";
            }
            else
            {
                readStatusText = $"Read failed: {result.Error ?? result.ErrorCode.ToString()}";
            }
        }
        catch (Exception ex)
        {
            failure = ex;
            lastReadSucceeded = false;
            readStatusText = $"Read failed with exception: {ex.Message}";
        }
        finally
        {
            DateTimeOffset completedAt = DateTimeOffset.UtcNow;
            AddHistoryRecord(new TagAccessRecord(
                "Read",
                $"{reader.Profile.Host}:{reader.Profile.Port}",
                cleanTarget,
                readBank,
                readPointer,
                readCount,
                startedAt,
                completedAt,
                result?.Succeeded ?? false,
                result?.ErrorCode.ToString() ?? "Exception",
                result?.Error ?? failure?.Message,
                result?.DataHex));

            pageBusy = false;
        }
    }

    private async Task WriteAsync()
    {
        if (SelectedReader is not { } reader || pageBusy)
        {
            return;
        }

        string cleanTarget = NormalizeHex(targetEpc);
        if (string.IsNullOrWhiteSpace(cleanTarget))
        {
            writeStatusText = "Please select or enter a valid hexadecimal target EPC / TID.";
            lastWriteSucceeded = false;
            return;
        }

        string cleanData = NormalizeHex(writeDataHex);
        if (string.IsNullOrWhiteSpace(cleanData))
        {
            writeStatusText = "Write data cannot be empty.";
            lastWriteSucceeded = false;
            return;
        }

        if (cleanData.Length % 4 != 0)
        {
            writeStatusText = $"Write data length ({cleanData.Length} chars) must be a multiple of 4 hex digits (16-bit word alignment).";
            lastWriteSucceeded = false;
            return;
        }

        pageBusy = true;
        writeStatusText = "Executing write operation...";
        DateTimeOffset startedAt = DateTimeOffset.UtcNow;
        TagAccessResult? result = null;
        Exception? failure = null;
        ushort wordsWritten = (ushort)(cleanData.Length / 4);

        try
        {
            result = await State.Inventory.WriteTagMemoryAsync(reader.ReaderId, new TagWriteRequest
            {
                Epc = cleanTarget,
                SelectionBank = selectionBank,
                MemoryBank = writeBank,
                OffsetWords = writePointer,
                DataHex = cleanData,
                AccessPasswordHex = NormalizeHex(accessPassword),
            });

            lastWriteSucceeded = result.Succeeded;
            if (result.Succeeded)
            {
                activeMemoryDataHex = cleanData;
                activeHighlightStart = writePointer;
                activeHighlightLength = wordsWritten;
                writeStatusText = $"Write succeeded. Written {wordsWritten} word(s): {FormatHexWords(cleanData)}";
            }
            else
            {
                writeStatusText = $"Write failed: {result.Error ?? result.ErrorCode.ToString()}";
            }
        }
        catch (Exception ex)
        {
            failure = ex;
            lastWriteSucceeded = false;
            writeStatusText = $"Write failed with exception: {ex.Message}";
        }
        finally
        {
            DateTimeOffset completedAt = DateTimeOffset.UtcNow;
            AddHistoryRecord(new TagAccessRecord(
                "Write",
                $"{reader.Profile.Host}:{reader.Profile.Port}",
                cleanTarget,
                writeBank,
                writePointer,
                wordsWritten,
                startedAt,
                completedAt,
                result?.Succeeded ?? false,
                result?.ErrorCode.ToString() ?? "Exception",
                result?.Error ?? failure?.Message,
                cleanData));

            pageBusy = false;
        }
    }

    private string GetWordHex(int wordIndex)
    {
        if (string.IsNullOrWhiteSpace(activeMemoryDataHex) || activeHighlightStart < 0)
        {
            return "0000";
        }

        int relOffset = wordIndex - activeHighlightStart;
        if (relOffset >= 0 && relOffset < activeHighlightLength)
        {
            int charIndex = relOffset * 4;
            if (charIndex + 4 <= activeMemoryDataHex.Length)
            {
                return activeMemoryDataHex.Substring(charIndex, 4).ToUpperInvariant();
            }
        }

        return "0000";
    }

    private bool IsWordHighlighted(int wordIndex)
    {
        if (activeHighlightStart < 0 || activeHighlightLength <= 0)
        {
            return false;
        }

        return wordIndex >= activeHighlightStart && wordIndex < (activeHighlightStart + activeHighlightLength);
    }

    private void AddHistoryRecord(TagAccessRecord record)
    {
        history.Insert(0, record);
        if (history.Count > 30)
        {
            history.RemoveAt(history.Count - 1);
        }
    }

    private static string NormalizeHex(string? input) =>
        new string((input ?? string.Empty).Where(c => Uri.IsHexDigit(c)).ToArray()).ToUpperInvariant();

    private static string FormatHexWords(string hex)
    {
        var clean = NormalizeHex(hex);
        var parts = new List<string>();
        for (int i = 0; i < clean.Length; i += 4)
        {
            parts.Add(clean.Substring(i, Math.Min(4, clean.Length - i)));
        }
        return string.Join(" ", parts);
    }

    private static string FormatDuration(TimeSpan duration) =>
        duration.TotalSeconds >= 1
            ? $"{duration.TotalSeconds:0.00} s"
            : $"{duration.TotalMilliseconds:0} ms";

    private static Guid? ParseReaderId(string? value) => Guid.TryParse(value, out Guid id) ? id : null;

    private void OnChanged(object? sender, EventArgs args) => InvokeAsync(StateHasChanged);

    public void Dispose() => State.Changed -= OnChanged;

    private sealed record TagAccessRecord(
        string Kind,
        string ReaderEndpoint,
        string Target,
        TagMemoryBank MemoryBank,
        ushort WordPointer,
        ushort WordCount,
        DateTimeOffset StartedAt,
        DateTimeOffset CompletedAt,
        bool Succeeded,
        string ErrorCode,
        string? Error,
        string? DataHex)
    {
        public TimeSpan Duration => CompletedAt - StartedAt;
    }
}
