@page "/tag-lists"
@inject ITagListStore TagListsStore

<div class="section-header">
    <div>
        <h1 class="section-title">Tags of Interest (TOI)</h1>
        <p class="section-subtitle">Define tag classifications, custom display names, and highlight colors for real-time Inventory.</p>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(error))
{
    <div class="notice error" style="margin-bottom: var(--space-4);">@error</div>
}

<!-- TOI Metrics Bar -->
<div class="card-grid" style="margin-bottom: var(--space-4);">
    <div class="card card-pad">
        <div class="stat-label">Active Classification Lists</div>
        <div class="stat-value">@lists.Count(l => l.IsEnabled)</div>
        <div class="stat-note">@lists.Count configured list(s)</div>
    </div>
    <div class="card card-pad">
        <div class="stat-label">Explicit Tag Entries</div>
        <div class="stat-value">@TotalEntriesCount</div>
        <div class="stat-note">Exact / prefix matched EPC rules</div>
    </div>
</div>

<div class="split">
    <section class="stack">
        @if (lists.Count == 0)
        {
            <div class="card empty-state">
                <AppIcon Name="tags" Size="36" />
                <h2>No Tag Lists Configured</h2>
                <p>Create a tag list on the right to categorize tags and highlight them with custom colors.</p>
            </div>
        }
        else
        {
            @foreach (TagListDefinition list in lists)
            {
                <div class="card">
                    <div class="card-header">
                        <div style="display: flex; align-items: center; gap: 10px;">
                            <span class="color-indicator" style="background-color: @list.ColorHex; border: 1px solid var(--border-strong); width: 14px; height: 14px;"></span>
                            <span class="card-title" style="color: var(--fg); font-size: 13.5px; text-transform: none;">@list.Name</span>
                        </div>
                        <span class="status-badge @(list.IsEnabled ? "ok" : "neutral")">@(list.IsEnabled ? "Enabled" : "Disabled")</span>
                    </div>
                    <div class="card-pad">
                        <div class="toolbar" style="margin-bottom: var(--space-3);">
                            <span class="muted" style="font-size: 12px;">@list.Entries.Count tag entry(ies)</span>
                            <span class="toolbar-spacer"></span>
                            <button class="btn btn-sm" @onclick="() => ToggleAsync(list)">
                                @(list.IsEnabled ? "Disable" : "Enable")
                            </button>
                            <button class="btn btn-sm btn-danger" @onclick="() => DeleteAsync(list.Id)">
                                <AppIcon Name="trash" Size="11" />
                                <span>Delete</span>
                            </button>
                        </div>
                        @if (list.Entries.Count > 0)
                        {
                            <div class="table-wrap">
                                <table>
                                    <thead>
                                        <tr>
                                            <th>Display Name</th>
                                            <th>EPC Pattern</th>
                                            <th style="min-width: 140px;">Color</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (TagListEntry entry in list.Entries)
                                        {
                                            string displayColor = entry.ColorHex ?? list.ColorHex;
                                            <tr>
                                                <td><strong>@entry.DisplayName</strong></td>
                                                <td class="mono">@entry.EpcHex</td>
                                                <td>
                                                    <span class="color-pill-tag">
                                                        <span class="color-indicator" style="background-color: @displayColor;"></span>
                                                        <span>@displayColor</span>
                                                    </span>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="form-hint">No explicit tag entries yet. The list color is applied to all matching tags.</div>
                        }

                        @if (selectedListId == list.Id)
                        {
                            <div class="inline-form" style="margin-top: var(--space-3); grid-template-columns: 1fr 1.5fr auto;">
                                <div class="form-group">
                                    <label class="form-label">Entry Name</label>
                                    <input type="text" @bind="entryName" placeholder="Palette item A" />
                                </div>
                                <div class="form-group">
                                    <label class="form-label">EPC (Hex)</label>
                                    <input type="text" @bind="entryEpc" placeholder="E280..." class="mono" />
                                </div>
                                <button class="btn btn-sm btn-primary" @onclick="() => AddEntryAsync(list)">
                                    <AppIcon Name="plus" Size="11" />
                                    <span>Add Tag</span>
                                </button>
                            </div>
                        }
                        else
                        {
                            <button class="btn btn-sm" style="margin-top: var(--space-3);" @onclick="() => BeginEntry(list.Id)">
                                <AppIcon Name="plus" Size="11" />
                                <span>Add Tag Entry</span>
                            </button>
                        }
                    </div>
                </div>
            }
        }
    </section>

    <aside class="card">
        <div class="card-header">
            <span class="card-title">
                <AppIcon Name="plus" Size="14" />
                <span>Create Tag List</span>
            </span>
        </div>
        <div class="card-pad stack">
            <div class="form-group">
                <label class="form-label">List Name</label>
                <input type="text" @bind="newName" placeholder="e.g. High Priority Items" />
            </div>

            <div class="form-group">
                <label class="form-label">Highlight Color</label>
                <div style="display: flex; align-items: center; gap: 8px;">
                    <input type="color" @bind="newColor" style="width: 36px; height: 32px; padding: 0; border: 1px solid var(--border-strong); border-radius: var(--radius-sm); cursor: pointer;" />
                    <input type="text" @bind="newColor" class="mono" style="width: 100px; height: 32px;" />
                </div>
                <div class="color-palette-bar">
                    @foreach (string preset in PresetColors)
                    {
                        <button type="button"
                                class="color-dot-btn @(newColor.Equals(preset, StringComparison.OrdinalIgnoreCase) ? "active" : string.Empty)"
                                style="background-color: @preset;"
                                title="@preset"
                                @onclick="() => newColor = preset"></button>
                    }
                </div>
            </div>

            <button class="btn btn-primary" style="width: 100%; margin-top: var(--space-2);" @onclick="CreateAsync" disabled="@(pageBusy || string.IsNullOrWhiteSpace(newName))">
                <AppIcon Name="plus" Size="13" />
                <span>Save Tag List</span>
            </button>
        </div>
    </aside>
</div>

@code {
    private static readonly string[] PresetColors =
    [
        "#14B8A6", // Teal
        "#10B981", // Emerald
        "#3B82F6", // Blue
        "#6366F1", // Indigo
        "#8B5CF6", // Purple
        "#EC4899", // Pink
        "#F59E0B", // Amber
        "#EF4444", // Red
    ];

    private List<TagListDefinition> lists = [];
    private string newName = string.Empty;
    private string newColor = "#14B8A6";
    private Guid? selectedListId;
    private string entryName = string.Empty;
    private string entryEpc = string.Empty;
    private string? error;
    private bool pageBusy;

    private int TotalEntriesCount => lists.Sum(l => l.Entries.Count);

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        pageBusy = true;
        error = null;
        try
        {
            lists = (await TagListsStore.GetAllAsync()).ToList();
        }
        catch (Exception exception)
        {
            error = exception.Message;
        }
        finally
        {
            pageBusy = false;
        }
    }

    private async Task CreateAsync()
    {
        if (string.IsNullOrWhiteSpace(newName) || pageBusy)
        {
            return;
        }

        pageBusy = true;
        error = null;
        try
        {
            var def = new TagListDefinition
            {
                Id = Guid.NewGuid(),
                Name = newName.Trim(),
                ColorHex = string.IsNullOrWhiteSpace(newColor) ? "#14B8A6" : newColor.Trim(),
                IsEnabled = true,
                Entries = [],
            };
            await TagListsStore.SaveAsync(def);
            newName = string.Empty;
            await LoadAsync();
        }
        catch (Exception exception)
        {
            error = exception.Message;
        }
        finally
        {
            pageBusy = false;
        }
    }

    private async Task ToggleAsync(TagListDefinition list)
    {
        if (pageBusy) return;
        pageBusy = true;
        error = null;
        try
        {
            var updated = list with { IsEnabled = !list.IsEnabled };
            await TagListsStore.SaveAsync(updated);
            await LoadAsync();
        }
        catch (Exception exception)
        {
            error = exception.Message;
        }
        finally
        {
            pageBusy = false;
        }
    }

    private async Task DeleteAsync(Guid id)
    {
        if (pageBusy) return;
        pageBusy = true;
        error = null;
        try
        {
            await TagListsStore.DeleteAsync(id);
            await LoadAsync();
        }
        catch (Exception exception)
        {
            error = exception.Message;
        }
        finally
        {
            pageBusy = false;
        }
    }

    private void BeginEntry(Guid listId)
    {
        selectedListId = listId;
        entryName = string.Empty;
        entryEpc = string.Empty;
    }

    private async Task AddEntryAsync(TagListDefinition list)
    {
        if (string.IsNullOrWhiteSpace(entryEpc) || pageBusy)
        {
            return;
        }

        pageBusy = true;
        error = null;
        try
        {
            var cleanEpc = entryEpc.Trim().Replace(" ", string.Empty).ToUpperInvariant();
            var entry = new TagListEntry
            {
                Id = Guid.NewGuid(),
                TagListId = list.Id,
                DisplayName = string.IsNullOrWhiteSpace(entryName) ? cleanEpc : entryName.Trim(),
                EpcHex = cleanEpc,
                ColorHex = list.ColorHex,
            };
            var entries = list.Entries.ToList();
            entries.Add(entry);
            var updated = list with { Entries = entries };
            await TagListsStore.SaveAsync(updated);
            selectedListId = null;
            entryName = string.Empty;
            entryEpc = string.Empty;
            await LoadAsync();
        }
        catch (Exception exception)
        {
            error = exception.Message;
        }
        finally
        {
            pageBusy = false;
        }
    }
}
