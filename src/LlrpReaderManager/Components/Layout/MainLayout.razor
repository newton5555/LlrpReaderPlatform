@inherits LayoutComponentBase
@implements IDisposable
@inject ReaderManagerState State
@inject VirtualReaderWidgetService VirtualDevices
@inject LlrpReaderManager.Services.IAppWindowService WindowService

@if (handheldPreviewMode)
{
    <!-- Simulated Handheld Device Stage for Desktop -->
    <div class="handheld-stage">
        <!-- Stage Top Control Strip (Single Row Layout) -->
        <div class="handheld-stage-header">
            <div class="handheld-stage-title" style="white-space: nowrap;">
                <AppIcon Name="mobile" Size="15" />
                <span>Simulator</span>
                <span class="status-badge ok" style="font-size: 9.5px; padding: 1px 5px; margin-left: 2px;">@deviceWidth×@deviceHeight</span>
            </div>

            <div class="stage-divider"></div>

            <!-- Device Preset Selector -->
            <div class="handheld-preset-tabs" title="Select simulated device screen profile">
                <button type="button" class="handheld-preset-btn @(devicePreset == "phone" ? "active" : string.Empty)" @onclick='() => SetDevicePreset("phone")'>
                    <span>📱 Phone (390×844)</span>
                </button>
                <button type="button" class="handheld-preset-btn @(devicePreset == "pda" ? "active" : string.Empty)" @onclick='() => SetDevicePreset("pda")'>
                    <span>📟 PDA (412×890)</span>
                </button>
                <button type="button" class="handheld-preset-btn @(devicePreset == "compact" ? "active" : string.Empty)" @onclick='() => SetDevicePreset("compact")'>
                    <span>📱 Compact (360×740)</span>
                </button>
            </div>

            <!-- Scale Zoom Selector -->
            <div class="handheld-preset-tabs" title="Adjust display zoom factor">
                <button type="button" class="handheld-preset-btn @(deviceScale == 1.0 ? "active" : string.Empty)" @onclick="() => SetDeviceScale(1.0)">
                    <span>100%</span>
                </button>
                <button type="button" class="handheld-preset-btn @(deviceScale == 0.88 ? "active" : string.Empty)" @onclick="() => SetDeviceScale(0.88)">
                    <span>88%</span>
                </button>
                <button type="button" class="handheld-preset-btn @(deviceScale == 0.78 ? "active" : string.Empty)" @onclick="() => SetDeviceScale(0.78)">
                    <span>78%</span>
                </button>
            </div>

            <div class="stage-divider"></div>

            <!-- Return to Desktop Button -->
            <button class="btn btn-sm btn-primary" style="height: 28px; padding: 0 12px; font-weight: 700; font-size: 11.5px; border-radius: var(--radius-pill); gap: 5px; white-space: nowrap;" @onclick="ToggleHandheldPreview">
                <AppIcon Name="desktop" Size="12" />
                <span>Return to Desktop</span>
            </button>
        </div>

        <!-- Outer Physical Hardware Chassis Window -->
        <div class="handheld-device-chassis-wrapper" style="transform: scale(@deviceScale); transform-origin: top center;">
            <div class="handheld-device-chassis" style="width: @(deviceWidth + 24)px; height: @(deviceHeight + 36)px;">
                <!-- Physical Hardware Buttons on Frame -->
                <div class="chassis-btn volume-up" title="Hardware Volume Up"></div>
                <div class="chassis-btn volume-down" title="Hardware Volume Down"></div>
                <div class="chassis-btn power" title="Hardware Power Key"></div>
                <div class="chassis-btn rfid-trigger" title="Industrial RFID Scan Trigger (黄键寻卡触发)"></div>

                <!-- Inner Screen Viewport with Bezel & Notch -->
                <div class="handheld-screen-inner" style="width: @(deviceWidth)px; height: @(deviceHeight)px;">
                    <!-- Simulated Hardware Speaker & Camera Notch -->
                    <div class="handheld-device-notch">
                        <div class="handheld-speaker"></div>
                        <div class="handheld-camera"></div>
                    </div>

                    <!-- Handheld Application Shell Viewport -->
                    <div class="app-shell handheld-mode" style="height: calc(100% - 24px); overflow-y: auto;">
                        <header class="app-topbar handheld-topbar">
                            <div style="display: flex; align-items: center; gap: var(--space-2);">
                                <img src="img/appicon.png" alt="LLRP" class="brand-logo-img" style="width: 20px; height: 20px;" />
                                <span style="font-weight: 700; font-size: 13px;">LLRP Mobile</span>
                            </div>
                            <div class="topbar-meta">
                                <span class="topbar-badge" style="font-size: 10px; padding: 2px 6px;">@ProtocolBadgeText</span>
                            </div>
                        </header>

                        <main class="app-content handheld-content">
                            @Body
                        </main>

                        <nav class="mobile-bottom-nav" aria-label="Handheld Navigation">
                            <NavLink href="/" Match="NavLinkMatch.All" class="mobile-nav-item" title="Dashboard">
                                <AppIcon Name="dashboard" Size="18" />
                                <span>Home</span>
                            </NavLink>
                            <NavLink href="/inventory" class="mobile-nav-item" title="Tag Inventory">
                                <AppIcon Name="search" Size="18" />
                                <span>Inventory</span>
                            </NavLink>
                            <NavLink href="/tag-memory" class="mobile-nav-item" title="Tag Operations">
                                <AppIcon Name="microchip" Size="18" />
                                <span>Tag Ops</span>
                            </NavLink>
                            <NavLink href="/readers" class="mobile-nav-item" title="Readers">
                                <AppIcon Name="readers" Size="18" />
                                <span>Readers</span>
                            </NavLink>
                            <NavLink href="/settings" class="mobile-nav-item" title="Settings">
                                <AppIcon Name="gear" Size="18" />
                                <span>Settings</span>
                            </NavLink>
                        </nav>

                        @if (State.IsBusy || VirtualDevices.IsBusy)
                        {
                            <div class="busy-strip" style="font-size: 11px;">
                                <AppIcon Name="rotate" Size="12" Class="animate-spin" />
                                <span>Working with Reader…</span>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <!-- Standard Responsive Desktop / Mobile Layout (Automatically adapts to viewport) -->
    <div class="app-shell @(navigationCollapsed ? "sidebar-collapsed" : string.Empty)">
        <header class="app-topbar">
            <div style="display: flex; align-items: center; gap: var(--space-3);">
                <button class="topbar-toggle-btn" @onclick="ToggleNavigation" aria-label="Toggle navigation" title="@(navigationCollapsed ? "展开侧边栏" : "折叠侧边栏")">
                    <AppIcon Name="bars" Size="16" />
                </button>
                <div class="brand-button" style="cursor: pointer;" @onclick="ToggleNavigation">
                    <img src="img/appicon.png" alt="LLRP" class="brand-logo-img" />
                    <span>LLRP RFID Platform</span>
                </div>
            </div>
            <div class="topbar-meta">
                <!-- High-End Interactive Handheld Mode Preview Pill Button for Desktop -->
                <button class="device-switch-pill"
                        @onclick="ToggleHandheldPreview"
                        title="Simulate Handheld / Mobile Device on Windows (一键切换手持端仿真预览)">
                    <span class="switch-pill-icon"><AppIcon Name="mobile" Size="13" /></span>
                    <span class="switch-pill-text">Handheld Mode</span>
                    <span class="switch-pill-badge">@deviceWidth×@deviceHeight</span>
                </button>

                <span class="topbar-separator">|</span>
                <span class="topbar-badge">@ProtocolBadgeText</span>
                <span class="topbar-separator">|</span>
                <span>@State.Readers.Count Reader(s)</span>
                <span class="topbar-separator">|</span>
                <span class="topbar-time">@currentTime</span>
            </div>
        </header>

        <aside class="app-sidebar @(navigationCollapsed ? "collapsed" : string.Empty)">
            <nav aria-label="Primary navigation">
                <div class="nav-section">Overview</div>
                <NavLink href="/" Match="NavLinkMatch.All" title="Dashboard">
                    <span class="app-icon-wrapper"><AppIcon Name="dashboard" Size="16" /></span>
                    <span>Dashboard</span>
                </NavLink>
                <NavLink href="/readers" title="Readers">
                    <span class="app-icon-wrapper"><AppIcon Name="readers" Size="16" /></span>
                    <span>Readers</span>
                </NavLink>

                <div class="nav-section">Operations</div>
                <NavLink href="/inventory" title="Tag Inventory">
                    <span class="app-icon-wrapper"><AppIcon Name="search" Size="16" /></span>
                    <span>Tag Inventory</span>
                </NavLink>
                <NavLink href="/tag-memory" title="Tag Operations">
                    <span class="app-icon-wrapper"><AppIcon Name="microchip" Size="16" /></span>
                    <span>Tag Operations</span>
                </NavLink>
                <NavLink href="/runs" title="Inventory Runs">
                    <span class="app-icon-wrapper"><AppIcon Name="history" Size="16" /></span>
                    <span>Inventory Runs</span>
                </NavLink>

                <div class="nav-section">Configuration</div>
                <NavLink href="/settings" title="Reader Settings">
                    <span class="app-icon-wrapper"><AppIcon Name="gear" Size="16" /></span>
                    <span>Reader Settings</span>
                </NavLink>
                <NavLink href="/gpio" title="GPI / GPO">
                    <span class="app-icon-wrapper"><AppIcon Name="bolt" Size="16" /></span>
                    <span>GPI / GPO</span>
                </NavLink>
                <NavLink href="/tag-lists" title="Tags of Interest (TOI)">
                    <span class="app-icon-wrapper"><AppIcon Name="tags" Size="16" /></span>
                    <span>TOI</span>
                </NavLink>
            </nav>

            <div class="sidebar-footer" title="@(State.IsInitialized ? "Platform ready" : "Loading platform")">
                <span class="status-dot @(State.IsInitialized ? "online" : "pending")"></span>
                <span>@(State.IsInitialized ? "Platform ready" : "Loading platform")</span>
            </div>
        </aside>

        <main class="app-content">
            @Body
        </main>

        <!-- Native Mobile Bottom Bar (Active on real mobile screens <= 768px) -->
        <nav class="mobile-bottom-nav" aria-label="Mobile Navigation">
            <NavLink href="/" Match="NavLinkMatch.All" class="mobile-nav-item" title="Dashboard">
                <AppIcon Name="dashboard" Size="18" />
                <span>Home</span>
            </NavLink>
            <NavLink href="/inventory" class="mobile-nav-item" title="Tag Inventory">
                <AppIcon Name="search" Size="18" />
                <span>Inventory</span>
            </NavLink>
            <NavLink href="/tag-memory" class="mobile-nav-item" title="Tag Operations">
                <AppIcon Name="microchip" Size="18" />
                <span>Tag Ops</span>
            </NavLink>
            <NavLink href="/readers" class="mobile-nav-item" title="Readers">
                <AppIcon Name="readers" Size="18" />
                <span>Readers</span>
            </NavLink>
            <NavLink href="/settings" class="mobile-nav-item" title="Settings">
                <AppIcon Name="gear" Size="18" />
                <span>Settings</span>
            </NavLink>
        </nav>

        @if (State.IsBusy || VirtualDevices.IsBusy)
        {
            <div class="busy-strip">
                <AppIcon Name="rotate" Size="14" Class="animate-spin" />
                <span>Working with Reader services…</span>
            </div>
        }
    </div>
}

@code {
    private bool navigationCollapsed;
    private bool handheldPreviewMode;
    private string devicePreset = "phone";
    private int deviceWidth = 390;
    private int deviceHeight = 844;
    private double deviceScale = 1.0;
    private string currentTime = DateTime.Now.ToString("HH:mm:ss");
    private System.Threading.Timer? clockTimer;

    private void SetDevicePreset(string preset)
    {
        devicePreset = preset;
        switch (preset)
        {
            case "pda":
                deviceWidth = 412;
                deviceHeight = 890;
                break;
            case "compact":
                deviceWidth = 360;
                deviceHeight = 740;
                break;
            default:
                devicePreset = "phone";
                deviceWidth = 390;
                deviceHeight = 844;
                break;
        }
        if (handheldPreviewMode)
        {
            WindowService.ResizeToMobile(deviceWidth, deviceHeight);
        }
    }

    private void SetDeviceScale(double scale)
    {
        deviceScale = scale;
    }

    private void ToggleHandheldPreview()
    {
        handheldPreviewMode = !handheldPreviewMode;
        if (handheldPreviewMode)
        {
            WindowService.ResizeToMobile(deviceWidth, deviceHeight);
        }
        else
        {
            WindowService.RestoreToDesktop();
        }
    }

    private string ProtocolBadgeText
    {
        get
        {
            if (State.SelectedReaderId is { } id && State.Find(id) is { } reader)
            {
                if (reader.NegotiatedProtocolVersion is not null)
                {
                    return reader.NegotiatedProtocolVersion switch
                    {
                        LlrpProtocolVersion.Version101 => "LLRP 1.0.1",
                        LlrpProtocolVersion.Version11 => "LLRP 1.1",
                        LlrpProtocolVersion.Version20 => "LLRP 2.0",
                        _ => $"LLRP {reader.NegotiatedProtocolVersion}",
                    };
                }

                return reader.Profile.LlrpVersion switch
                {
                    LlrpProtocolVersionOption.Auto => "LLRP Auto (2.0 / 1.1 / 1.0.1)",
                    LlrpProtocolVersionOption.Force101 => "LLRP 1.0.1 (Force)",
                    LlrpProtocolVersionOption.Force11 => "LLRP 1.1 (Force)",
                    LlrpProtocolVersionOption.Force20 => "LLRP 2.0 (Force)",
                    _ => "LLRP 1.0.1 / 1.1 / 2.0",
                };
            }
            return "LLRP 1.0.1 / 1.1 / 2.0";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        State.Changed += OnChanged;
        VirtualDevices.Changed += OnChanged;
        clockTimer = new System.Threading.Timer(_ =>
        {
            currentTime = DateTime.Now.ToString("HH:mm:ss");
            _ = InvokeAsync(StateHasChanged);
        }, null, 1000, 1000);
    }

    private void ToggleNavigation() => navigationCollapsed = !navigationCollapsed;

    private void OnChanged(object? sender, EventArgs args) => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        clockTimer?.Dispose();
        State.Changed -= OnChanged;
        VirtualDevices.Changed -= OnChanged;
    }
}
