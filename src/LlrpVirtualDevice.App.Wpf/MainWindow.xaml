<mah:MetroWindow
    x:Class="LlrpVirtualDevice.App.Wpf.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp"
    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
    xmlns:views="clr-namespace:LlrpVirtualDevice.App.Wpf.Views"
    xmlns:vm="clr-namespace:LlrpVirtualDevice.App.Wpf.ViewModels"
    Title="LLRP 虚拟设备管理中心 - Virtual Device Center"
    Icon="pack://application:,,,/LlrpVirtualDeviceStudio;component/Assets/LlrpReader_Pro_Icon_Light.png"
    Width="1280"
    Height="800"
    MinWidth="1024"
    MinHeight="680"
    GlowBrush="{DynamicResource MahApps.Brushes.Accent}"
    WindowStartupLocation="CenterScreen"
    mah:DialogParticipation.Register="{Binding}"
    mc:Ignorable="d">

    <mah:MetroWindow.IconTemplate>
        <DataTemplate>
            <Image RenderOptions.BitmapScalingMode="HighQuality"
                   Width="20" Height="20" Stretch="Uniform"
                   Source="pack://application:,,,/LlrpVirtualDeviceStudio;component/Assets/LlrpReader_Pro_Icon_Light.png" />
        </DataTemplate>
    </mah:MetroWindow.IconTemplate>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="30" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="270" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 左侧侧边栏 -->
        <Border Grid.Row="0" Grid.Column="0"
                BorderBrush="{DynamicResource MahApps.Brushes.Accent}"
                BorderThickness="0,0,1,0"
                Background="{DynamicResource MahApps.Brushes.ThemeBackground}">
            <Grid>
                <DockPanel Margin="0,16,0,12">
                    <!-- 底部状态与关于 -->
                    <StackPanel Margin="16,8,16,4" DockPanel.Dock="Bottom">
                        <TextBlock Margin="0,0,0,6" FontSize="11" Text="{Binding Status}" TextWrapping="Wrap" Foreground="{DynamicResource MahApps.Brushes.Gray2}" />
                        <Button Command="{Binding ShowAboutCommand}" Style="{StaticResource NavigationButtonStyle}">
                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                <fa:IconBlock Width="20" Margin="0,0,10,0" VerticalAlignment="Center" FontSize="16" Foreground="{DynamicResource MahApps.Brushes.Accent}" Icon="CircleInfo" IconFont="Solid" />
                                <TextBlock VerticalAlignment="Center" Text="关于 / About Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- 顶部品牌与读写器列表 -->
                    <StackPanel>
                        <Border Margin="12,0,12,18" Padding="16,14" BorderBrush="{DynamicResource MahApps.Brushes.Accent}" BorderThickness="4,0,0,0">
                            <StackPanel>
                                <TextBlock FontSize="24" FontWeight="Bold" Foreground="{DynamicResource MahApps.Brushes.Accent}" Text="LLRP" />
                                <TextBlock Margin="0,2,0,0" FontSize="11" FontWeight="Bold" Text="VIRTUAL DEVICE CENTER" />
                                <TextBlock Margin="0,2,0,0" FontSize="10" Foreground="{DynamicResource MahApps.Brushes.Gray2}" Text="虚拟设备管理中心" />
                            </StackPanel>
                        </Border>

                        <!-- 读写器列表标题与操作 -->
                        <DockPanel Margin="16,10,16,8">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Command="{Binding StartAllCommand}" Style="{StaticResource SuccessCircleButtonStyle}" Width="24" Height="24" ToolTip="启动全部读写器" Margin="0,0,4,0">
                                    <fa:IconBlock Icon="Play" IconFont="Solid" FontSize="10" />
                                </Button>
                                <Button Command="{Binding StopAllCommand}" Style="{StaticResource DangerCircleButtonStyle}" Width="24" Height="24" ToolTip="停止全部读写器" Margin="0,0,4,0">
                                    <fa:IconBlock Icon="Stop" IconFont="Solid" FontSize="10" />
                                </Button>
                                <Button Command="{Binding OpenAddDialogCommand}" Style="{StaticResource FlatCircleButtonStyle}" Width="24" Height="24" ToolTip="新建虚拟读写器">
                                    <fa:IconBlock Icon="Plus" IconFont="Solid" FontSize="11" />
                                </Button>
                            </StackPanel>
                            <TextBlock VerticalAlignment="Center" FontSize="11" FontWeight="Bold" Text="VIRTUAL READERS" Foreground="{DynamicResource MahApps.Brushes.Gray2}" />
                        </DockPanel>

                        <!-- 设备列表 -->
                        <Grid Margin="12,0">
                            <ListBox MaxHeight="520"
                                     BorderThickness="0"
                                     ItemsSource="{Binding DeviceList}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     SelectedItem="{Binding SelectedDevice}">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="ItemBorder" Margin="0,2" Background="Transparent" BorderThickness="0" CornerRadius="4">
                                                        <ContentPresenter />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource MahApps.Brushes.Gray8}" />
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource MahApps.Brushes.Gray7}" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>

                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:DeviceItemViewModel}">
                                        <Border Padding="10,8" Background="Transparent">
                                            <Border.InputBindings>
                                                <MouseBinding Gesture="LeftClick"
                                                              Command="{Binding DataContext.SelectDeviceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                              CommandParameter="{Binding}" />
                                            </Border.InputBindings>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <!-- 状态呼吸灯 -->
                                                <Ellipse Grid.Column="0" Width="9" Height="9" Margin="0,0,10,0" Fill="{Binding State, Converter={StaticResource StateToBrushConverter}}" VerticalAlignment="Center" />

                                                <!-- 实例信息 -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Config.Name}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" />
                                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                        <TextBlock Text="{Binding EndpointDisplay}" FontSize="11" Foreground="{DynamicResource MahApps.Brushes.Accent}" FontWeight="Bold" FontFamily="Consolas, Courier New" />
                                                        <TextBlock Text=" | " FontSize="11" Foreground="{DynamicResource MahApps.Brushes.Gray5}" />
                                                        <TextBlock Text="{Binding Config.DeviceProfile}" FontSize="11" Foreground="{DynamicResource MahApps.Brushes.Gray2}" />
                                                    </StackPanel>
                                                </StackPanel>

                                                <!-- 连入客户端数量 Badge -->
                                                <Border Grid.Column="2"
                                                        Visibility="{Binding ConnectedClientCount, Converter={StaticResource CountToVisibilityConverter}}"
                                                        Background="#16A34A"
                                                        CornerRadius="8"
                                                        Padding="6,1"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding ConnectedClientCount, StringFormat='{}连: {0}'}" Foreground="White" FontSize="10" FontWeight="Bold" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </StackPanel>
                </DockPanel>
            </Grid>
        </Border>

        <!-- 右侧主工作区 -->
        <Grid Grid.Row="0" Grid.Column="1" Background="{DynamicResource MahApps.Brushes.ThemeBackground}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 顶部工作区 Title & Controls Bar -->
            <Border Grid.Row="0" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource MahApps.Brushes.Gray7}" Padding="20,12">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentView}" Value="About">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding SelectedDevice}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid DataContext="{Binding SelectedDevice}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 第一行: 设备信息与启停控制 -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- 左侧状态、端点与客户端在线指示 -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="12" Height="12" Margin="0,0,10,0" Fill="{Binding State, Converter={StaticResource StateToBrushConverter}}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Config.Name}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource MahApps.Brushes.Text}" VerticalAlignment="Center" />

                            <!-- 运行状态 Badge -->
                            <Border Margin="12,0,0,0" Padding="8,2" CornerRadius="4" Background="{DynamicResource MahApps.Brushes.Gray8}" VerticalAlignment="Center">
                                <TextBlock Text="{Binding State, Converter={StaticResource StateToTextConverter}}" FontSize="11" FontWeight="SemiBold" />
                            </Border>

                            <!-- TCP 监听端点 Badge -->
                            <Border Margin="10,0,0,0" Padding="8,3" CornerRadius="4" Background="{DynamicResource MahApps.Brushes.Accent4}" BorderThickness="1" BorderBrush="{DynamicResource MahApps.Brushes.Accent}" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <fa:IconBlock Icon="NetworkWired" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="{DynamicResource MahApps.Brushes.Accent}" />
                                    <TextBlock Text="TCP: " FontSize="11" FontWeight="Bold" Foreground="{DynamicResource MahApps.Brushes.Gray2}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding EndpointDisplay}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource MahApps.Brushes.Accent}" FontFamily="Consolas, Courier New" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <!-- 客户端连接状态 Badge -->
                            <Border Margin="10,0,0,0" Padding="8,3" CornerRadius="4" VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.Gray8}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasConnectedClients}" Value="True">
                                                <Setter Property="Background" Value="#E6F4EA" />
                                                <Setter Property="BorderThickness" Value="1" />
                                                <Setter Property="BorderBrush" Value="#16A34A" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal">
                                    <fa:IconBlock Icon="Desktop" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center">
                                        <fa:IconBlock.Style>
                                            <Style TargetType="fa:IconBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Gray2}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasConnectedClients}" Value="True">
                                                        <Setter Property="Foreground" Value="#16A34A" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </fa:IconBlock.Style>
                                    </fa:IconBlock>
                                    <TextBlock Text="{Binding ConnectedClientsSummary}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Gray2}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasConnectedClients}" Value="True">
                                                        <Setter Property="Foreground" Value="#137333" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <!-- LLRP 协议版本 -->
                            <TextBlock Margin="12,0,0,0" Text="{Binding Config.ProtocolVersion, StringFormat='{}LLRP {0}'}" FontSize="12" Foreground="{DynamicResource MahApps.Brushes.Gray3}" VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- 右侧状态联动的启停控制按钮 -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Command="{Binding StartCommand}" IsEnabled="{Binding CanStart}" Style="{StaticResource PrimaryActionButtonStyle}" Height="32" Margin="0,0,8,0" ToolTip="启动虚拟服务">
                                <StackPanel Orientation="Horizontal">
                                    <fa:IconBlock Icon="Play" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="启动" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding RestartCommand}" IsEnabled="{Binding IsRunning}" Style="{StaticResource FlatActionButtonStyle}" Height="32" Margin="0,0,8,0" ToolTip="重启虚拟服务">
                                <StackPanel Orientation="Horizontal">
                                    <fa:IconBlock Icon="RotateRight" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="重启" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding StopCommand}" IsEnabled="{Binding CanStop}" Style="{StaticResource FlatActionButtonStyle}" Height="32" Margin="0,0,8,0" ToolTip="停止虚拟服务">
                                <StackPanel Orientation="Horizontal">
                                    <fa:IconBlock Icon="Stop" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="#DC2626" />
                                    <TextBlock Text="停止" Foreground="#DC2626" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding DataContext.DeleteDeviceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"
                                    IsEnabled="{Binding CanEditConfig}"
                                    Style="{StaticResource FlatCircleButtonStyle}"
                                    Width="32" Height="32"
                                    ToolTip="删除读写器 (运行中不可删除)">
                                <fa:IconBlock Icon="Trash" FontSize="12" Foreground="#DC2626" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- 第二行: 该设备专属的子功能页签 -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal">
                        <Button Command="{Binding SwitchTabCommand}" CommandParameter="Overview" Style="{StaticResource FlatActionButtonStyle}" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <fa:IconBlock Icon="ChartPie" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="{DynamicResource MahApps.Brushes.Accent}" />
                                <TextBlock Text="概览与客户端" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding SwitchTabCommand}" CommandParameter="Settings" Style="{StaticResource FlatActionButtonStyle}" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <fa:IconBlock Icon="Gear" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="{DynamicResource MahApps.Brushes.Accent}" />
                                <TextBlock Text="设备配置与参数" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding SwitchTabCommand}" CommandParameter="TagPool" Style="{StaticResource FlatActionButtonStyle}" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <fa:IconBlock Icon="Tags" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="{DynamicResource MahApps.Brushes.Accent}" />
                                <TextBlock Text="标签库与射频模拟" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding SwitchTabCommand}" CommandParameter="PacketInspector" Style="{StaticResource FlatActionButtonStyle}" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <fa:IconBlock Icon="Terminal" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="{DynamicResource MahApps.Brushes.Accent}" />
                                <TextBlock Text="报文监控台 (Inspector)" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding SwitchTabCommand}" CommandParameter="FaultInjection" Style="{StaticResource FlatActionButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <fa:IconBlock Icon="Bolt" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="{DynamicResource MahApps.Brushes.Accent}" />
                                <TextBlock Text="故障与事件注入" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 工作区内容区 -->
            <Grid Grid.Row="1">
                <!-- 关于页面 -->
                <views:AboutView DataContext="{Binding AboutVm}">
                    <views:AboutView.Style>
                        <Style TargetType="UserControl">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DataContext.CurrentView, RelativeSource={RelativeSource AncestorType=Window}}" Value="About">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </views:AboutView.Style>
                </views:AboutView>

                <!-- 设备内容页面 (当选中设备且不是 About 时) -->
                <Grid DataContext="{Binding SelectedDevice}">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DataContext.CurrentView, RelativeSource={RelativeSource AncestorType=Window}}" Value="About">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding DataContext.SelectedDevice, RelativeSource={RelativeSource AncestorType=Window}}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <!-- Tab 1: Overview -->
                    <views:DeviceOverviewView>
                        <views:DeviceOverviewView.Style>
                            <Style TargetType="UserControl">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveTab}" Value="Overview">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </views:DeviceOverviewView.Style>
                    </views:DeviceOverviewView>

                    <!-- Tab 2: Settings -->
                    <views:DeviceSettingsView>
                        <views:DeviceSettingsView.Style>
                            <Style TargetType="UserControl">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveTab}" Value="Settings">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </views:DeviceSettingsView.Style>
                    </views:DeviceSettingsView>

                    <!-- Tab 3: TagPool -->
                    <views:TagPoolView>
                        <views:TagPoolView.Style>
                            <Style TargetType="UserControl">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveTab}" Value="TagPool">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </views:TagPoolView.Style>
                    </views:TagPoolView>

                    <!-- Tab 4: PacketInspector -->
                    <views:PacketInspectorView>
                        <views:PacketInspectorView.Style>
                            <Style TargetType="UserControl">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveTab}" Value="PacketInspector">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </views:PacketInspectorView.Style>
                    </views:PacketInspectorView>

                    <!-- Tab 5: FaultInjection -->
                    <views:FaultInjectionView>
                        <views:FaultInjectionView.Style>
                            <Style TargetType="UserControl">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveTab}" Value="FaultInjection">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </views:FaultInjectionView.Style>
                    </views:FaultInjectionView>
                </Grid>

                <!-- 空状态 (未选择设备或列表为空) -->
                <Border VerticalAlignment="Center" HorizontalAlignment="Center" Padding="30">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding SelectedDevice}" Value="{x:Null}" />
                                        <Condition Binding="{Binding CurrentView}" Value="Device" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <fa:IconBlock Icon="Server" FontSize="48" Foreground="{DynamicResource MahApps.Brushes.Gray5}" HorizontalAlignment="Center" Margin="0,0,0,16" />
                        <TextBlock Text="暂无选中的虚拟读写器" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource MahApps.Brushes.Text}" HorizontalAlignment="Center" />
                        <TextBlock Text="请在左侧列表中选择实例，或点击 “+” 按钮新建虚拟读写器" FontSize="12" Foreground="{DynamicResource MahApps.Brushes.Gray2}" Margin="0,8,0,0" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- 底部状态栏 -->
        <Border Grid.Row="1" Grid.ColumnSpan="2" Background="{DynamicResource MahApps.Brushes.ThemeBackground}" BorderBrush="{DynamicResource MahApps.Brushes.Gray7}" BorderThickness="0,1,0,0" Padding="16,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Status}" FontSize="11" Foreground="{DynamicResource MahApps.Brushes.Gray2}" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="LLRP Server Engine: LLRPCSharp (1.0.1 / 1.1 / 2.0)" FontSize="11" Foreground="{DynamicResource MahApps.Brushes.Gray3}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 新建虚拟设备模态蒙层 -->
        <Grid Grid.RowSpan="2" Grid.ColumnSpan="2" Visibility="{Binding IsAddDialogOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Background="#66000000" />
            <views:AddDeviceView DataContext="{Binding AddDialogVm}" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>

        <!-- 自绘现代弹窗与 Toast 消息通知层 (完全匹配当前 WPF 风格) -->
        <views:CustomDialogOverlay DataContext="{Binding DialogService}" Grid.RowSpan="2" Grid.ColumnSpan="2" Panel.ZIndex="1000" />
    </Grid>
</mah:MetroWindow>
