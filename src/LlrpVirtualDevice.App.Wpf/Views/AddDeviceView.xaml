<UserControl x:Class="LlrpVirtualDevice.App.Wpf.Views.AddDeviceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             mc:Ignorable="d"
             d:DesignHeight="550" d:DesignWidth="620">
    <Border Style="{StaticResource StandardCardStyle}"
            BorderBrush="{DynamicResource MahApps.Brushes.Gray7}"
            BorderThickness="1"
            CornerRadius="4"
            Background="{DynamicResource MahApps.Brushes.ThemeBackground}"
            Padding="24"
            Width="580">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.25" />
        </Border.Effect>

        <StackPanel>
            <!-- 标题区 -->
            <TextBlock Text="新建虚拟读写器实例" FontSize="20" FontWeight="SemiBold"
                       Foreground="{DynamicResource MahApps.Brushes.Accent}" />
            <TextBlock Text="配置虚拟 LLRP 读写器的网络监听端点、协议版本与模拟设备画像。"
                       FontSize="12" Foreground="{DynamicResource MahApps.Brushes.Gray3}" Margin="0,4,0,16" TextWrapping="Wrap" />

            <Separator Margin="0,0,0,18" Background="{DynamicResource MahApps.Brushes.Gray7}" />

            <!-- 表单字段区 -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 实例名称 -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="实例名称:" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="13" Opacity="0.85" Margin="0,8" />
                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,4" Padding="8,6" FontSize="13" />

                <!-- 监听地址 -->
                <TextBlock Grid.Row="1" Grid.Column="0" Text="监听 IP 地址:" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="13" Opacity="0.85" Margin="0,8" />
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ListenAddress, UpdateSourceTrigger=PropertyChanged}" Margin="0,4" Padding="8,6" FontSize="13" />

                <!-- 监听端口 -->
                <TextBlock Grid.Row="2" Grid.Column="0" Text="TCP 端口:" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="13" Opacity="0.85" Margin="0,8" />
                <mah:NumericUpDown Grid.Row="2" Grid.Column="1" Value="{Binding Port}" Minimum="1024" Maximum="65535" Margin="0,4" Padding="6,4" FontSize="13" HorizontalAlignment="Left" Width="140" />

                <!-- 模拟厂商/型号 -->
                <TextBlock Grid.Row="3" Grid.Column="0" Text="模拟设备型号:" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="13" Opacity="0.85" Margin="0,8" />
                <ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{Binding AvailableProfiles}" SelectedItem="{Binding DeviceProfile}" Margin="0,4" Padding="8,6" FontSize="13" />

                <!-- 协议版本 -->
                <TextBlock Grid.Row="4" Grid.Column="0" Text="LLRP 协议版本:" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="13" Opacity="0.85" Margin="0,8" />
                <ComboBox Grid.Row="4" Grid.Column="1" ItemsSource="{Binding AvailableProtocolVersions}" SelectedItem="{Binding ProtocolVersion}" Margin="0,4" Padding="8,6" FontSize="13" />

                <!-- 天线数量 -->
                <TextBlock Grid.Row="5" Grid.Column="0" Text="最大天线数量:" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="13" Opacity="0.85" Margin="0,8" />
                <mah:NumericUpDown Grid.Row="5" Grid.Column="1" Value="{Binding MaxAntennas}" Minimum="1" Maximum="32" Margin="0,4" Padding="6,4" FontSize="13" HorizontalAlignment="Left" Width="140" />

                <!-- 隐式停止策略 -->
                <TextBlock Grid.Row="6" Grid.Column="0" Text="ROSpec 禁用策略:" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="13" Opacity="0.85" Margin="0,8" />
                <CheckBox Grid.Row="6" Grid.Column="1" IsChecked="{Binding AllowImplicitStopOnDisable}" Content="允许在 Disable 时隐式停止 ROSpec 执行" Margin="0,6" VerticalAlignment="Center" />
            </Grid>

            <Separator Margin="0,0,0,16" Background="{DynamicResource MahApps.Brushes.Gray7}" />

            <!-- 底部按钮组 -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Command="{Binding CancelCommand}" Style="{StaticResource FlatActionButtonStyle}" Margin="0,0,10,0" Width="90" Height="34" Content="取消" />
                <Button Command="{Binding SaveCommand}" Style="{StaticResource PrimaryActionButtonStyle}" Width="110" Height="34" Content="创建并保存" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
