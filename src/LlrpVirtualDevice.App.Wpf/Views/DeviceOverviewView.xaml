<UserControl x:Class="LlrpVirtualDevice.App.Wpf.Views.DeviceOverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
        <StackPanel>
            <!-- 统计指标指示板 (SummaryCard 规范) -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 卡片 1: 运行状态 -->
                <Border Grid.Column="0" Style="{StaticResource SummaryCardStyle}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="服务状态" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource MahApps.Brushes.Gray2}" />
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0" VerticalAlignment="Center">
                            <Ellipse Width="10" Height="10" Fill="{Binding State, Converter={StaticResource StateToBrushConverter}}" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding State, Converter={StaticResource StateToTextConverter}}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource MahApps.Brushes.Text}" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 卡片 2: TCP 监听端点 (明确展示 IP:Port) -->
                <Border Grid.Column="1" Style="{StaticResource SummaryCardStyle}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="TCP 监听端点 (IP:Port)" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource MahApps.Brushes.Gray2}" />
                        <TextBlock Text="{Binding EndpointDisplay}" FontSize="18" FontWeight="Bold" Margin="0,5,0,0" Foreground="{DynamicResource MahApps.Brushes.Accent}" FontFamily="Consolas, Courier New" />
                    </StackPanel>
                </Border>

                <!-- 卡片 3: 已连客户端 -->
                <Border Grid.Column="2" Style="{StaticResource SummaryCardStyle}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="已连接客户端 (Clients)" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource MahApps.Brushes.Gray2}" />
                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ConnectedClientCount}" FontSize="20" FontWeight="Bold" Foreground="#16A34A" />
                            <TextBlock Text=" 个在线" FontSize="12" Foreground="{DynamicResource MahApps.Brushes.Gray2}" VerticalAlignment="Bottom" Margin="4,0,0,2" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 卡片 4: 报文计数 -->
                <Border Grid.Column="3" Style="{StaticResource SummaryCardStyle}">
                    <StackPanel>
                        <TextBlock Text="已处理 LLRP 报文" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource MahApps.Brushes.Gray2}" />
                        <TextBlock Text="{Binding TotalMessagesProcessed}" FontSize="20" FontWeight="Bold" Margin="0,5,0,0" Foreground="{DynamicResource MahApps.Brushes.Text}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 基础配置摘要卡片 -->
            <Border Style="{StaticResource StandardCardStyle}">
                <StackPanel>
                    <TextBlock Text="设备配置与参数 (Device Parameters)" FontSize="13" FontWeight="Bold" Margin="0,0,0,12" Foreground="{DynamicResource MahApps.Brushes.Text}" />
                    <WrapPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,32,8">
                            <TextBlock Text="实例标识: " Foreground="{DynamicResource MahApps.Brushes.Gray2}" />
                            <TextBlock Text="{Binding Config.Name}" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,32,8">
                            <TextBlock Text="监听端点: " Foreground="{DynamicResource MahApps.Brushes.Gray2}" />
                            <TextBlock Text="{Binding EndpointDisplay}" FontWeight="SemiBold" FontFamily="Consolas, Courier New" Foreground="{DynamicResource MahApps.Brushes.Accent}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,32,8">
                            <TextBlock Text="协议版本: " Foreground="{DynamicResource MahApps.Brushes.Gray2}" />
                            <TextBlock Text="{Binding Config.ProtocolVersion, StringFormat='{}LLRP {0}'}" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,32,8">
                            <TextBlock Text="模拟型号: " Foreground="{DynamicResource MahApps.Brushes.Gray2}" />
                            <TextBlock Text="{Binding Config.DeviceProfile}" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,32,8">
                            <TextBlock Text="天线通道数: " Foreground="{DynamicResource MahApps.Brushes.Gray2}" />
                            <TextBlock Text="{Binding Config.MaxAntennas, StringFormat='{}通道 1 ~ {0}'}" FontWeight="SemiBold" />
                        </StackPanel>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- 已连接客户端列表卡片 (强化客户端 IP:Port 显示) -->
            <Border Style="{StaticResource StandardCardStyle}">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="已连接上位机客户端列表 (Connected Clients - IP &amp; Port)" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" Foreground="{DynamicResource MahApps.Brushes.Text}" />
                            <Border Margin="10,0,0,0" Background="#E6F4EA" CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding ConnectedClientCount, StringFormat='{}在线: {0} 个'}" Foreground="#137333" FontSize="11" FontWeight="Bold" />
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- 客户端表格 -->
                    <DataGrid ItemsSource="{Binding ConnectedClients}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="{DynamicResource MahApps.Brushes.Gray8}"
                              RowHeight="38"
                              FontSize="12"
                              BorderThickness="1"
                              BorderBrush="{DynamicResource MahApps.Brushes.Gray7}"
                              MinHeight="100"
                              MaxHeight="320">
                        <DataGrid.Columns>
                            <!-- 客户端远程 IP:Port (突出显示) -->
                            <DataGridTemplateColumn Header="客户端 IP:Port (Remote EndPoint)" Width="260">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
                                            <fa:IconBlock Icon="Desktop" FontSize="13" Foreground="{DynamicResource MahApps.Brushes.Accent}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding RemoteEndPoint}" FontWeight="Bold" FontSize="13" FontFamily="Consolas, Courier New" Foreground="{DynamicResource MahApps.Brushes.Accent}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="会话 ID (Connection ID)" Binding="{Binding ConnectionId}" Width="160" ElementStyle="{StaticResource LeftMonoCellTextStyle}" />
                            <DataGridTextColumn Header="协商 LLRP 协议" Binding="{Binding NegotiatedVersion}" Width="120" ElementStyle="{StaticResource CenteredCellTextStyle}" />
                            <DataGridTextColumn Header="接入时间" Binding="{Binding ConnectedAt, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}" Width="170" ElementStyle="{StaticResource CenteredCellTextStyle}" />
                            <DataGridTemplateColumn Header="连接状态" Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="#E6F4EA" CornerRadius="4" Padding="8,2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="6" Height="6" Fill="#16A34A" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                <TextBlock Text="Online" Foreground="#137333" FontWeight="Bold" FontSize="11" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- 当没有客户端连接时的友好提示 -->
                    <Border Margin="0,10,0,0" Padding="14,10" Background="{DynamicResource MahApps.Brushes.Gray10}" BorderBrush="{DynamicResource MahApps.Brushes.Gray8}" BorderThickness="1" CornerRadius="4">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasConnectedClients}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <fa:IconBlock Icon="CircleInfo" FontSize="14" Foreground="{DynamicResource MahApps.Brushes.Gray2}" Margin="0,0,10,0" VerticalAlignment="Center" />
                            <TextBlock Text="当前暂无上位机连接。请在上位机软件 (如 LlrpReaderStudio) 中添加 Reader 并连接至 " FontSize="12" Foreground="{DynamicResource MahApps.Brushes.Gray2}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding EndpointDisplay}" FontSize="12" FontWeight="Bold" FontFamily="Consolas, Courier New" Foreground="{DynamicResource MahApps.Brushes.Accent}" VerticalAlignment="Center" />
                            <TextBlock Text="。" FontSize="12" Foreground="{DynamicResource MahApps.Brushes.Gray2}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
