<UserControl x:Class="LlrpVirtualDevice.App.Wpf.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             mc:Ignorable="d"
             d:DesignHeight="750" d:DesignWidth="850">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="28,24" MaxWidth="880" HorizontalAlignment="Left">
            <StackPanel>
                <!-- 顶部返回导航与快捷按钮 -->
                <DockPanel Margin="0,0,0,20">
                    <Button Command="{Binding ReturnToDevicesCommand}"
                            Style="{StaticResource FlatActionButtonStyle}"
                            Height="32"
                            ToolTip="返回虚拟读写器管理工作区">
                        <StackPanel Orientation="Horizontal">
                            <fa:IconBlock Icon="ArrowLeft" FontSize="11" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{DynamicResource MahApps.Brushes.Accent}" />
                            <TextBlock Text="返回读写器工作区" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>

                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Command="{Binding CopyDiagnosticsCommand}"
                                Style="{StaticResource FlatActionButtonStyle}"
                                Height="32" Margin="0,0,8,0"
                                ToolTip="复制诊断与系统环境信息到剪贴板">
                            <StackPanel Orientation="Horizontal">
                                <fa:IconBlock Icon="Copy" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="复制诊断信息" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding OpenConfigFolderCommand}"
                                Style="{StaticResource FlatActionButtonStyle}"
                                Height="32"
                                ToolTip="在文件资源管理器中打开数据存储目录">
                            <StackPanel Orientation="Horizontal">
                                <fa:IconBlock Icon="FolderOpen" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="打开配置目录" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </DockPanel>

                <!-- 主卡片 -->
                <Border Style="{StaticResource StandardCardStyle}" Padding="28" Margin="0,0,0,20">
                    <StackPanel>
                        <!-- 标题与版本 -->
                        <TextBlock Text="{Binding AppTitle}" FontSize="26" FontWeight="SemiBold"
                                   Foreground="{DynamicResource MahApps.Brushes.Accent}" />
                        <TextBlock Text="{Binding AppEnglishTitle}" FontSize="13"
                                   Foreground="{DynamicResource MahApps.Brushes.Gray3}" Margin="0,3,0,0" />
                        <TextBlock FontSize="12" Foreground="{DynamicResource MahApps.Brushes.Gray2}" Margin="0,4,0,0">
                            <Run Text="版本: " /><Run Text="{Binding Version, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="  |  " /><Run Text="{Binding EngineVersion, Mode=OneWay}" /><Run Text="  |  .NET 10.0 (Windows x64)" />
                        </TextBlock>

                        <Separator Margin="0,16" Background="{DynamicResource MahApps.Brushes.Gray7}" />

                        <!-- 描述说明 -->
                        <TextBlock Text="{Binding Description}" TextWrapping="Wrap" FontSize="13"
                                   LineHeight="22" Margin="0,0,0,20" Foreground="{DynamicResource MahApps.Brushes.Text}" />

                        <!-- 协议与画像矩阵 -->
                        <TextBlock Text="支持协议标准与设备画像" FontSize="14" FontWeight="SemiBold"
                                   Margin="0,0,0,10" Foreground="{DynamicResource MahApps.Brushes.Text}" />
                        <Border Background="{DynamicResource MahApps.Brushes.Gray10}" Padding="16" CornerRadius="4" Margin="0,0,0,18">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <TextBlock Text="LLRP 1.0.1" FontWeight="Bold" FontSize="12" Margin="0,0,0,4" Foreground="{DynamicResource MahApps.Brushes.Text}" />
                                    <TextBlock Text="• 标准 ROSpec 寻卡&#x0a;• AccessSpec 读写&#x0a;• 事件与报告管道" FontSize="11" LineHeight="17" Foreground="{DynamicResource MahApps.Brushes.Gray2}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                    <TextBlock Text="LLRP 1.1" FontWeight="Bold" FontSize="12" Margin="0,0,0,4" Foreground="{DynamicResource MahApps.Brushes.Text}" />
                                    <TextBlock Text="• 协议版本自协商&#x0a;• MaxReceiveSensitivity&#x0a;• 增强事件与状态上报" FontSize="11" LineHeight="17" Foreground="{DynamicResource MahApps.Brushes.Gray2}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="0,0,12,0">
                                    <TextBlock Text="LLRP 2.0" FontWeight="Bold" FontSize="12" Margin="0,0,0,4" Foreground="{DynamicResource MahApps.Brushes.Text}" />
                                    <TextBlock Text="• 2.0 报文集与握手&#x0a;• 安全与鉴权扩展&#x0a;• 紧凑型报文适配" FontSize="11" LineHeight="17" Foreground="{DynamicResource MahApps.Brushes.Gray2}" />
                                </StackPanel>
                                <StackPanel Grid.Column="3">
                                    <TextBlock Text="厂商扩展画像" FontWeight="Bold" FontSize="12" Margin="0,0,0,4" Foreground="{DynamicResource MahApps.Brushes.Text}" />
                                    <TextBlock Text="• Impinj Speedway R420&#x0a;• FastID / Phase / Doppler&#x0a;• Zebra FX9600 画像" FontSize="11" LineHeight="17" Foreground="{DynamicResource MahApps.Brushes.Gray2}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- 系统环境与路径 -->
                        <TextBlock Text="系统环境与数据路径" FontSize="14" FontWeight="SemiBold"
                                   Margin="0,0,0,10" Foreground="{DynamicResource MahApps.Brushes.Text}" />
                        <Border Background="{DynamicResource MahApps.Brushes.Gray10}" Padding="16" CornerRadius="4" Margin="0,0,0,18">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="操作系统:" FontWeight="SemiBold" FontSize="12" Margin="0,3" Foreground="{DynamicResource MahApps.Brushes.Gray2}" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding OsVersion}" FontSize="12" Margin="0,3" Foreground="{DynamicResource MahApps.Brushes.Text}" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text=".NET 运行时:" FontWeight="SemiBold" FontSize="12" Margin="0,3" Foreground="{DynamicResource MahApps.Brushes.Gray2}" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DotNetVersion}" FontSize="12" Margin="0,3" Foreground="{DynamicResource MahApps.Brushes.Text}" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="数据配置目录:" FontWeight="SemiBold" FontSize="12" Margin="0,3" Foreground="{DynamicResource MahApps.Brushes.Gray2}" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ConfigDirectory}" FontSize="12" FontFamily="Consolas, Courier New" Margin="0,3" Foreground="{DynamicResource MahApps.Brushes.Accent}" />

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="配置文件路径:" FontWeight="SemiBold" FontSize="12" Margin="0,3" Foreground="{DynamicResource MahApps.Brushes.Gray2}" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ConfigFilePath}" FontSize="12" FontFamily="Consolas, Courier New" Margin="0,3" Foreground="{DynamicResource MahApps.Brushes.Text}" />
                            </Grid>
                        </Border>

                        <!-- 架构说明 -->
                        <TextBlock Text="核心仿真架构规范" FontSize="14" FontWeight="SemiBold"
                                   Margin="0,0,0,10" Foreground="{DynamicResource MahApps.Brushes.Text}" />
                        <Border Background="{DynamicResource MahApps.Brushes.Gray10}" Padding="16" CornerRadius="4">
                            <StackPanel>
                                <TextBlock Text="• 真实 TCP 监听与 Socket 传输：每个虚拟读写器独立占用真实 TCP 端口（默认从 5084 递增），支持上位机及 Wireshark 完整抓包分析。" FontSize="12" LineHeight="18" TextWrapping="Wrap" Margin="0,0,0,6" Foreground="{DynamicResource MahApps.Brushes.Text}" />
                                <TextBlock Text="• 射频仿真场景：支持 Static（静态）、MovingTags（移动）与 Noisy（噪声）仿真模式，模拟标签检出概率与 RSSI 抖动。" FontSize="12" LineHeight="18" TextWrapping="Wrap" Margin="0,0,0,6" Foreground="{DynamicResource MahApps.Brushes.Text}" />
                                <TextBlock Text="• 报文监控台 (Packet Inspector)：实时拦截、解析与记录上行/下行 LLRP 报文结构，便于排查上位机协议兼容性问题。" FontSize="12" LineHeight="18" TextWrapping="Wrap" Foreground="{DynamicResource MahApps.Brushes.Text}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
