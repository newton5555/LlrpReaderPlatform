<UserControl x:Class="LlrpVirtualDevice.App.Wpf.Views.TagPoolView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 顶部操作与参数卡片 (StandardCardStyle) -->
        <Border Grid.Row="0" Style="{StaticResource StandardCardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="虚拟标签库与射频模拟" FontSize="14" FontWeight="Bold" Margin="0,0,16,0" VerticalAlignment="Center" Foreground="{DynamicResource MahApps.Brushes.Text}" />
                        <Border Background="{DynamicResource MahApps.Brushes.Gray8}" CornerRadius="4" Padding="8,2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Tags.Count, StringFormat='{}标签总数: {0}'}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource MahApps.Brushes.Text}" />
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Command="{Binding AddTagCommand}" IsEnabled="{Binding CanEditConfig}" Style="{StaticResource PrimaryActionButtonStyle}" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <fa:IconBlock Icon="Plus" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="添加标签" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding GenerateBatchTagsCommand}" CommandParameter="20" IsEnabled="{Binding CanEditConfig}" Style="{StaticResource FlatActionButtonStyle}" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <fa:IconBlock Icon="WandMagicSparkles" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="快速生成 20 张" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding DeleteSelectedTagCommand}" IsEnabled="{Binding CanEditConfig}" Style="{StaticResource FlatActionButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <fa:IconBlock Icon="Trash" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="#DC2626" />
                                <TextBlock Text="删除所选" Foreground="#DC2626" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- 射频模拟参数行 -->
                <WrapPanel Grid.Row="1" Margin="0,14,0,0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,28,4" VerticalAlignment="Center">
                        <TextBlock Text="射频仿真场景:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12" />
                        <ComboBox SelectedValue="{Binding Config.Scenario}" IsEnabled="{Binding CanEditConfig}" Width="130" Height="28"
                                  ItemsSource="{Binding Source={x:Type local_vm:AddDeviceViewModel}, Path=AvailableScenarios}"
                                  xmlns:local_vm="clr-namespace:LlrpVirtualDevice.App.Wpf.ViewModels" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,28,4" VerticalAlignment="Center">
                        <TextBlock Text="读取概率:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12" />
                        <Slider Minimum="0.1" Maximum="1.0" Value="{Binding Config.DetectionProbability}" IsEnabled="{Binding CanEditConfig}" Width="100" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Config.DetectionProbability, StringFormat='{}{0:P0}'}" Margin="8,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,28,4" VerticalAlignment="Center">
                        <TextBlock Text="RSSI 抖动 (dB):" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12" />
                        <Slider Minimum="0" Maximum="15" Value="{Binding Config.RssiJitterDb}" IsEnabled="{Binding CanEditConfig}" Width="90" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Config.RssiJitterDb, StringFormat='{}±{0} dB'}" Margin="8,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold" />
                    </StackPanel>
                </WrapPanel>
            </Grid>
        </Border>

        <!-- 标签列表 DataGrid (对齐客户端规范) -->
        <Border Grid.Row="1" Style="{StaticResource StandardCardStyle}" Margin="0">
            <DataGrid ItemsSource="{Binding Tags}"
                      SelectedItem="{Binding SelectedTag}"
                      IsReadOnly="True"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="{DynamicResource MahApps.Brushes.Gray8}"
                      RowHeight="36"
                      FontSize="12"
                      BorderThickness="1"
                      BorderBrush="{DynamicResource MahApps.Brushes.Gray7}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="EPC (Hex 电子产品代码)" Binding="{Binding EpcHex}" Width="280" ElementStyle="{StaticResource LeftMonoCellTextStyle}" />
                    <DataGridTextColumn Header="TID (Hex 标签唯一标识)" Binding="{Binding TidHex}" Width="220" ElementStyle="{StaticResource LeftMonoCellTextStyle}" />
                    <DataGridTextColumn Header="天线通道" Binding="{Binding AntennaId, StringFormat='{}Antenna {0}'}" Width="110" ElementStyle="{StaticResource CenteredCellTextStyle}" />
                    <DataGridTextColumn Header="峰值 RSSI (dBm)" Binding="{Binding PeakRssi, StringFormat='{}{0} dBm'}" Width="130" ElementStyle="{StaticResource CenteredCellTextStyle}" />
                    <DataGridTextColumn Header="用户数据区 (User Memory)" Binding="{Binding UserMemoryHex}" Width="*" ElementStyle="{StaticResource LeftMonoCellTextStyle}" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
