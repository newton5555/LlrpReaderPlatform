<UserControl x:Class="LlrpVirtualDevice.App.Wpf.Views.CustomDialogOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:models="clr-namespace:LlrpVirtualDevice.App.Wpf.Models"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800">
    <Grid>
        <!-- 1. 全屏模态对话框蒙层 (当有弹窗时激活) -->
        <Grid Visibility="{Binding CurrentDialog, Converter={StaticResource NullToVisibilityConverter}}">
            <!-- 半透明背景遮罩 -->
            <Border Background="#66000000" MouseDown="Scrim_MouseDown" />

            <!-- 对话框主体卡片 (与主窗口 StandardCardStyle 统一) -->
            <Border Width="440"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{DynamicResource MahApps.Brushes.ThemeBackground}"
                    BorderBrush="{DynamicResource MahApps.Brushes.Gray7}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="22"
                    DataContext="{Binding CurrentDialog}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.25" />
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 对话框标题栏与类型图标 -->
                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- 类型图标 -->
                        <fa:IconBlock Grid.Column="0" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center">
                            <fa:IconBlock.Style>
                                <Style TargetType="fa:IconBlock">
                                    <Setter Property="Icon" Value="CircleInfo" />
                                    <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Accent}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Type}" Value="{x:Static models:DialogType.Success}">
                                            <Setter Property="Icon" Value="CircleCheck" />
                                            <Setter Property="Foreground" Value="#16A34A" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Type}" Value="{x:Static models:DialogType.Warning}">
                                            <Setter Property="Icon" Value="TriangleExclamation" />
                                            <Setter Property="Foreground" Value="#D97706" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Type}" Value="{x:Static models:DialogType.Error}">
                                            <Setter Property="Icon" Value="CircleXmark" />
                                            <Setter Property="Foreground" Value="#DC2626" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Type}" Value="{x:Static models:DialogType.Confirm}">
                                            <Setter Property="Icon" Value="CircleQuestion" />
                                            <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Accent}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Type}" Value="{x:Static models:DialogType.Input}">
                                            <Setter Property="Icon" Value="PenToSquare" />
                                            <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Accent}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </fa:IconBlock.Style>
                        </fa:IconBlock>

                        <!-- 标题文本 -->
                        <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource MahApps.Brushes.Text}" VerticalAlignment="Center" />

                        <!-- 右上角关闭按钮 -->
                        <Button Grid.Column="2" Click="CancelButton_Click" Style="{StaticResource FlatMiniButtonStyle}" ToolTip="关闭">
                            <fa:IconBlock Icon="Xmark" FontSize="10" />
                        </Button>
                    </Grid>

                    <Separator Grid.Row="0" VerticalAlignment="Bottom" Margin="0,0,0,0" Background="{DynamicResource MahApps.Brushes.Gray7}" />

                    <!-- 对话框正文区 -->
                    <StackPanel Grid.Row="1" Margin="0,14,0,18">
                        <TextBlock Text="{Binding Message}" FontSize="13" TextWrapping="Wrap" LineHeight="20" Foreground="{DynamicResource MahApps.Brushes.Text}" />

                        <!-- 输入框 (如果是输入类型弹窗) -->
                        <TextBox Margin="0,12,0,0"
                                 Padding="8,6"
                                 FontSize="13"
                                 Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                                 KeyDown="InputTextBox_KeyDown"
                                 Visibility="{Binding IsInput, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </StackPanel>

                    <!-- 对话框底部操作按钮 -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <!-- 取消按钮 (可选) -->
                        <Button Click="CancelButton_Click"
                                Content="{Binding CancelText}"
                                Visibility="{Binding ShowCancelButton, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Style="{StaticResource FlatActionButtonStyle}"
                                MinWidth="80"
                                Height="32"
                                Margin="0,0,10,0" />

                        <!-- 确定按钮 (支持 Danger 红色模式) -->
                        <Button Click="ConfirmButton_Click"
                                Content="{Binding ConfirmText}"
                                MinWidth="80"
                                Height="32">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PrimaryActionButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDangerConfirm}" Value="True">
                                            <Setter Property="Background" Value="#DC2626" />
                                            <Setter Property="BorderBrush" Value="#DC2626" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- 2. 右上角浮动轻量 Toast 提示列表 (非阻塞式反馈) -->
        <ItemsControl ItemsSource="{Binding ActiveToasts}"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Top"
                      Margin="0,20,20,0">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type models:ToastItem}">
                    <Border Background="{DynamicResource MahApps.Brushes.ThemeBackground}"
                            BorderBrush="{DynamicResource MahApps.Brushes.Gray7}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="12,10"
                            Margin="0,0,0,8"
                            MinWidth="260"
                            MaxWidth="360">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270" Color="#000000" Opacity="0.16" />
                        </Border.Effect>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Toast 图标 -->
                            <fa:IconBlock Grid.Column="0" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center">
                                <fa:IconBlock.Style>
                                    <Style TargetType="fa:IconBlock">
                                        <Setter Property="Icon" Value="CircleInfo" />
                                        <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Accent}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Type}" Value="{x:Static models:DialogType.Success}">
                                                <Setter Property="Icon" Value="CircleCheck" />
                                                <Setter Property="Foreground" Value="#16A34A" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Type}" Value="{x:Static models:DialogType.Warning}">
                                                <Setter Property="Icon" Value="TriangleExclamation" />
                                                <Setter Property="Foreground" Value="#D97706" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Type}" Value="{x:Static models:DialogType.Error}">
                                                <Setter Property="Icon" Value="CircleXmark" />
                                                <Setter Property="Foreground" Value="#DC2626" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </fa:IconBlock.Style>
                            </fa:IconBlock>

                            <!-- Toast 文本 -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource MahApps.Brushes.Text}" />
                                <TextBlock Text="{Binding Message}" FontSize="11" Foreground="{DynamicResource MahApps.Brushes.Gray2}" TextWrapping="Wrap" Margin="0,2,0,0" />
                            </StackPanel>

                            <!-- Toast 关闭按钮 -->
                            <Button Grid.Column="2" Click="ToastDismiss_Click" Tag="{Binding Id}" Style="{StaticResource FlatMiniButtonStyle}" Margin="8,0,0,0">
                                <fa:IconBlock Icon="Xmark" FontSize="9" />
                            </Button>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</UserControl>
