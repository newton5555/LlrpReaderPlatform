<UserControl x:Class="LlrpVirtualDevice.App.Wpf.Views.CustomDialogOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:models="clr-namespace:LlrpVirtualDevice.App.Wpf.Models"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800">
    <UserControl.Resources>
        <Style x:Key="DialogCloseButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#9CA3AF" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="15"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#FEE2E2" />
                                <Setter Property="Foreground" Value="#DC2626" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#FECACA" />
                                <Setter Property="Foreground" Value="#B91C1C" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToastCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource DialogCloseButtonStyle}">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="11"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#F3F4F6" />
                                <Setter Property="Foreground" Value="#4B5563" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#E5E7EB" />
                                <Setter Property="Foreground" Value="#1F2937" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- 1. 全屏模态对话框蒙层 (当有弹窗时激活) -->
        <Grid Visibility="{Binding CurrentDialog, Converter={StaticResource NullToVisibilityConverter}}">
            <!-- 半透明现代暗色遮罩 -->
            <Border Background="#8C0F172A" MouseDown="Scrim_MouseDown" />

            <!-- 对话框主体卡片 -->
            <Border MinWidth="440"
                    MaxWidth="520"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{DynamicResource MahApps.Brushes.ThemeBackground}"
                    BorderBrush="{DynamicResource MahApps.Brushes.Gray8}"
                    BorderThickness="1"
                    CornerRadius="10"
                    DataContext="{Binding CurrentDialog}"
                    SnapsToDevicePixels="True">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="32" ShadowDepth="8" Direction="270" Color="#0F172A" Opacity="0.28" />
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 顶部标题栏与类型图标 Badge -->
                    <Border Grid.Row="0" Padding="22,18,16,14" BorderBrush="#F3F4F6" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- 圆形图标徽章 -->
                            <Border Grid.Column="0" Width="40" Height="40" CornerRadius="20" Margin="0,0,14,0" VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#EFF6FF" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Type}" Value="{x:Static models:DialogType.Success}">
                                                <Setter Property="Background" Value="#DCFCE7" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Type}" Value="{x:Static models:DialogType.Warning}">
                                                <Setter Property="Background" Value="#FEF3C7" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Type}" Value="{x:Static models:DialogType.Error}">
                                                <Setter Property="Background" Value="#FEE2E2" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsDangerConfirm}" Value="True">
                                                <Setter Property="Background" Value="#FEE2E2" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Type}" Value="{x:Static models:DialogType.Input}">
                                                <Setter Property="Background" Value="#EEF2FF" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>

                                <fa:IconBlock FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <fa:IconBlock.Style>
                                        <Style TargetType="fa:IconBlock">
                                            <Setter Property="Icon" Value="CircleInfo" />
                                            <Setter Property="Foreground" Value="#2563EB" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Type}" Value="{x:Static models:DialogType.Success}">
                                                    <Setter Property="Icon" Value="CircleCheck" />
                                                    <Setter Property="Foreground" Value="#16A34A" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Type}" Value="{x:Static models:DialogType.Warning}">
                                                    <Setter Property="Icon" Value="TriangleExclamation" />
                                                    <Setter Property="Foreground" Value="#D97706" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Type}" Value="{x:Static models:DialogType.Error}">
                                                    <Setter Property="Icon" Value="CircleXmark" />
                                                    <Setter Property="Foreground" Value="#DC2626" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsDangerConfirm}" Value="True">
                                                    <Setter Property="Icon" Value="TriangleExclamation" />
                                                    <Setter Property="Foreground" Value="#DC2626" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Type}" Value="{x:Static models:DialogType.Confirm}">
                                                    <Setter Property="Icon" Value="CircleQuestion" />
                                                    <Setter Property="Foreground" Value="#2563EB" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Type}" Value="{x:Static models:DialogType.Input}">
                                                    <Setter Property="Icon" Value="PenToSquare" />
                                                    <Setter Property="Foreground" Value="#4F46E5" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </fa:IconBlock.Style>
                                </fa:IconBlock>
                            </Border>

                            <!-- 标题文本 -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource MahApps.Brushes.Text}" />
                            </StackPanel>

                            <!-- 右上角关闭按钮 -->
                            <Button Grid.Column="2" Click="CancelButton_Click" Style="{StaticResource DialogCloseButtonStyle}" ToolTip="关闭" VerticalAlignment="Top">
                                <fa:IconBlock Icon="Xmark" FontSize="11" />
                            </Button>
                        </Grid>
                    </Border>

                    <!-- 对话框正文区 -->
                    <StackPanel Grid.Row="1" Margin="22,18,22,20">
                        <TextBlock Text="{Binding Message}" FontSize="13.5" LineHeight="22" TextWrapping="Wrap" Foreground="{DynamicResource MahApps.Brushes.Gray2}" />

                        <!-- 输入框 (如果是输入类型弹窗) -->
                        <TextBox x:Name="InputTextBox"
                                 Margin="0,14,0,0"
                                 Padding="10,8"
                                 FontSize="13"
                                 mah:ControlsHelper.CornerRadius="6"
                                 mah:TextBoxHelper.Watermark="请输入内容..."
                                 mah:TextBoxHelper.ClearTextButton="True"
                                 BorderBrush="{DynamicResource MahApps.Brushes.Gray7}"
                                 Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                                 KeyDown="InputTextBox_KeyDown"
                                 IsVisibleChanged="InputTextBox_IsVisibleChanged"
                                 Visibility="{Binding IsInput, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </StackPanel>

                    <!-- 对话框底部操作按钮区域 (带浅灰背景条) -->
                    <Border Grid.Row="2" Background="#F9FAFB" Padding="20,14,22,14" BorderBrush="#F3F4F6" BorderThickness="0,1,0,0" CornerRadius="0,0,10,10">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <!-- 取消按钮 (可选) -->
                            <Button Click="CancelButton_Click"
                                    Content="{Binding CancelText}"
                                    Visibility="{Binding ShowCancelButton, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    Style="{StaticResource FlatActionButtonStyle}"
                                    mah:ControlsHelper.CornerRadius="6"
                                    MinWidth="86"
                                    Height="34"
                                    Margin="0,0,10,0" />

                            <!-- 确定按钮 (支持 Danger 红色模式) -->
                            <Button Click="ConfirmButton_Click"
                                    Content="{Binding ConfirmText}"
                                    mah:ControlsHelper.CornerRadius="6"
                                    MinWidth="92"
                                    Height="34">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource PrimaryActionButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDangerConfirm}" Value="True">
                                                <Setter Property="Background" Value="#DC2626" />
                                                <Setter Property="BorderBrush" Value="#DC2626" />
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="Border"
                                                                    Background="{TemplateBinding Background}"
                                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                                    CornerRadius="{TemplateBinding mah:ControlsHelper.CornerRadius}"
                                                                    Padding="{TemplateBinding Padding}"
                                                                    SnapsToDevicePixels="True">
                                                                <ContentPresenter x:Name="ContentPresenter"
                                                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                                                  RecognizesAccessKey="True" />
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Border" Property="Background" Value="#B91C1C" />
                                                                    <Setter TargetName="Border" Property="BorderBrush" Value="#B91C1C" />
                                                                    <Setter Property="Foreground" Value="#FFFFFF" />
                                                                </Trigger>
                                                                <Trigger Property="IsPressed" Value="True">
                                                                    <Setter TargetName="Border" Property="Background" Value="#991B1B" />
                                                                    <Setter TargetName="Border" Property="BorderBrush" Value="#991B1B" />
                                                                    <Setter Property="Foreground" Value="#FFFFFF" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- 2. 右上角浮动轻量 Toast 提示列表 (非阻塞式反馈) -->
        <ItemsControl ItemsSource="{Binding ActiveToasts}"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Top"
                      Margin="0,20,20,0">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type models:ToastItem}">
                    <Border Background="{DynamicResource MahApps.Brushes.ThemeBackground}"
                            BorderBrush="{DynamicResource MahApps.Brushes.Gray8}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="0"
                            Margin="0,0,0,10"
                            MinWidth="280"
                            MaxWidth="380"
                            SnapsToDevicePixels="True">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" ShadowDepth="4" Direction="270" Color="#0F172A" Opacity="0.14" />
                        </Border.Effect>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="4" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- 左侧语义彩色条 -->
                            <Border Grid.Column="0" CornerRadius="8,0,0,8">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#2563EB" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Type}" Value="{x:Static models:DialogType.Success}">
                                                <Setter Property="Background" Value="#16A34A" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Type}" Value="{x:Static models:DialogType.Warning}">
                                                <Setter Property="Background" Value="#D97706" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Type}" Value="{x:Static models:DialogType.Error}">
                                                <Setter Property="Background" Value="#DC2626" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>

                            <!-- Toast 内部内容 -->
                            <Grid Grid.Column="1" Margin="14,10,12,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Toast 图标 Badge -->
                                <Border Grid.Column="0" Width="28" Height="28" CornerRadius="14" Margin="0,0,10,0" VerticalAlignment="Top">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#EFF6FF" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Type}" Value="{x:Static models:DialogType.Success}">
                                                    <Setter Property="Background" Value="#DCFCE7" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Type}" Value="{x:Static models:DialogType.Warning}">
                                                    <Setter Property="Background" Value="#FEF3C7" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Type}" Value="{x:Static models:DialogType.Error}">
                                                    <Setter Property="Background" Value="#FEE2E2" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <fa:IconBlock FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <fa:IconBlock.Style>
                                            <Style TargetType="fa:IconBlock">
                                                <Setter Property="Icon" Value="CircleInfo" />
                                                <Setter Property="Foreground" Value="#2563EB" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Type}" Value="{x:Static models:DialogType.Success}">
                                                        <Setter Property="Icon" Value="CircleCheck" />
                                                        <Setter Property="Foreground" Value="#16A34A" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Type}" Value="{x:Static models:DialogType.Warning}">
                                                        <Setter Property="Icon" Value="TriangleExclamation" />
                                                        <Setter Property="Foreground" Value="#D97706" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Type}" Value="{x:Static models:DialogType.Error}">
                                                        <Setter Property="Icon" Value="CircleXmark" />
                                                        <Setter Property="Foreground" Value="#DC2626" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </fa:IconBlock.Style>
                                    </fa:IconBlock>
                                </Border>

                                <!-- Toast 文本 -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource MahApps.Brushes.Text}" />
                                    <TextBlock Text="{Binding Message}" FontSize="11.5" Foreground="{DynamicResource MahApps.Brushes.Gray2}" TextWrapping="Wrap" Margin="0,2,0,0" LineHeight="16" />
                                </StackPanel>

                                <!-- Toast 关闭按钮 -->
                                <Button Grid.Column="2" Click="ToastDismiss_Click" Tag="{Binding Id}" Style="{StaticResource ToastCloseButtonStyle}" VerticalAlignment="Top" Margin="8,0,0,0">
                                    <fa:IconBlock Icon="Xmark" FontSize="9" />
                                </Button>
                            </Grid>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</UserControl>
